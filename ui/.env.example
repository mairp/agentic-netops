# Copy to .env for local development. In the cluster these values come from
# the ui-env ConfigMap and are injected as pod environment;
# docker/ui-build-and-serve.sh regenerates the runtime .env from them before
# the production build.
# Server-side proxy target. For local development, use http://localhost:9090.
VITE_SUPERVISOR_API_URL=http://localhost:9090
# Optional browser-facing API base; leave unset to use the UI's /api proxy.
# VITE_BROWSER_API_URL=https://example.test/intent-api
VITE_MAPPER_API_URL=http://mapper.agentic-netops-agents.svc:9092
VITE_ALLOCATOR_API_URL=http://allocator.agentic-netops-agents.svc:9091
VITE_DEPLOYER_API_URL=http://deployer.agentic-netops-agents.svc:9093
