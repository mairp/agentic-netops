# Copy to .env for local development. In the cluster these values come from
# the ui-env ConfigMap and are injected as pod environment;
# docker/ui-build-and-serve.sh regenerates the runtime .env from them before
# the production build.
VITE_SUPERVISOR_API_URL=http://supervisor.ainetops-agents.svc:9090
VITE_MAPPER_API_URL=http://mapper.ainetops-agents.svc:9092
VITE_ALLOCATOR_API_URL=http://allocator.ainetops-agents.svc:9091
VITE_DEPLOYER_API_URL=http://deployer.ainetops-agents.svc:9093
