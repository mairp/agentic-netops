# Pre-existing inputs (not products of the wiggum loop)
REVERSE.md
specs/
.specify/
plan.md

# Prior project's loop state, unrelated to this feature

# Loop churn
testautomation/*/generated/

# TLS material generated per-deployment by the lab bootstrap. These are real private
# keys; they were committed once (2026-09-01, 26e9c8d4) and purged from the unpushed
# history on 2026-09-02 before this repo's first push carrying them. Never track them:
# scripts/provision.sh regenerates them on every run.
secrets/
*.key
*.pem
lab/clab-ainetops-fabric/.tls/

# Wiggum harness working state -- not source. Holds a vendored toolchain
# (features/*/tools, ~30k files), build-gnmi sources, gate evidence, verdicts,
# attempts and run logs. Regenerated by the loop; never needed to build or run
# the platform.
.wiggum/
# containerlab runtime state (topology data, node keys) -- regenerated per lab
lab/clab-ainetops-fabric/

# Python build artifacts (the 002 merge carried 52 .pyc files in)
__pycache__/
*.py[cod]
.pytest_cache/
