{
    "title": "Agentic NetOps Fabric Telemetry",
    "uid": "agentic-netops-fabric-telemetry",
    "tags": [
        "agentic-netops",
        "fabric",
        "gnmi",
        "srlinux"
    ],
    "description": "Live gNMI telemetry from the four Nokia SR Linux nodes. The in-cluster gNMIc collector subscribes to SR Linux native state paths (deploy/gnmi/gnmic.yaml) and exposes them on its own Prometheus endpoint; series names follow gnmic's default underscore-joined path naming and are listed in deploy/observability/metrics-inventory.md.",
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "10s",
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Fabric nodes reporting telemetry",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 1
                            },
                            {
                                "color": "green",
                                "value": 4
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value"
            },
            "targets": [
                {
                    "expr": "count(count by (source) (interface_oper_state))",
                    "legendFormat": "nodes",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Interfaces discovered",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "blue"
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value"
            },
            "targets": [
                {
                    "expr": "count(interface_oper_state)",
                    "legendFormat": "ifaces",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "BGP neighbors reporting",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "fixed",
                        "fixedColor": "purple"
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value"
            },
            "targets": [
                {
                    "expr": "count(network_instance_protocols_bgp_neighbor_session_state)",
                    "legendFormat": "neighbors",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "gNMI collector",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "1": {
                                    "text": "UP",
                                    "color": "green"
                                },
                                "0": {
                                    "text": "DOWN",
                                    "color": "red"
                                }
                            }
                        }
                    ],
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "textMode": "value"
            },
            "targets": [
                {
                    "expr": "up{job=\"gnmic\"}",
                    "legendFormat": "gnmic",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Fabric link throughput in (bytes/s)",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 5
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 8,
                        "showPoints": "never"
                    },
                    "unit": "Bps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by (source, interface_name) (rate(interface_statistics_in_octets[5m]))",
                    "legendFormat": "{{source}} {{interface_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Fabric link throughput out (bytes/s)",
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 5
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 8,
                        "showPoints": "never"
                    },
                    "unit": "Bps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by (source, interface_name) (rate(interface_statistics_out_octets[5m]))",
                    "legendFormat": "{{source}} {{interface_name}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Packet rate by node (in + out)",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 14
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never"
                    },
                    "unit": "pps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "sum by (source) (rate(interface_statistics_in_packets[5m]))",
                    "legendFormat": "{{source}} in",
                    "refId": "A"
                },
                {
                    "expr": "sum by (source) (rate(interface_statistics_out_packets[5m]))",
                    "legendFormat": "{{source}} out",
                    "refId": "B"
                }
            ]
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "EVPN routes received per neighbor",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 14
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 0,
                        "showPoints": "never"
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "network_instance_protocols_bgp_neighbor_afi_safi_received_routes{afi_safi_afi_safi_name=~\".*evpn.*\"}",
                    "legendFormat": "{{source}} {{neighbor_peer_address}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Control-plane CPU and memory",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 22
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 0,
                        "showPoints": "never"
                    },
                    "unit": "percent"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "avg by (source) (platform_control_cpu_total_instant)",
                    "legendFormat": "{{source}} cpu",
                    "refId": "A"
                },
                {
                    "expr": "avg by (source) (platform_control_memory_utilization)",
                    "legendFormat": "{{source}} mem",
                    "refId": "B"
                }
            ]
        }
    ]
}
