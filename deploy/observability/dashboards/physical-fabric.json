{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "uid": "agentic-netops-physical-fabric",
  "tags": ["agentic-netops", "fabric", "srlinux"],
  "description": "Physical fabric view for the Nokia SR Linux lab. Series come from the in-cluster gNMIc collector (deploy/gnmi/gnmic.yaml) subscribing to SR Linux native state paths; naming follows gnmic's default underscore-joined path convention.",
  "panels": [
    {
      "type": "flowcharting",
      "title": "Fabric Topology",
      "options": {
        "flowConfigMap": "agentic-netops-topology"
      }
    },
    {
      "type": "table",
      "title": "Fabric nodes (SR Linux)",
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "count by(source) (interface_oper_state)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Interface operational state",
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "interface_oper_state",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Link packet rate",
      "targets": [
        {
          "expr": "sum by(source,interface_name) (rate(interface_statistics_in_packets[5m]))",
          "legendFormat": "{{source}} {{interface_name}} in",
          "refId": "A"
        },
        {
          "expr": "sum by(source,interface_name) (rate(interface_statistics_out_packets[5m]))",
          "legendFormat": "{{source}} {{interface_name}} out",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Link utilization (bytes/s)",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by(source,interface_name) (rate(interface_statistics_in_octets[5m]))",
          "legendFormat": "{{source}} {{interface_name}} in",
          "refId": "A"
        },
        {
          "expr": "sum by(source,interface_name) (rate(interface_statistics_out_octets[5m]))",
          "legendFormat": "{{source}} {{interface_name}} out",
          "refId": "B"
        }
      ]
    },
    {
      "type": "table",
      "title": "BGP neighbor session state (underlay + EVPN overlay)",
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "network_instance_protocols_bgp_neighbor_session_state",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Control-plane CPU (instant %)",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg by(source) (platform_control_cpu_total_instant)",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Control-plane memory utilization",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "avg by(source) (platform_control_memory_utilization)",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "title": "Agentic NetOps Physical Fabric",
  "version": 2
}
