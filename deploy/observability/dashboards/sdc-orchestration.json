{
    "annotations": {
        "list": []
    },
    "editable": true,
    "graphTooltip": 0,
    "uid": "agentic-netops-orchestration",
    "tags": ["agentic-netops", "orchestration", "srlinux"],
    "description": "Orchestration health for the SR Linux site: SDC target reachability over gNMI and the srlinux-provider controller's reconcile behaviour.",
    "panels": [
        {
            "type": "stat",
            "title": "SDC Targets Reachable (SR Linux nodes)",
            "targets": [
                {
                    "expr": "sum(sdc_target_reachable)"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "SDC Config Applies",
            "targets": [
                {
                    "expr": "rate(sdc_config_apply_total[5m])"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "SDC Deviations",
            "targets": [
                {
                    "expr": "sum by(target) (sdc_deviation_total)"
                }
            ]
        },
        {
            "type": "stat",
            "title": "Provider Applies (gNMI Set batches)",
            "targets": [
                {
                    "expr": "increase(agentic_netops_srlprovider_applies_total[15m])"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Provider Reconcile Errors",
            "targets": [
                {
                    "expr": "increase(controller_runtime_reconcile_errors_total{controller='agentic-netops-srlinux-provider'}[15m])"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Provider Queue Depth",
            "targets": [
                {
                    "expr": "agentic_netops_provider_queue_size"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Provider Retries",
            "targets": [
                {
                    "expr": "rate(agentic_netops_provider_retries_total[5m])"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Provider Reconcile Latency (p95)",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(agentic_netops_provider_reconcile_duration_seconds_bucket[5m])) by (le))"
                }
            ]
        },
        {
            "type": "stat",
            "title": "EVPN Services Active",
            "targets": [
                {
                    "expr": "evpn_services_active_count"
                }
            ]
        }
    ],
    "schemaVersion": 39,
    "title": "Agentic NetOps Orchestration",
    "version": 2
}
