===== leaf02: FRR running config =====
Building configuration...

Current configuration:
!
frr version 10.3
frr defaults traditional
hostname leaf02
log syslog informational
log facility local4
zebra nexthop-group keep 1
no zebra nexthop kernel enable
fpm address 127.0.0.1
no fpm use-next-hop-groups
agentx
no service integrated-vtysh-config
!
ip prefix-list DEFAULT_IPV4 seq 5 permit 0.0.0.0/0
ip prefix-list PL_LoopbackV4 seq 5 permit 10.0.0.22/32
!
ipv6 prefix-list DEFAULT_IPV6 seq 5 permit ::/0
ipv6 prefix-list PL_LoopbackV6 seq 5 permit 2001:db8:ff::22/128
!
!
!
!
!
!
!
!
!
!
!
!
!
!
!
password zebra
enable password zebra
!
ipv6 route 2001:db8:ff::22/128 Loopback0
!
router bgp 65102
 bgp router-id 10.0.0.22
 bgp suppress-fib-pending
 bgp log-neighbor-changes
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 bgp bestpath as-path multipath-relax
 neighbor PEER_V4 peer-group
 neighbor PEER_V6 peer-group
 neighbor 10.1.0.2 remote-as 65000
 neighbor 10.1.0.2 peer-group PEER_V4
 neighbor 10.1.0.2 timers connect 10
 neighbor 10.1.0.6 remote-as 65000
 neighbor 10.1.0.6 peer-group PEER_V4
 neighbor 10.1.0.6 timers connect 10
 neighbor 2001:db8:1::5 remote-as 65000
 neighbor 2001:db8:1::5 peer-group PEER_V6
 neighbor 2001:db8:1::5 timers connect 10
 neighbor 2001:db8:2::5 remote-as 65000
 neighbor 2001:db8:2::5 peer-group PEER_V6
 neighbor 2001:db8:2::5 timers connect 10
 !
 address-family ipv4 unicast
  network 10.0.0.22/32
  neighbor PEER_V4 soft-reconfiguration inbound
  neighbor PEER_V4 route-map FROM_BGP_PEER_V4 in
  neighbor PEER_V4 route-map TO_BGP_PEER_V4 out
  neighbor 10.1.0.2 activate
  neighbor 10.1.0.6 activate
 exit-address-family
 !
 address-family ipv6 unicast
  network 2001:db8:ff::22/128
  neighbor PEER_V6 soft-reconfiguration inbound
  neighbor PEER_V6 route-map FROM_BGP_PEER_V6 in
  neighbor PEER_V6 route-map TO_BGP_PEER_V6 out
  neighbor 2001:db8:1::5 activate
  neighbor 2001:db8:2::5 activate
 exit-address-family
exit
!
bgp community-list standard allow_list_default_community seq 5 permit no-export
bgp community-list standard allow_list_default_community seq 10 permit 5060:12345
!
ip protocol bgp route-map RM_SET_SRC
!
ipv6 protocol bgp route-map RM_SET_SRC6
!
ip nht resolve-via-default
!
ipv6 nht resolve-via-default
!
end
===== leaf02: FRR routes (ages normalized) =====
Codes: K - kernel route, C - connected, L - local, S - static,
       R - RIP, O - OSPF, I - IS-IS, B - BGP, E - EIGRP, N - NHRP,
       T - Table, v - VNC, V - VNC-Direct, A - Babel, F - PBR,
       f - OpenFabric, t - Table-Direct,
       > - selected route, * - FIB route, q - queued, r - rejected, b - backup
       t - trapped, o - offload failure

IPv4 unicast VRF default:
K>* 0.0.0.0/0 [0/202] via 10.0.0.2, eth0, weight 1, UPTIME
C>* 10.0.0.0/24 is directly connected, eth0, weight 1, UPTIME
