===== per-VRF export knobs (running config) =====
router bgp 65102 vrf Vrf1
 !
 address-family ipv4 unicast
  network 192.168.2.0/24
  sid vpn export auto
  rd vpn export 65102:100
  rt vpn both 65102:100
  export vpn
  import vpn
 exit-address-family
exit
===== EVPN AF knobs (running config, l2vpn evpn sections only) =====
 address-family l2vpn evpn
  neighbor 10.1.0.2 activate
  neighbor 10.1.0.6 activate
  neighbor fcbb:bbbb:3::1 activate
  advertise-all-vni
  advertise ipv4 unicast
  advertise ipv6 unicast
 exit-address-family
