# Copy to .env at the repo root and fill in one provider block. The file is
# read by scripts/provision.sh (which turns it into Secret/llm-provider for
# the intent tier) and by agents/config/config.py (python-dotenv) for a local
# run of the agents. An exported shell variable always overrides the file.
# .env is gitignored; never commit credentials.

#============================
# LLM Provider Settings
#============================
# Agentic NetOps uses litellm to manage LLM connections.
# Full list of supported providers: https://docs.litellm.ai/docs/providers
# Note: the environment variable for specifying the model is always LLM_MODEL,
# regardless of the provider; the prefix before "/" selects the provider.
# Examples:

# OpenAI
# LLM_MODEL="openai/<model_of_choice>"
# OPENAI_API_KEY=<your_openai_api_key>

# OpenAI-compatible gateway (Compass / Core42, vLLM, llama-swap, LM Studio ...)
# OPENAI_BASE_URL is load-bearing here: without it the `openai` provider
# defaults to https://api.openai.com/v1, which rejects gateway keys.
# LLM_MODEL="openai/gpt-5"
# OPENAI_API_KEY=<your_gateway_api_key>
# OPENAI_BASE_URL=https://api.core42.ai/v1

# Anthropic
# LLM_MODEL="anthropic/<model_of_choice>"
# ANTHROPIC_API_KEY=<your_anthropic_api_key>

# Azure OpenAI
# LLM_MODEL="azure/<your_deployment_name>"
# AZURE_API_BASE=https://your-azure-resource.openai.azure.com/
# AZURE_API_KEY=<your_azure_api_key>
# AZURE_API_VERSION=<your_azure_api_version>

# GROQ
# LLM_MODEL="groq/<model_of_choice>"
# GROQ_API_KEY=<your_groq_api_key>

# Litellm Proxy
# LLM_MODEL="litellm_proxy/<model_of_choice>"
# LITELLM_PROXY_API_BASE=<your_litellm_proxy_base_url>
# LITELLM_PROXY_API_KEY=<your_litellm_proxy_api_key>

# NVIDIA NIM
# LLM_MODEL="nvidia_nim/<model_of_choice>"
# NVIDIA_NIM_API_KEY=<your_nvidia_api_key>
# NVIDIA_NIM_API_BASE=<your_nvidia_nim_endpoint_url>

# OAuth2-fronted OpenAI-compatible endpoint (agents/common/litellm_oauth2_openai_provider.py)
# LLM_MODEL="oauth2/<model_of_choice>"
# OAUTH2_CLIENT_ID=<client_id>
# OAUTH2_CLIENT_SECRET=<client_secret>
# OAUTH2_TOKEN_URL=<token_endpoint>
# OAUTH2_BASE_URL=<openai_compatible_base_url>
# OAUTH2_APPKEY=<app_key>

# Per-thread token budget for the supervisor (0 = unlimited). When exceeded the
# thread ends with a bounded "token-budget-exceeded" refusal instead of looping.
AGENTIC_NETOPS_LLM_TOKENS_PER_THREAD=0

#============================
# Local Development Settings
#============================
# (not needed when the tier runs in the kind cluster: provisioning sets these)

LOGGING_LEVEL=INFO

# OTEL: where the agents export traces/metrics when run outside the cluster.
# AGENT_OTLP_HTTP_ENDPOINT="http://localhost:4318"

# === Transport Settings ===
# SLIM is the only transport the supervisor's call helpers support.
DEFAULT_MESSAGE_TRANSPORT=SLIM
# In-cluster default is the SLIM gateway Service; point at a port-forward for a local run.
# TRANSPORT_SERVER_ENDPOINT=http://localhost:46357

# === Worker endpoints (supervisor /v1/health readiness and progress checks) ===
# In-cluster defaults are the worker Service DNS names; override for a local run.
# MAPPER_ENDPOINT=http://localhost:9092
# ALLOCATOR_ENDPOINT=http://localhost:9091
# DEPLOYER_ENDPOINT=http://localhost:9093
