{
  "nodes": [
    {
      "node": "leaf01",
      "ops": [
        {
          "gnmi": {
            "updates": [
              {
                "path": "/interface[name=ethernet-1/3]",
                "value": {
                  "admin-state": "enable",
                  "mtu": 9216,
                  "vlan-tagging": true
                }
              },
              {
                "path": "/interface[name=ethernet-1/3]/subinterface[index=200]",
                "value": {
                  "admin-state": "enable",
                  "type": "bridged",
                  "vlan": {
                    "encap": {
                      "single-tagged": {
                        "vlan-id": 200
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "gnmi": {
            "updates": [
              {
                "path": "/interface[name=irb0]",
                "value": {
                  "admin-state": "enable"
                }
              },
              {
                "path": "/interface[name=irb0]/subinterface[index=200]",
                "value": {
                  "admin-state": "enable",
                  "anycast-gw": {},
                  "ipv4": {
                    "address": [
                      {
                        "anycast-gw": true,
                        "ip-prefix": "10.60.0.1/24"
                      }
                    ],
                    "admin-state": "enable"
                  },
                  "ipv6": {
                    "address": [
                      {
                        "anycast-gw": true,
                        "ip-prefix": "fd00:60::1/64"
                      }
                    ],
                    "admin-state": "enable"
                  }
                }
              }
            ]
          }
        },
        {
          "gnmi": {
            "updates": [
              {
                "path": "/tunnel-interface[name=vxlan1]/vxlan-interface[index=10200]",
                "value": {
                  "egress": {
                    "source-ip": "use-system-ipv4-address"
                  },
                  "ingress": {
                    "vni": 10200
                  },
                  "type": "bridged"
                }
              }
            ]
          }
        },
        {
          "gnmi": {
            "updates": [
              {
                "path": "/tunnel-interface[name=vxlan1]/vxlan-interface[index=10020]",
                "value": {
                  "egress": {
                    "source-ip": "use-system-ipv4-address"
                  },
                  "ingress": {
                    "vni": 10020
                  },
                  "type": "routed"
                }
              }
            ]
          }
        },
        {
          "gnmi": {
            "updates": [
              {
                "path": "/network-instance[name=vlan200]",
                "value": {
                  "admin-state": "enable",
                  "interface": [
                    {
                      "name": "ethernet-1/3.200"
                    },
                    {
                      "name": "irb0.200"
                    }
                  ],
                  "protocols": {
                    "bgp-evpn": {
                      "bgp-instance": [
                        {
                          "admin-state": "enable",
                          "ecmp": 2,
                          "evi": 10200,
                          "id": 1,
                          "vxlan-interface": "vxlan1.10200"
                        }
                      ]
                    },
                    "bgp-vpn": {
                      "bgp-instance": [
                        {
                          "id": 1,
                          "route-target": {
                            "export-rt": "target:65000:200",
                            "import-rt": "target:65000:200"
                          }
                        }
                      ]
                    }
                  },
                  "type": "mac-vrf",
                  "vxlan-interface": [
                    {
                      "name": "vxlan1.10200"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "gnmi": {
            "updates": [
              {
                "path": "/network-instance[name=Vrf-green01]",
                "value": {
                  "admin-state": "enable",
                  "interface": [
                    {
                      "name": "irb0.200"
                    }
                  ],
                  "protocols": {
                    "bgp-evpn": {
                      "bgp-instance": [
                        {
                          "admin-state": "enable",
                          "ecmp": 2,
                          "evi": 10020,
                          "id": 1,
                          "vxlan-interface": "vxlan1.10020"
                        }
                      ]
                    },
                    "bgp-vpn": {
                      "bgp-instance": [
                        {
                          "id": 1,
                          "route-distinguisher": {
                            "rd": "65000:20"
                          },
                          "route-target": {
                            "export-rt": "target:65000:20",
                            "import-rt": "target:65000:20"
                          }
                        }
                      ]
                    }
                  },
                  "type": "ip-vrf",
                  "vxlan-interface": [
                    {
                      "name": "vxlan1.10020"
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "checks": [
        {
          "type": "gnmi-equals",
          "path": "/network-instance[name=vlan200]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-equals",
          "path": "/interface[name=ethernet-1/3]/subinterface[index=200]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-equals",
          "path": "/network-instance[name=vlan200]/protocols/bgp-evpn/bgp-instance[id=1]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-equals",
          "path": "/tunnel-interface[name=vxlan1]/vxlan-interface[index=10200]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-list-min",
          "path": "/tunnel-interface[name=vxlan1]/vxlan-interface[index=10200]/bridge-table/multicast-destinations/destination",
          "minCount": 1
        },
        {
          "type": "gnmi-equals",
          "path": "/network-instance[name=Vrf-green01]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-equals",
          "path": "/network-instance[name=Vrf-green01]/protocols/bgp-evpn/bgp-instance[id=1]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-equals",
          "path": "/tunnel-interface[name=vxlan1]/vxlan-interface[index=10020]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-equals",
          "path": "/interface[name=irb0]/subinterface[index=200]/oper-state",
          "expect": "up"
        },
        {
          "type": "gnmi-contains",
          "path": "/network-instance[name=default]/bgp-rib/afi-safi[afi-safi-name=evpn]/evpn/rib-in-out/rib-out-post/ip-prefix-routes",
          "expect": "10.60.0.0/24"
        },
        {
          "type": "gnmi-contains",
          "path": "/network-instance[name=default]/bgp-rib/afi-safi[afi-safi-name=evpn]/evpn/rib-in-out/rib-out-post/ip-prefix-routes",
          "expect": "fd00:60::/64"
        }
      ],
      "rollback": [
        {
          "gnmi": {
            "deletes": [
              "/network-instance[name=Vrf-green01]"
            ]
          }
        },
        {
          "gnmi": {
            "deletes": [
              "/network-instance[name=vlan200]"
            ]
          }
        },
        {
          "gnmi": {
            "deletes": [
              "/interface[name=irb0]/subinterface[index=200]"
            ]
          }
        },
        {
          "gnmi": {
            "deletes": [
              "/tunnel-interface[name=vxlan1]/vxlan-interface[index=10020]"
            ]
          }
        },
        {
          "gnmi": {
            "deletes": [
              "/tunnel-interface[name=vxlan1]/vxlan-interface[index=10200]"
            ]
          }
        },
        {
          "gnmi": {
            "deletes": [
              "/interface[name=ethernet-1/3]/subinterface[index=200]"
            ]
          }
        }
      ]
    },
