<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bgp-global"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bgpg="http://github.com/sonic-net/sonic-bgp-global"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:rmap="http://github.com/sonic-net/sonic-route-map"
        xmlns:ext="http://github.com/sonic-net/sonic-extension">
  <namespace uri="http://github.com/sonic-net/sonic-bgp-global"/>
  <prefix value="bgpg"/>
  <yang-version value="1.1"/>
  <import module="sonic-vrf">
    <prefix value="vrf"/>
  </import>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-route-map">
    <prefix value="rmap"/>
  </import>
  <import module="sonic-extension">
    <prefix value="ext"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC BGP Global YANG</text>
  </description>
  <revision date="2021-02-26">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-bgp-global">
    <container name="BGP_GLOBALS">
      <list name="BGP_GLOBALS_LIST">
        <key value="vrf_name"/>
        <leaf name="vrf_name">
          <type name="union">
            <type name="string">
              <pattern value="default"/>
            </type>
            <type name="leafref">
              <path value="/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name"/>
            </type>
          </type>
          <description>
            <text>VRF name</text>
          </description>
        </leaf>
        <leaf name="router_id">
          <type name="inet:ipv4-address"/>
          <description>
            <text>BGP router identifier in IPv4 address format.</text>
          </description>
        </leaf>
        <leaf name="local_asn">
          <type name="uint32">
            <range value="1..4294967295"/>
          </type>
          <description>
            <text>Local autonomous system number for this BGP instance.</text>
          </description>
        </leaf>
        <leaf name="always_compare_med">
          <type name="boolean"/>
          <description>
            <text>Allow comparing MED from different neighbors</text>
          </description>
        </leaf>
        <leaf name="load_balance_mp_relax">
          <type name="boolean"/>
          <description>
            <text>Allow load sharing across routes that have different AS paths (but same length)</text>
          </description>
        </leaf>
        <leaf name="graceful_restart_enable">
          <type name="boolean"/>
          <description>
            <text>Enable graceful restart</text>
          </description>
        </leaf>
        <leaf name="gr_preserve_fw_state">
          <type name="boolean"/>
          <description>
            <text>Set F-bit indication that FIB is preserved while doing Graceful Restart.</text>
          </description>
        </leaf>
        <leaf name="gr_restart_time">
          <type name="uint16">
            <range value="1..3600"/>
          </type>
          <description>
            <text>Set the time to wait to delete stale routes before a BGP open message is received</text>
          </description>
        </leaf>
        <leaf name="gr_stale_routes_time">
          <type name="uint16">
            <range value="1..3600"/>
          </type>
          <description>
            <text>Set the max time to hold onto restarting peer's stale paths</text>
          </description>
        </leaf>
        <leaf name="external_compare_router_id">
          <type name="boolean"/>
          <description>
            <text>Compare router-id for identical EBGP paths</text>
          </description>
        </leaf>
        <leaf name="ignore_as_path_length">
          <type name="boolean"/>
          <description>
            <text>Ignore as-path length in selecting a route</text>
          </description>
        </leaf>
        <leaf name="log_nbr_state_changes">
          <type name="boolean"/>
          <description>
            <text>Log neighbor up/down and reset reason</text>
          </description>
        </leaf>
        <leaf name="rr_cluster_id">
          <type name="string"/>
          <description>
            <text>Route reflector cluster ID used to identify the reflector cluster.</text>
          </description>
        </leaf>
        <leaf name="rr_allow_out_policy">
          <type name="boolean"/>
          <description>
            <text>Allow outbound route-map modifications on reflected routes.</text>
          </description>
        </leaf>
        <leaf name="disable_ebgp_connected_rt_check">
          <type name="boolean"/>
          <description>
            <text>Disable checking if nexthop is connected on ebgp sessions</text>
          </description>
        </leaf>
        <leaf name="fast_external_failover">
          <type name="boolean"/>
          <description>
            <text>Immediately reset session if a link to a directly connected external peer goes down</text>
          </description>
        </leaf>
        <leaf name="network_import_check">
          <type name="boolean"/>
          <description>
            <text>Check BGP network route exists in IGP</text>
          </description>
        </leaf>
        <leaf name="graceful_shutdown">
          <type name="boolean"/>
          <description>
            <text>Enable graceful shutdown</text>
          </description>
        </leaf>
        <leaf name="rr_clnt_to_clnt_reflection">
          <type name="boolean"/>
          <description>
            <text>Enable client to client route reflection.</text>
          </description>
        </leaf>
        <leaf name="max_dynamic_neighbors">
          <type name="uint16">
            <range value="1..5000"/>
          </type>
          <description>
            <text>Maximum number of BGP dynamic neighbors that can be created.</text>
          </description>
        </leaf>
        <leaf name="read_quanta">
          <type name="uint8">
            <range value="1..10"/>
          </type>
          <description>
            <text>This indicates how many packets to read from peer socket per I/O cycle</text>
          </description>
        </leaf>
        <leaf name="write_quanta">
          <type name="uint8">
            <range value="1..10"/>
          </type>
          <description>
            <text>This indicates how many packets to write to peer socket per run</text>
          </description>
        </leaf>
        <leaf name="coalesce_time">
          <type name="uint32"/>
          <description>
            <text>Subgroup coalesce timer value in milli-sec</text>
          </description>
        </leaf>
        <leaf name="route_map_process_delay">
          <type name="uint16">
            <range value="0..600"/>
          </type>
          <description>
            <text>Delay in seconds before processing route-map changes; 0 disables automatic updates.</text>
          </description>
        </leaf>
        <leaf name="deterministic_med">
          <type name="boolean"/>
          <description>
            <text>Pick the best-MED path among paths advertised from the neighboring AS.</text>
          </description>
        </leaf>
        <leaf name="med_confed">
          <type name="boolean"/>
          <description>
            <text>Compare MED among confederation paths when set to true.</text>
          </description>
        </leaf>
        <leaf name="med_missing_as_worst">
          <type name="boolean"/>
          <description>
            <text>Treat missing MED as the least preferred one when set to true.</text>
          </description>
        </leaf>
        <leaf name="compare_confed_as_path">
          <type name="boolean"/>
          <description>
            <text>Compare path lengths including confederation sets &amp; sequences in selecting a route</text>
          </description>
        </leaf>
        <leaf name="as_path_mp_as_set">
          <type name="boolean"/>
          <description>
            <text>Include an AS_SET in multipath aggregate advertisements for multipath-relax.</text>
          </description>
        </leaf>
        <leaf name="default_ipv4_unicast">
          <type name="boolean"/>
          <description>
            <text>Activate ipv4-unicast for a peer by default</text>
          </description>
        </leaf>
        <leaf name="default_local_preference">
          <type name="uint32"/>
          <description>
            <text>Default local preference value applied to received routes.</text>
          </description>
        </leaf>
        <leaf name="default_show_hostname">
          <type name="boolean"/>
          <description>
            <text>Show hostname in BGP dumps.</text>
          </description>
        </leaf>
        <leaf name="default_shutdown">
          <type name="boolean"/>
          <description>
            <text>Apply administrative shutdown to newly configured peers.</text>
          </description>
        </leaf>
        <leaf name="default_subgroup_pkt_queue_max">
          <type name="uint8">
            <range value="20..100"/>
          </type>
          <description>
            <text>Maximum number of packets in a subgroup update packet queue.</text>
          </description>
        </leaf>
        <leaf name="max_med_time">
          <type name="uint32">
            <range value="5..86400"/>
          </type>
          <description>
            <text>Duration in seconds to advertise maximum MED value after BGP startup.</text>
          </description>
        </leaf>
        <leaf name="max_med_val">
          <type name="uint32"/>
          <description>
            <text>MED value advertised during the on-startup max-med period.</text>
          </description>
        </leaf>
        <leaf name="max_med_admin">
          <type name="boolean"/>
          <description>
            <text>Administratively enable indefinite max-MED advertisement.</text>
          </description>
        </leaf>
        <leaf name="max_med_admin_val">
          <type name="uint32"/>
          <description>
            <text>MED value used when administrative max-MED is enabled.</text>
          </description>
        </leaf>
        <leaf name="max_delay">
          <type name="uint16">
            <range value="0..3600"/>
          </type>
          <description>
            <text>Maximum delay in seconds for initial best-path calculation after BGP starts.</text>
          </description>
        </leaf>
        <leaf name="establish_wait">
          <type name="uint16">
            <range value="0..3600"/>
          </type>
          <description>
            <text>Time in seconds to wait for peers to establish before computing best paths during update-delay.</text>
          </description>
        </leaf>
        <leaf name="confed_id">
          <type name="uint32">
            <range value="1..4294967295"/>
          </type>
          <description>
            <text>Set routing domain confederation AS.</text>
          </description>
        </leaf>
        <leaf-list name="confed_peers">
          <type name="uint32">
            <range value="1..4294967295"/>
          </type>
          <ordered-by value="user"/>
          <description>
            <text>Peer ASs in BGP confederation</text>
          </description>
        </leaf-list>
        <leaf name="keepalive">
          <type name="uint16"/>
          <description>
            <text>Global BGP keepalive interval in seconds.</text>
          </description>
        </leaf>
        <leaf name="holdtime">
          <type name="uint16"/>
          <description>
            <text>Global BGP hold time in seconds; session is reset if no keepalive is received within this period.</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="BGP_GLOBALS_AF">
      <list name="BGP_GLOBALS_AF_LIST">
        <key value="vrf_name afi_safi"/>
        <leaf name="vrf_name">
          <type name="leafref">
            <path value="../../../BGP_GLOBALS/BGP_GLOBALS_LIST/vrf_name"/>
          </type>
          <description>
            <text>Vrf name</text>
          </description>
        </leaf>
        <leaf name="afi_safi">
          <type name="string"/>
          <description>
            <text>Address family name and subsequent address family name</text>
          </description>
        </leaf>
        <leaf name="max_ebgp_paths">
          <type name="uint16">
            <range value="1..256"/>
          </type>
          <description>
            <text>Maximum number of equal-cost eBGP paths to install for multipath forwarding.</text>
          </description>
          <default value="1"/>
        </leaf>
        <leaf name="max_ibgp_paths">
          <type name="uint16">
            <range value="1..256"/>
          </type>
          <description>
            <text>Maximum number of equal-cost iBGP paths to install for multipath forwarding.</text>
          </description>
          <default value="1"/>
        </leaf>
        <leaf name="import_vrf">
          <type name="union">
            <type name="string">
              <pattern value="default"/>
            </type>
            <type name="leafref">
              <path value="../../../BGP_GLOBALS/BGP_GLOBALS_LIST/vrf_name"/>
            </type>
          </type>
          <must condition="current() != current()/../vrf_name">
            <error-message>
              <value>Import VRF should be different than self!</value>
            </error-message>
          </must>
          <description>
            <text>Import routes from particular VRF</text>
          </description>
        </leaf>
        <leaf name="import_vrf_route_map">
          <type name="leafref">
            <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
          </type>
          <description>
            <text>Import routes from VRF with route filter</text>
          </description>
        </leaf>
        <leaf name="route_download_filter">
          <type name="leafref">
            <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
          </type>
          <description>
            <text>Route map applied to filter routes downloaded to the FIB (table-map).</text>
          </description>
        </leaf>
        <leaf name="ebgp_route_distance">
          <type name="uint8">
            <range value="1..255"/>
          </type>
          <description>
            <text>Distance for routes external to the AS</text>
          </description>
        </leaf>
        <leaf name="ibgp_route_distance">
          <type name="uint8">
            <range value="1..255"/>
          </type>
          <description>
            <text>Distance for routes internal to the AS</text>
          </description>
        </leaf>
        <leaf name="local_route_distance">
          <type name="uint8">
            <range value="1..255"/>
          </type>
          <description>
            <text>Distance for local routes</text>
          </description>
        </leaf>
        <leaf name="ibgp_equal_cluster_length">
          <type name="boolean"/>
          <description>
            <text>Require matching cluster-list length when comparing iBGP multipath candidates.</text>
          </description>
        </leaf>
        <leaf name="route_flap_dampen">
          <must condition="current()/../afi_safi = 'ipv4_unicast'">
            <error-message>
              <value>Route flap dampening is supported only for IPv4 address family!</value>
            </error-message>
          </must>
          <type name="boolean"/>
          <description>
            <text>Enable route-flap dampening</text>
          </description>
        </leaf>
        <leaf name="route_flap_dampen_half_life">
          <must condition="current()/../afi_safi = 'ipv4_unicast'">
            <error-message>
              <value>Route flap dampening is supported only for IPv4 address family!</value>
            </error-message>
          </must>
          <type name="uint8">
            <range value="1..45"/>
          </type>
          <description>
            <text>Half-life time for the penalty</text>
          </description>
        </leaf>
        <leaf name="route_flap_dampen_reuse_threshold">
          <must condition="current()/../afi_safi = 'ipv4_unicast'">
            <error-message>
              <value>Route flap dampening is supported only for IPv4 address family!</value>
            </error-message>
          </must>
          <type name="uint16">
            <range value="1..20000"/>
          </type>
          <description>
            <text>Value to start reusing a route</text>
          </description>
        </leaf>
        <leaf name="route_flap_dampen_suppress_threshold">
          <must condition="current()/../afi_safi = 'ipv4_unicast'">
            <error-message>
              <value>Route flap dampening is supported only for IPv4 address family!</value>
            </error-message>
          </must>
          <type name="uint16">
            <range value="1..20000"/>
          </type>
          <description>
            <text>Value to start suppressing a route</text>
          </description>
        </leaf>
        <leaf name="route_flap_dampen_max_suppress">
          <must condition="current()/../afi_safi = 'ipv4_unicast'">
            <error-message>
              <value>Route flap dampening is supported only for IPv4 address family!</value>
            </error-message>
          </must>
          <type name="uint8">
            <range value="1..255"/>
          </type>
          <description>
            <text>Maximum duration to suppress a stable route</text>
          </description>
        </leaf>
        <leaf name="autort">
          <type name="enumeration">
            <enum name="rfc8365-compatible"/>
          </type>
          <description>
            <text>L2VPN derive route targets as per rfc8365 for interoperability with other implementations.</text>
          </description>
        </leaf>
        <leaf name="advertise-all-vni">
          <type name="boolean"/>
          <description>
            <text>L2VPN advertise all VNIs</text>
          </description>
        </leaf>
        <leaf name="advertise-svi-ip">
          <type name="boolean"/>
          <description>
            <text>L2VPN advertise the local SVI IP address so that it can be accessible from remote VTEPs</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="BGP_GLOBALS_AF_AGGREGATE_ADDR">
      <list name="BGP_GLOBALS_AF_AGGREGATE_ADDR_LIST">
        <key value="vrf_name afi_safi ip_prefix"/>
        <leaf name="vrf_name">
          <type name="leafref">
            <path value="../../../BGP_GLOBALS/BGP_GLOBALS_LIST/vrf_name"/>
          </type>
          <description>
            <text>VRF name</text>
          </description>
        </leaf>
        <leaf name="afi_safi">
          <type name="string"/>
          <description>
            <text>Address family name and subsequent address family name</text>
          </description>
        </leaf>
        <leaf name="ip_prefix">
          <type name="inet:ip-prefix"/>
          <description>
            <text>Aggregate address</text>
          </description>
        </leaf>
        <leaf name="as_set">
          <type name="boolean"/>
          <description>
            <text>Generate AS set path information</text>
          </description>
        </leaf>
        <leaf name="summary_only">
          <type name="boolean"/>
          <description>
            <text>Filter more specific routes from updates</text>
          </description>
        </leaf>
        <leaf name="policy">
          <type name="leafref">
            <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
          </type>
          <description>
            <text>Apply route map to aggregate network</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="BGP_GLOBALS_AF_NETWORK">
      <list name="BGP_GLOBALS_AF_NETWORK_LIST">
        <key value="vrf_name afi_safi ip_prefix"/>
        <leaf name="vrf_name">
          <type name="leafref">
            <path value="../../../BGP_GLOBALS/BGP_GLOBALS_LIST/vrf_name"/>
          </type>
          <description>
            <text>VRF name</text>
          </description>
        </leaf>
        <leaf name="afi_safi">
          <type name="string"/>
          <description>
            <text>Address family name and subsequent address family name</text>
          </description>
        </leaf>
        <leaf name="ip_prefix">
          <type name="inet:ip-prefix"/>
          <description>
            <text>Network address</text>
          </description>
        </leaf>
        <leaf name="policy">
          <type name="leafref">
            <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
          </type>
          <description>
            <text>Route-map to modify the attributes</text>
          </description>
        </leaf>
        <leaf name="backdoor">
          <type name="boolean"/>
          <description>
            <text>Indicates the backdoor route</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
