<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bgp-prefix-list"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bgppl="http://github.com/sonic-net/sonic-bgp-prefix-list"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-bgp-prefix-list"/>
  <prefix value="bgppl"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>SONIC Device-specfifc BGP prefix lists data</text>
  </description>
  <revision date="2025-02-17">
    <description>
      <text>Updated description and leafs for PREFIX_LIST_LIST</text>
    </description>
  </revision>
  <revision date="2025-02-05">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-bgp-prefix-list">
    <container name="PREFIX_LIST">
      <description>
        <text>PREFIX_LIST container consumed in BGP</text>
      </description>
      <list name="PREFIX_LIST_LIST">
        <description>
          <text>Each entry defines a prefix type and IP prefix used for BGP route filtering.</text>
        </description>
        <key value="prefix_type ip-prefix"/>
        <leaf name="prefix_type">
          <type name="string"/>
          <description>
            <text>Prefix type</text>
          </description>
        </leaf>
        <leaf name="ip-prefix">
          <type name="union">
            <type name="stypes:sonic-ip4-prefix"/>
            <type name="stypes:sonic-ip6-prefix"/>
          </type>
          <description>
            <text>IPv4 or IPv6 prefix in CIDR notation.</text>
          </description>
        </leaf>
        <leaf name="family">
          <must condition="(contains(../ip-prefix, ':') and current()='IPv6') or&#10;(contains(../ip-prefix, '.') and current()='IPv4')"/>
          <type name="stypes:ip-family"/>
          <description>
            <text>Address family (IPv4 or IPv6) matching the ip-prefix format.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
