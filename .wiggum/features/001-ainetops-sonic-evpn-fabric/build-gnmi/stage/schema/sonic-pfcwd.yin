<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-pfcwd"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:sonic-pfcwd="http://github.com/sonic-net/sonic-pfcwd"
        xmlns:port="http://github.com/sonic-net/sonic-port">
  <namespace uri="http://github.com/sonic-net/sonic-pfcwd"/>
  <prefix value="sonic-pfcwd"/>
  <yang-version value="1.1"/>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC PFC Watchdog parameters</text>
  </description>
  <revision date="2021-07-01">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-pfcwd">
    <container name="PFC_WD">
      <description>
        <text>Configures PFC Watchdog to detect and mitigate PFC pause storms on ports.</text>
      </description>
      <list name="PFC_WD_LIST">
        <key value="ifname"/>
        <description>
          <text>PFC Watchdog settings for a port or global defaults.</text>
        </description>
        <leaf name="ifname">
          <type name="union">
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="string">
              <pattern value="GLOBAL">
                <error-message>
                  <value>Invalid interface name</value>
                </error-message>
                <error-app-tag value="interface-name-invalid"/>
              </pattern>
            </type>
          </type>
          <description>
            <text>Port name or GLOBAL for system-wide PFC Watchdog defaults.</text>
          </description>
        </leaf>
        <leaf name="action">
          <must condition="../ifname != 'GLOBAL'"/>
          <type name="enumeration">
            <enum name="drop"/>
            <enum name="forward"/>
            <enum name="alert"/>
          </type>
          <description>
            <text>PFC watchdog action when entering storm state.</text>
          </description>
        </leaf>
        <leaf name="detection_time">
          <must condition="../ifname != 'GLOBAL'"/>
          <must condition="(not(boolean(current()/../../PFC_WD_LIST[ifname='GLOBAL'])) or (current() &gt;= current()/../../PFC_WD_LIST[ifname='GLOBAL']/POLL_INTERVAL))">
            <error-message>
              <value>detection_time must be greater than or equal to POLL_INTERVAL</value>
            </error-message>
          </must>
          <type name="uint32">
            <range value="100..5000"/>
          </type>
          <description>
            <text>Detection interval for pause storm in msec.</text>
          </description>
        </leaf>
        <leaf name="restoration_time">
          <must condition="../ifname != 'GLOBAL'"/>
          <must condition="(not(boolean(current()/../../PFC_WD_LIST[ifname='GLOBAL'])) or (current() &gt;= current()/../../PFC_WD_LIST[ifname='GLOBAL']/POLL_INTERVAL))">
            <error-message>
              <value>restoration_time must be greater than or equal to POLL_INTERVAL</value>
            </error-message>
          </must>
          <type name="uint32">
            <range value="100..60000"/>
          </type>
          <description>
            <text>Time delay before resuming normal PFC operation in msec.</text>
          </description>
        </leaf>
        <leaf name="pfc_stat_history">
          <must condition="../ifname != 'GLOBAL'"/>
          <type name="string">
            <pattern value="enable|disable">
              <error-message>
                <value>pfc_stat_history must be either enable or disable</value>
              </error-message>
              <error-app-tag value="pfc-stat-history-invalid-status"/>
            </pattern>
          </type>
          <description>
            <text>Toggle for PFC Historical Statistics estimation.</text>
          </description>
        </leaf>
        <leaf name="POLL_INTERVAL">
          <must condition="../ifname = 'GLOBAL'"/>
          <type name="uint32">
            <range value="100..1000"/>
          </type>
          <description>
            <text>PFC watchdog global polling interval in msec.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
