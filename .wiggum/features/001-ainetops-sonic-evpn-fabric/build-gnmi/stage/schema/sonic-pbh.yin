<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-pbh"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:pbh="http://github.com/sonic-net/sonic-pbh"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-pbh"/>
  <prefix value="pbh"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <description>
    <text>PBH YANG Module for SONiC OS: hashing for NVGRE &amp; VxLAN with IPv4/IPv6 inner 5-tuple</text>
  </description>
  <revision date="2021-04-23">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <typedef name="hash-field">
    <description>
      <text>Represents native hash field</text>
    </description>
    <type name="stypes:hash-field">
      <enum name="INNER_IP_PROTOCOL"/>
      <enum name="INNER_L4_DST_PORT"/>
      <enum name="INNER_L4_SRC_PORT"/>
      <enum name="INNER_DST_IPV4"/>
      <enum name="INNER_SRC_IPV4"/>
      <enum name="INNER_DST_IPV6"/>
      <enum name="INNER_SRC_IPV6"/>
    </type>
  </typedef>
  <typedef name="packet-action">
    <description>
      <text>Represents packet action</text>
    </description>
    <type name="enumeration">
      <enum name="SET_ECMP_HASH"/>
      <enum name="SET_LAG_HASH"/>
    </type>
  </typedef>
  <typedef name="flow-counter">
    <description>
      <text>Represents flow counter state</text>
    </description>
    <type name="enumeration">
      <enum name="DISABLED"/>
      <enum name="ENABLED"/>
    </type>
  </typedef>
  <container name="sonic-pbh">
    <container name="PBH_HASH_FIELD">
      <description>
        <text>Policy-based hash field definitions for inner packet tuple extraction</text>
      </description>
      <list name="PBH_HASH_FIELD_LIST">
        <key value="hash_field_name"/>
        <leaf name="hash_field_name">
          <description>
            <text>The name of this hash field</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="hash_field">
          <description>
            <text>Configures native hash field for this hash field</text>
          </description>
          <mandatory value="true"/>
          <type name="pbh:hash-field"/>
        </leaf>
        <leaf name="ip_mask">
          <description>
            <text>Configures IPv4/IPv6 address mask for this hash field</text>
          </description>
          <mandatory value="true"/>
          <type name="inet:ip-address-no-zone"/>
          <must condition="(boolean(../hash_field[.='INNER_DST_IPV4' or .='INNER_SRC_IPV4']) and contains(current(), '.'))&#10;     &#9;&#9;&#9;or (boolean(../hash_field[.='INNER_DST_IPV6' or .='INNER_SRC_IPV6']) and contains(current(), ':'))"/>
          <when condition="boolean(../hash_field[.='INNER_DST_IPV4' or .='INNER_SRC_IPV4' or .='INNER_DST_IPV6' or .='INNER_SRC_IPV6'])"/>
        </leaf>
        <leaf name="sequence_id">
          <description>
            <text>Configures in which order the fields are hashed and defines which fields should be associative</text>
          </description>
          <mandatory value="true"/>
          <type name="uint32"/>
        </leaf>
      </list>
    </container>
    <container name="PBH_HASH">
      <description>
        <text>Policy-based hash definitions combining hash fields</text>
      </description>
      <list name="PBH_HASH_LIST">
        <key value="hash_name"/>
        <leaf name="hash_name">
          <description>
            <text>The name of this hash</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf-list name="hash_field_list">
          <description>
            <text>The list of hash fields to apply with this hash</text>
          </description>
          <min-elements value="1"/>
          <type name="leafref">
            <path value="/pbh:sonic-pbh/pbh:PBH_HASH_FIELD/pbh:PBH_HASH_FIELD_LIST/pbh:hash_field_name"/>
          </type>
          <ordered-by value="user"/>
        </leaf-list>
      </list>
    </container>
    <container name="PBH_RULE">
      <description>
        <text>Policy-based hashing rules matching packets and applying hash profiles</text>
      </description>
      <list name="PBH_RULE_LIST">
        <key value="table_name rule_name"/>
        <leaf name="table_name">
          <description>
            <text>The name of table which holds this rule</text>
          </description>
          <type name="leafref">
            <path value="/pbh:sonic-pbh/pbh:PBH_TABLE/pbh:PBH_TABLE_LIST/pbh:table_name"/>
          </type>
        </leaf>
        <leaf name="rule_name">
          <description>
            <text>The name of this rule</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="priority">
          <description>
            <text>Configures priority for this rule</text>
          </description>
          <mandatory value="true"/>
          <type name="uint32"/>
        </leaf>
        <leaf name="gre_key">
          <description>
            <text>Configures packet match for this rule: GRE key (value/mask)</text>
          </description>
          <type name="string">
            <pattern value="(0x){1}[a-fA-F0-9]{1,8}/(0x){1}[a-fA-F0-9]{1,8}"/>
          </type>
        </leaf>
        <leaf name="ether_type">
          <description>
            <text>Configures packet match for this rule: EtherType (IANA Ethertypes)</text>
          </description>
          <type name="string">
            <pattern value="(0x){1}[a-fA-F0-9]{1,4}"/>
          </type>
        </leaf>
        <leaf name="ip_protocol">
          <description>
            <text>Configures packet match for this rule: IP protocol (IANA Protocol Numbers)</text>
          </description>
          <type name="string">
            <pattern value="(0x){1}[a-fA-F0-9]{1,2}"/>
          </type>
        </leaf>
        <leaf name="ipv6_next_header">
          <description>
            <text>Configures packet match for this rule: IPv6 Next header (IANA Protocol Numbers)</text>
          </description>
          <type name="string">
            <pattern value="(0x){1}[a-fA-F0-9]{1,2}"/>
          </type>
        </leaf>
        <leaf name="l4_dst_port">
          <description>
            <text>Configures packet match for this rule: L4 destination port</text>
          </description>
          <type name="string">
            <pattern value="(0x){1}[a-fA-F0-9]{1,4}"/>
          </type>
        </leaf>
        <leaf name="inner_ether_type">
          <description>
            <text>Configures packet match for this rule: inner EtherType (IANA Ethertypes)</text>
          </description>
          <type name="string">
            <pattern value="(0x){1}[a-fA-F0-9]{1,4}"/>
          </type>
        </leaf>
        <leaf name="hash">
          <description>
            <text>The hash to apply with this rule</text>
          </description>
          <mandatory value="true"/>
          <type name="leafref">
            <path value="/pbh:sonic-pbh/pbh:PBH_HASH/pbh:PBH_HASH_LIST/pbh:hash_name"/>
          </type>
        </leaf>
        <leaf name="packet_action">
          <description>
            <text>Configures packet action for this rule</text>
          </description>
          <type name="pbh:packet-action"/>
          <default value="SET_ECMP_HASH"/>
        </leaf>
        <leaf name="flow_counter">
          <description>
            <text>Enables/Disables packet/byte counter for this rule</text>
          </description>
          <type name="pbh:flow-counter"/>
          <default value="DISABLED"/>
        </leaf>
      </list>
    </container>
    <container name="PBH_TABLE">
      <description>
        <text>Policy-based hashing tables binding rules to interfaces</text>
      </description>
      <list name="PBH_TABLE_LIST">
        <key value="table_name"/>
        <leaf name="table_name">
          <description>
            <text>The name of this table</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf-list name="interface_list">
          <description>
            <text>Interfaces to which this table is applied</text>
          </description>
          <min-elements value="1"/>
          <type name="union">
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
          </type>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf name="description">
          <description>
            <text>The description of this table</text>
          </description>
          <mandatory value="true"/>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
      </list>
    </container>
  </container>
</module>
