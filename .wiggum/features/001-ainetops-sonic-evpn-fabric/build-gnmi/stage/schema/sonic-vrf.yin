<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-vrf"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <namespace uri="http://github.com/sonic-net/sonic-vrf"/>
  <prefix value="vrf"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>Virtual Routing and Forwarding (VRF) instance configuration for L3 traffic isolation</text>
  </description>
  <revision date="2021-03-30">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-vrf">
    <container name="VRF">
      <description>
        <text>VRF instance configuration table</text>
      </description>
      <list name="VRF_LIST">
        <description>
          <text>Configuration entry for a Virtual Routing and Forwarding instance</text>
        </description>
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>VRF instance name (e.g. Vrf_blue)</text>
          </description>
          <type name="stypes:interface_name">
            <pattern value="Vrf[a-zA-Z0-9_-]+">
              <error-message>
                <value>Invalid VRF name</value>
              </error-message>
              <error-app-tag value="vrf-name-invalid"/>
            </pattern>
          </type>
        </leaf>
        <leaf name="fallback">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Enable/disable fallback feature which is useful for specified VRF user to access internet through global/main route.</text>
          </description>
        </leaf>
        <leaf name="vni">
          <type name="uint32">
            <range value="0..16777215"/>
          </type>
          <default value="0"/>
          <description>
            <text>VNI mapped to VRF</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
