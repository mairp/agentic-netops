<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bgp-aggregate-address"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bgp-aggregate-address="http://github.com/sonic-net/sonic-bgp-aggregate-address"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types">
  <namespace uri="http://github.com/sonic-net/sonic-bgp-aggregate-address"/>
  <prefix value="bgp-aggregate-address"/>
  <yang-version value="1.1"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC BGP aggregate address configuration module.</text>
  </description>
  <revision date="2024-07-10">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-bgp-aggregate-address">
    <container name="BGP_AGGREGATE_ADDRESS">
      <description>
        <text>BGP aggregate address configuration for summarizing prefixes.</text>
      </description>
      <list name="BGP_AGGREGATE_ADDRESS_LIST">
        <description>
          <text>Each entry defines a BGP aggregate address and its advertisement options.</text>
        </description>
        <key value="aggregate-address"/>
        <leaf name="aggregate-address">
          <type name="inet:ip-prefix"/>
          <description>
            <text>Aggregate address to be advertised</text>
          </description>
        </leaf>
        <leaf name="bbr-required">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Require a Border Gateway Protocol Best Route (BBR) entry before generating the aggregate.</text>
          </description>
        </leaf>
        <leaf name="summary-only">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Suppress more-specific routes and only advertise the aggregate summary.</text>
          </description>
        </leaf>
        <leaf name="as-set">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Include AS_SET path information in the aggregate to preserve origin AS data.</text>
          </description>
        </leaf>
        <leaf name="aggregate-address-prefix-list">
          <type name="string">
            <pattern value="[0-9a-zA-Z_-]*"/>
            <length value="0..128"/>
          </type>
          <default value=""/>
          <description>
            <text>Prefix list used to filter which prefixes are included in the aggregate advertisement.</text>
          </description>
        </leaf>
        <leaf name="contributing-address-prefix-list">
          <type name="string">
            <pattern value="[0-9a-zA-Z_-]*"/>
            <length value="0..128"/>
          </type>
          <default value=""/>
          <description>
            <text>Prefix list used to filter which contributing routes are considered for the aggregate.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
