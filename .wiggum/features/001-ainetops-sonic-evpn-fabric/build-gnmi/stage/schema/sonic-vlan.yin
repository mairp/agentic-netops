<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-vlan"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:vlan="http://github.com/sonic-net/sonic-vlan"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:yang="urn:ietf:params:xml:ns:yang:ietf-yang-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf"
        xmlns:sms="http://github.com/sonic-net/sonic-mirror-session"
        xmlns:intf="http://github.com/sonic-net/sonic-interface"
        xmlns:svnet="http://github.com/sonic-net/sonic-vnet">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-vlan"/>
  <prefix value="vlan"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="ietf-yang-types">
    <prefix value="yang"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
    <revision-date date="2019-07-01"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-vrf">
    <prefix value="vrf"/>
  </import>
  <import module="sonic-mirror-session">
    <prefix value="sms"/>
  </import>
  <import module="sonic-interface">
    <prefix value="intf"/>
  </import>
  <import module="sonic-vnet">
    <prefix value="svnet"/>
  </import>
  <description>
    <text>VLAN yang Module for SONiC OS</text>
  </description>
  <revision date="2025-03-06">
    <description>
      <text>Add leaf vnet_name</text>
    </description>
  </revision>
  <revision date="2024-03-07">
    <description>
      <text>Add Constraints that are implemented in CLI</text>
    </description>
  </revision>
  <revision date="2021-04-28">
    <description>
      <text>Modify Vlan name constraint to allow only legal Vlan names</text>
    </description>
  </revision>
  <revision date="2021-04-22">
    <description>
      <text>Modify Vlan Member to include PortChannel along with Port</text>
    </description>
  </revision>
  <revision date="2021-03-30">
    <description>
      <text>Modify the type of vrf name</text>
    </description>
  </revision>
  <revision date="2019-07-01">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-vlan">
    <container name="VLAN_INTERFACE">
      <description>
        <text>Layer 3 IP interface configuration for VLANs</text>
      </description>
      <list name="VLAN_INTERFACE_LIST">
        <description>
          <text>VLAN interface with optional VRF binding and interface attributes</text>
        </description>
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>VLAN interface name (e.g., Vlan100)</text>
          </description>
          <type name="leafref">
            <path value="/vlan:sonic-vlan/vlan:VLAN/vlan:VLAN_LIST/vlan:name"/>
          </type>
        </leaf>
        <leaf name="vrf_name">
          <description>
            <text>VRF instance this VLAN interface belongs to</text>
          </description>
          <type name="leafref">
            <path value="/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name"/>
          </type>
        </leaf>
        <leaf name="vnet_name">
          <description>
            <text>Reference to the name of a VNET in sonic-vnet model</text>
          </description>
          <type name="leafref">
            <path value="/svnet:sonic-vnet/svnet:VNET/svnet:VNET_LIST/svnet:name"/>
          </type>
        </leaf>
        <leaf name="nat_zone">
          <description>
            <text>NAT Zone for the vlan interface</text>
          </description>
          <type name="uint8">
            <range value="0..3">
              <error-message>
                <value>Invalid nat zone for the vlan interface.</value>
              </error-message>
              <error-app-tag value="nat-zone-invalid"/>
            </range>
          </type>
          <default value="0"/>
        </leaf>
        <leaf name="mpls">
          <description>
            <text>Enable/disable MPLS routing for the vlan interface</text>
          </description>
          <type name="enumeration">
            <enum name="enable"/>
            <enum name="disable"/>
          </type>
        </leaf>
        <leaf name="grat_arp">
          <description>
            <text>Enable or disable gratuitous ARP on the VLAN interface</text>
          </description>
          <type name="string">
            <pattern value="enabled|disabled"/>
          </type>
        </leaf>
        <leaf name="proxy_arp">
          <description>
            <text>Enable or disable proxy ARP on the VLAN interface</text>
          </description>
          <type name="string">
            <pattern value="enabled|disabled"/>
          </type>
        </leaf>
        <leaf name="ipv6_use_link_local_only">
          <description>
            <text>Enable/Disable IPv6 link local address on vlan interface</text>
          </description>
          <type name="stypes:mode-status"/>
          <default value="disable"/>
        </leaf>
        <leaf name="mac_addr">
          <description>
            <text>Assign administrator-provided MAC address to Interface</text>
          </description>
          <type name="yang:mac-address"/>
        </leaf>
        <leaf name="loopback_action">
          <description>
            <text>Packet action when a packet ingress and gets routed on the same IP interface</text>
          </description>
          <type name="stypes:loopback_action"/>
        </leaf>
      </list>
      <list name="VLAN_INTERFACE_IPPREFIX_LIST">
        <key value="name ip-prefix"/>
        <leaf name="name">
          <description>
            <text>VLAN interface name (e.g., Vlan100)</text>
          </description>
          <must condition="(current() = ../../VLAN_INTERFACE_LIST[name=current()]/name)">
            <error-message>
              <value>Must condition not satisfied, Try adding Vlan&lt;vlanid&gt;: {}, Example: 'Vlan100': {}</value>
            </error-message>
          </must>
          <type name="leafref">
            <path value="/vlan:sonic-vlan/vlan:VLAN/vlan:VLAN_LIST/vlan:name"/>
          </type>
        </leaf>
        <leaf name="ip-prefix">
          <description>
            <text>IP address and prefix length assigned to the VLAN interface</text>
          </description>
          <type name="union">
            <type name="stypes:sonic-ip4-prefix"/>
            <type name="stypes:sonic-ip6-prefix"/>
          </type>
        </leaf>
        <leaf name="scope">
          <description>
            <text>Address scope, either global or link-local</text>
          </description>
          <type name="enumeration">
            <enum name="global"/>
            <enum name="local"/>
          </type>
        </leaf>
        <leaf name="family">
          <description>
            <text>Address family (IPv4 or IPv6)</text>
          </description>
          <must condition="(contains(../ip-prefix, ':') and current()='IPv6') or&#10;     &#9;&#9;&#9;&#9;(contains(../ip-prefix, '.') and current()='IPv4')"/>
          <type name="stypes:ip-family"/>
        </leaf>
        <leaf name="secondary">
          <description>
            <text>Optional field to specify if the prefix is secondary subnet</text>
          </description>
          <type name="boolean"/>
        </leaf>
      </list>
    </container>
    <container name="VLAN">
      <description>
        <text>IEEE 802.1Q VLAN definitions</text>
      </description>
      <list name="VLAN_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>VLAN name in the form VlanNNN (e.g., Vlan100)</text>
          </description>
          <type name="string">
            <pattern value="Vlan(409[0-5]|40[0-8][0-9]|[1-3][0-9]{3}|[1-9][0-9]{2}|[1-9][0-9]|[2-9])"/>
          </type>
        </leaf>
        <leaf name="vlanid">
          <description>
            <text>IEEE 802.1Q VLAN identifier (2-4094)</text>
          </description>
          <type name="uint16">
            <range value="2..4094"/>
          </type>
          <must condition="substring-after(../name, 'Vlan') = current()">
            <error-message>
              <value>The vlanid must correspond to the VLAN name</value>
            </error-message>
          </must>
        </leaf>
        <leaf name="alias">
          <description>
            <text>User-defined alias for the VLAN</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="description">
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf-list name="dhcp_servers">
          <description>
            <text>Configure the dhcp v4 servers</text>
          </description>
          <type name="inet:ip-address"/>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf-list name="dhcpv6_servers">
          <description>
            <text>Configure the dhcp v6 servers</text>
          </description>
          <type name="inet:ipv6-address"/>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf name="mtu">
          <type name="uint16">
            <range value="1..9216"/>
          </type>
        </leaf>
        <leaf name="admin_status">
          <type name="stypes:admin_status"/>
        </leaf>
        <leaf name="mac">
          <type name="yang:mac-address"/>
        </leaf>
      </list>
    </container>
    <container name="VLAN_MEMBER">
      <description>
        <text>VLAN port membership and tagging configuration</text>
      </description>
      <list name="VLAN_MEMBER_LIST">
        <key value="name port"/>
        <leaf name="name">
          <description>
            <text>VLAN name this member belongs to</text>
          </description>
          <type name="leafref">
            <path value="/vlan:sonic-vlan/vlan:VLAN/vlan:VLAN_LIST/vlan:name"/>
          </type>
        </leaf>
        <leaf name="port">
          <description>
            <text>Physical port or port channel assigned to this VLAN</text>
          </description>
          <type name="union">
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
          </type>
          <must condition="not(/sms:sonic-mirror-session/sms:MIRROR_SESSION/sms:MIRROR_SESSION_LIST[sms:dst_port=current()])">
            <error-message>
              <value>Port is used as a destination port in a mirror session.</value>
            </error-message>
          </must>
          <must condition="not(/lag:sonic-portchannel/lag:PORTCHANNEL_MEMBER/lag:PORTCHANNEL_MEMBER_LIST[lag:port=current()]/lag:name)">
            <error-message>
              <value>Port is a member of a port channel.</value>
            </error-message>
          </must>
          <must condition="not(/intf:sonic-interface/intf:INTERFACE/intf:INTERFACE_LIST[intf:name=current()])">
            <error-message>
              <value>Port is a router interface.</value>
            </error-message>
          </must>
          <must condition="count(../../vlan:VLAN_MEMBER_LIST[vlan:port=current() and vlan:tagging_mode='untagged']) &lt;= 1">
            <error-message>
              <value>Port can be untagged in at most one VLAN.</value>
            </error-message>
          </must>
        </leaf>
        <leaf name="tagging_mode">
          <description>
            <text>Whether frames on this port are IEEE 802.1Q tagged or untagged</text>
          </description>
          <mandatory value="true"/>
          <type name="stypes:vlan_tagging_mode"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
