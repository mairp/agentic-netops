<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-banner"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:banner_message="http://github.com/sonic-net/sonic-banner"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-banner"/>
  <prefix value="banner_message"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>Login, MOTD, and logout banner message YANG module for SONiC OS.</text>
  </description>
  <revision date="2023-05-18">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-banner">
    <container name="BANNER_MESSAGE">
      <description>
        <text>Banner messages displayed during login and logout.</text>
      </description>
      <container name="global">
        <description>
          <text>Global banner message settings.</text>
        </description>
        <leaf name="state">
          <type name="stypes:admin_mode"/>
          <description>
            <text>Enable or disable the banner feature.</text>
          </description>
          <default value="disabled"/>
        </leaf>
        <leaf name="login">
          <type name="string"/>
          <description>
            <text>Banner message displayed to user before login prompt</text>
          </description>
          <default value="Debian GNU/Linux 11"/>
        </leaf>
        <leaf name="motd">
          <type name="string"/>
          <description>
            <text>Banner message displayed to user after login prompt</text>
          </description>
          <default value="You are on&#10; ____   ___  _   _ _  ____&#10;/ ___| / _ \| \ | (_)/ ___|&#10;\___ \| | | |  \| | | |&#10; ___) | |_| | |\  | | |___&#10;|____/ \___/|_| \_|_|\____|&#10;-- Software for Open Networking in the Cloud --&#10;Unauthorized access and/or use are prohibited.&#10;All access and/or use are subject to monitoring.&#10;Help:    https://sonic-net.github.io/SONiC/&#10;"/>
        </leaf>
        <leaf name="logout">
          <type name="string"/>
          <description>
            <text>Banner message displayed to users on logout.</text>
          </description>
          <default value=""/>
        </leaf>
      </container>
    </container>
  </container>
</module>
