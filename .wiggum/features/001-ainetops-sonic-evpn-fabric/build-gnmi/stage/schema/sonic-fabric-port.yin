<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-fabric-port"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:fabric-port="http://github.com/sonic-net/sonic-fabric-port"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-fabric-port"/>
  <prefix value="fabric-port"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>FABRIC_PORT yang Module for SONiC OS</text>
  </description>
  <revision date="2023-03-14">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-fabric-port">
    <container name="FABRIC_PORT">
      <description>
        <text>Fabric port configuration for VOQ chassis inter-linecard links</text>
      </description>
      <list name="FABRIC_PORT_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Fabric port name identifier</text>
          </description>
          <type name="string">
            <length value="1..128"/>
          </type>
        </leaf>
        <leaf name="isolateStatus">
          <description>
            <text>Isolation status of a fabric port</text>
          </description>
          <type name="stypes:boolean_type"/>
          <default value="False"/>
        </leaf>
        <leaf name="alias">
          <description>
            <text>Alias of a fabric port</text>
          </description>
          <type name="string">
            <length value="1..128"/>
          </type>
        </leaf>
        <leaf name="lanes">
          <description>
            <text>Lanes of a fabric port</text>
          </description>
          <mandatory value="true"/>
          <type name="string">
            <length value="1..128"/>
          </type>
        </leaf>
        <leaf name="forceUnisolateStatus">
          <description>
            <text>Force unisolate status of a fabric port</text>
          </description>
          <type name="uint32"/>
          <default value="0"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
