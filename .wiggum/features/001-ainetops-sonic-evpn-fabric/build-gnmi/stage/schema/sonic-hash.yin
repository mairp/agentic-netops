<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-hash"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:hash="http://github.com/sonic-net/sonic-hash"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-hash"/>
  <prefix value="hash"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>HASH YANG Module for SONiC OS</text>
  </description>
  <revision date="2023-09-25">
    <description>
      <text>Added hashing algorithm configuration</text>
    </description>
  </revision>
  <revision date="2022-09-05">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <typedef name="hash-field">
    <description>
      <text>Represents native hash field</text>
    </description>
    <type name="stypes:hash-field">
      <enum name="IN_PORT"/>
      <enum name="DST_MAC"/>
      <enum name="SRC_MAC"/>
      <enum name="ETHERTYPE"/>
      <enum name="VLAN_ID"/>
      <enum name="IP_PROTOCOL"/>
      <enum name="DST_IP"/>
      <enum name="SRC_IP"/>
      <enum name="L4_DST_PORT"/>
      <enum name="L4_SRC_PORT"/>
      <enum name="INNER_DST_MAC"/>
      <enum name="INNER_SRC_MAC"/>
      <enum name="INNER_ETHERTYPE"/>
      <enum name="INNER_IP_PROTOCOL"/>
      <enum name="INNER_DST_IP"/>
      <enum name="INNER_SRC_IP"/>
      <enum name="INNER_L4_DST_PORT"/>
      <enum name="INNER_L4_SRC_PORT"/>
      <enum name="IPV6_FLOW_LABEL"/>
    </type>
  </typedef>
  <container name="sonic-hash">
    <container name="SWITCH_HASH">
      <description>
        <text>Global switch hash configuration for ECMP and LAG</text>
      </description>
      <container name="GLOBAL">
        <description>
          <text>Global hash field and algorithm settings</text>
        </description>
        <leaf-list name="ecmp_hash">
          <description>
            <text>Hash fields for hashing packets going through ECMP</text>
          </description>
          <type name="hash:hash-field"/>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf-list name="lag_hash">
          <description>
            <text>Hash fields for hashing packets going through LAG</text>
          </description>
          <type name="hash:hash-field"/>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf name="ecmp_hash_algorithm">
          <description>
            <text>Hash algorithm for hashing packets going through ECMP</text>
          </description>
          <type name="stypes:hash-algorithm"/>
        </leaf>
        <leaf name="lag_hash_algorithm">
          <description>
            <text>Hash algorithm for hashing packets going through LAG</text>
          </description>
          <type name="stypes:hash-algorithm"/>
        </leaf>
      </container>
    </container>
  </container>
</module>
