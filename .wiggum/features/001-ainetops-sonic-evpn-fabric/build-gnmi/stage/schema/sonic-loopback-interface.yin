<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-loopback-interface"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:lointf="http://github.com/sonic-net/sonic-loopback-interface"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-loopback-interface"/>
  <prefix value="lointf"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <import module="sonic-vrf">
    <prefix value="vrf"/>
  </import>
  <description>
    <text>Loopback interface configuration for virtual interfaces used as router IDs and service IPs</text>
  </description>
  <revision date="2021-04-05">
    <description>
      <text>Modify the type of vrf name</text>
    </description>
  </revision>
  <revision date="2020-02-05">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-loopback-interface">
    <container name="LOOPBACK_INTERFACE">
      <description>
        <text>Loopback interface configuration table</text>
      </description>
      <list name="LOOPBACK_INTERFACE_LIST">
        <description>
          <text>Configuration entry for a loopback interface including VRF binding and properties</text>
        </description>
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Loopback interface name (e.g. Loopback0)</text>
          </description>
          <type name="stypes:interface_name"/>
        </leaf>
        <leaf name="vrf_name">
          <description>
            <text>VRF instance to which this loopback interface is bound</text>
          </description>
          <type name="leafref">
            <path value="/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name"/>
          </type>
        </leaf>
        <leaf name="nat_zone">
          <description>
            <text>NAT Zone for the loopback interface</text>
          </description>
          <type name="uint8">
            <range value="0..3">
              <error-message>
                <value>Invalid nat zone for the loopback interface.</value>
              </error-message>
              <error-app-tag value="nat-zone-invalid"/>
            </range>
          </type>
          <default value="0"/>
        </leaf>
        <leaf name="admin_status">
          <description>
            <text>Administrative state of the loopback interface</text>
          </description>
          <type name="stypes:admin_status"/>
          <default value="up"/>
        </leaf>
      </list>
      <list name="LOOPBACK_INTERFACE_IPPREFIX_LIST">
        <description>
          <text>IP address prefix assignment for a loopback interface</text>
        </description>
        <key value="name ip-prefix"/>
        <leaf name="name">
          <description>
            <text>Loopback interface name</text>
          </description>
          <type name="leafref">
            <path value="../../LOOPBACK_INTERFACE_LIST/name"/>
          </type>
        </leaf>
        <leaf name="ip-prefix">
          <description>
            <text>IPv4 or IPv6 address with prefix length assigned to the loopback interface</text>
          </description>
          <type name="union">
            <type name="stypes:sonic-ip4-prefix"/>
            <type name="stypes:sonic-ip6-prefix"/>
          </type>
        </leaf>
        <leaf name="scope">
          <description>
            <text>Address scope indicating global or link-local reachability</text>
          </description>
          <type name="enumeration">
            <enum name="global"/>
            <enum name="local"/>
          </type>
        </leaf>
        <leaf name="family">
          <description>
            <text>IP address family, must match the format of ip-prefix</text>
          </description>
          <must condition="(contains(../ip-prefix, ':') and current()='IPv6') or&#10;(contains(../ip-prefix, '.') and current()='IPv4')"/>
          <type name="stypes:ip-family"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
