<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-events-syncd"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:events-syncd="http://github.com/sonic-net/sonic-events-syncd"
        xmlns:evtcmn="http://github.com/sonic-net/sonic-events-common"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <namespace uri="http://github.com/sonic-net/sonic-events-syncd"/>
  <yang-version value="1.1"/>
  <prefix value="events-syncd"/>
  <import module="sonic-events-common">
    <prefix value="evtcmn"/>
    <revision-date date="2022-12-01"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC syncd events</text>
  </description>
  <revision date="2022-12-01">
    <description>
      <text>syncd alert events.</text>
    </description>
  </revision>
  <container name="sonic-events-syncd">
    <container name="syncd-failure">
      <evtcmn:ALARM_SEVERITY_MAJOR/>
      <description>
        <text>
Declares an event for all types of syncd failure.
The type of failure and the asic-index of failing syncd are
provided along with a human readable message to give the
dev debugging additional info.</text>
      </description>
      <leaf name="fail_type">
        <type name="enumeration">
          <enum name="route_add_failed"/>
          <enum name="switch_event"/>
          <enum name="assert"/>
          <enum name="mmu_err"/>
          <enum name="parity_check"/>
        </type>
        <description>
          <text>Type of syncd failure that occurred.</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="alpm-parity-error">
      <evtcmn:ALARM_SEVERITY_MAJOR/>
      <description>
        <text>
Declares an event for a parity error in ALPM
insert or delete for ipv4 or ipv6</text>
      </description>
      <leaf name="operation">
        <type name="enumeration">
          <enum name="insert"/>
          <enum name="delete"/>
        </type>
        <description>
          <text>Operation for alpm parity error</text>
        </description>
      </leaf>
      <leaf name="ip_family">
        <type name="stypes:ip-family"/>
        <description>
          <text>IP family for alpm parity error</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
  </container>
</module>
