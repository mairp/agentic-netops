<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bgp-neighbor"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bgpnbr="http://github.com/sonic-net/sonic-bgp-neighbor"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:bgpcmn="http://github.com/sonic-net/sonic-bgp-common"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:bgpg="http://github.com/sonic-net/sonic-bgp-global"
        xmlns:bgppg="http://github.com/sonic-net/sonic-bgp-peergroup">
  <namespace uri="http://github.com/sonic-net/sonic-bgp-neighbor"/>
  <prefix value="bgpnbr"/>
  <yang-version value="1.1"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-bgp-common">
    <prefix value="bgpcmn"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-bgp-global">
    <prefix value="bgpg"/>
  </import>
  <import module="sonic-bgp-peergroup">
    <prefix value="bgppg"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC BGP Neighbor</text>
  </description>
  <revision date="2021-02-26">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-bgp-neighbor">
    <container name="BGP_NEIGHBOR">
      <list name="BGP_NEIGHBOR_TEMPLATE_LIST">
        <description>
          <text>This list is to support template based BGP neighbor configuration handled by bgpcfgd</text>
        </description>
        <key value="neighbor"/>
        <leaf name="neighbor">
          <type name="inet:ip-address"/>
          <description>
            <text>BGP Neighbor address</text>
          </description>
        </leaf>
        <uses name="bgpcmn:sonic-bgp-cmn-neigh">
          <refine target-node="asn">
            <must condition=". &gt;= 1">
              <error-message>
                <value>ASN must be greater than 0</value>
              </error-message>
            </must>
          </refine>
        </uses>
      </list>
      <list name="BGP_NEIGHBOR_LIST">
        <description>
          <text>This list is to support generic BGP neighbor configuration handled by frrcfgd and
frr_mgmt_framework_config field should be set to true in DEVICE_METADATA talbe for accepting the generic BGP table configurations.</text>
        </description>
        <key value="vrf_name neighbor"/>
        <leaf name="vrf_name">
          <type name="leafref">
            <path value="/bgpg:sonic-bgp-global/bgpg:BGP_GLOBALS/bgpg:BGP_GLOBALS_LIST/bgpg:vrf_name"/>
          </type>
          <description>
            <text>Network-instance/VRF name</text>
          </description>
        </leaf>
        <leaf name="neighbor">
          <type name="union">
            <type name="inet:ip-address"/>
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
            <type name="string">
              <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
            </type>
          </type>
          <description>
            <text>BGP Neighbor, it will be neighbor address or interface name</text>
          </description>
        </leaf>
        <leaf name="peer_group_name">
          <type name="leafref">
            <path value="/bgppg:sonic-bgp-peergroup/bgppg:BGP_PEER_GROUP/bgppg:BGP_PEER_GROUP_LIST[bgppg:vrf_name=current()/../vrf_name]/bgppg:peer_group_name"/>
          </type>
          <description>
            <text>Peer group name</text>
          </description>
        </leaf>
        <uses name="bgpcmn:sonic-bgp-cmn"/>
      </list>
    </container>
    <container name="BGP_NEIGHBOR_AF">
      <list name="BGP_NEIGHBOR_AF_LIST">
        <key value="vrf_name neighbor afi_safi"/>
        <leaf name="vrf_name">
          <type name="leafref">
            <path value="/bgpg:sonic-bgp-global/bgpg:BGP_GLOBALS/bgpg:BGP_GLOBALS_LIST/bgpg:vrf_name"/>
          </type>
          <description>
            <text>Network-instance/VRF name</text>
          </description>
        </leaf>
        <leaf name="neighbor">
          <type name="leafref">
            <path value="../../../BGP_NEIGHBOR/BGP_NEIGHBOR_LIST[vrf_name=current()/../vrf_name]/neighbor"/>
          </type>
          <description>
            <text>BGP Neighbor, it will be neighbor address or interface name</text>
          </description>
        </leaf>
        <uses name="bgpcmn:sonic-bgp-cmn-af"/>
      </list>
    </container>
  </container>
</module>
