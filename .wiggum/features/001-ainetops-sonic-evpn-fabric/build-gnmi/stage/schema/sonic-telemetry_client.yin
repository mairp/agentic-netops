<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-telemetry_client"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:telemetry_client="http://github.com/sonic-net/sonic-telemetry_client"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-telemetry_client"/>
  <prefix value="telemetry_client"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>TELEMETRY_CLIENT yang Module for SONiC OS</text>
  </description>
  <revision date="2023-01-12">
    <description>
      <text>First revision</text>
    </description>
  </revision>
  <typedef name="report-type">
    <description>
      <text>Subscription reporting mode for dial-out telemetry.</text>
    </description>
    <type name="enumeration">
      <enum name="periodic"/>
      <enum name="stream"/>
      <enum name="once"/>
    </type>
  </typedef>
  <typedef name="path_target">
    <description>
      <text>SONiC database target for telemetry subscriptions.</text>
    </description>
    <type name="enumeration">
      <enum name="APPL_DB"/>
      <enum name="CONFIG_DB"/>
      <enum name="COUNTERS_DB"/>
      <enum name="STATE_DB"/>
      <enum name="OTHERS"/>
    </type>
  </typedef>
  <typedef name="encoding">
    <description>
      <text>Wire encoding format for telemetry data.</text>
    </description>
    <type name="enumeration">
      <enum name="JSON_IETF"/>
      <enum name="ASCII"/>
      <enum name="BYTES"/>
      <enum name="PROTO"/>
    </type>
  </typedef>
  <typedef name="ipv4-port">
    <description>
      <text>One or more IPv4 address and port pairs in host:port format, comma-separated.</text>
    </description>
    <type name="string">
      <pattern value="((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]):([0-9]|[1-9]\d{1,3}|[1-5]\d{1,4}|6[0-4]\d{1,3}|65[0-4]\d{1,2}|655[0-2][0-9]|6553[0-5]),?)+"/>
    </type>
  </typedef>
  <container name="sonic-telemetry_client">
    <container name="TELEMETRY_CLIENT">
      <description>
        <text>Telemetry dial-out client configuration.</text>
      </description>
      <container name="Global">
        <description>
          <text>Global settings for the telemetry dial-out client.</text>
        </description>
        <leaf name="retry_interval">
          <type name="uint64"/>
          <description>
            <text>retry_interval unit s</text>
          </description>
        </leaf>
        <leaf name="src_ip">
          <type name="inet:ip-address"/>
          <description>
            <text>Source IP address for dial-out connections.</text>
          </description>
        </leaf>
        <leaf name="encoding">
          <type name="encoding"/>
          <description>
            <text>Data encoding format for telemetry messages.</text>
          </description>
        </leaf>
        <leaf name="unidirectional">
          <type name="boolean"/>
          <default value="true"/>
          <description>
            <text>Whether the dial-out connection is unidirectional.</text>
          </description>
        </leaf>
      </container>
      <list name="TELEMETRY_CLIENT_LIST">
        <description>
          <text>Subscription and destination group entries for dial-out telemetry.</text>
        </description>
        <ordered-by value="user"/>
        <key value="prefix name"/>
        <leaf name="prefix">
          <type name="string">
            <pattern value="Subscription|DestinationGroup"/>
          </type>
          <description>
            <text>Entry type: Subscription or DestinationGroup.</text>
          </description>
        </leaf>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Name of this subscription or destination group.</text>
          </description>
        </leaf>
        <leaf name="dst_addr">
          <type name="ipv4-port"/>
          <description>
            <text>Collector address and port in host:port format.</text>
          </description>
        </leaf>
        <leaf name="dst_group">
          <must condition="(contains(../../TELEMETRY_CLIENT_LIST/name, current()))"/>
          <type name="string"/>
          <description>
            <text>Destination group name this subscription sends data to.</text>
          </description>
        </leaf>
        <leaf name="path_target">
          <type name="path_target"/>
          <description>
            <text>Target database to subscribe to.</text>
          </description>
        </leaf>
        <leaf name="paths">
          <type name="string"/>
          <description>
            <text>Comma-separated data paths to subscribe to within the target database.</text>
          </description>
        </leaf>
        <leaf name="report_interval">
          <type name="uint64"/>
          <description>
            <text>report_interval unit ms</text>
          </description>
          <default value="5000"/>
        </leaf>
        <leaf name="report_type">
          <type name="report-type"/>
          <description>
            <text>Reporting mode for this subscription.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
