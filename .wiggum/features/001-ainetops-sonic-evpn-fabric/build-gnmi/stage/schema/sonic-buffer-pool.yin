<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-buffer-pool"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bpl="http://github.com/sonic-net/sonic-buffer-pool"
        xmlns:device_metadata="http://github.com/sonic-net/sonic-device_metadata">
  <namespace uri="http://github.com/sonic-net/sonic-buffer-pool"/>
  <prefix value="bpl"/>
  <import module="sonic-device_metadata">
    <prefix value="device_metadata"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>Shared and dedicated memory pool configuration for packet buffering.</text>
  </description>
  <revision date="2021-07-01">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-buffer-pool">
    <container name="BUFFER_POOL">
      <description>
        <text>Configures ingress and egress buffer pools with size, threshold, and sharing mode.</text>
      </description>
      <list name="BUFFER_POOL_LIST">
        <description>
          <text>A named buffer pool entry.</text>
        </description>
        <key value="name"/>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Buffer Pool name</text>
          </description>
        </leaf>
        <leaf name="type">
          <mandatory value="true"/>
          <type name="enumeration">
            <enum name="ingress"/>
            <enum name="egress"/>
            <enum name="both"/>
          </type>
          <description>
            <text>Buffer Pool Type</text>
          </description>
        </leaf>
        <leaf name="mode">
          <mandatory value="true"/>
          <type name="enumeration">
            <enum name="static"/>
            <enum name="dynamic"/>
          </type>
          <description>
            <text>Buffer Pool Mode</text>
          </description>
        </leaf>
        <leaf name="size">
          <type name="uint64"/>
          <description>
            <text>Buffer Pool Size (in Bytes)</text>
          </description>
        </leaf>
        <leaf name="xoff">
          <default value="0"/>
          <type name="uint64"/>
          <description>
            <text>Buffer Pool Xoff Threshold (in Bytes)</text>
          </description>
        </leaf>
        <leaf name="percentage">
          <type name="uint8"/>
          <description>
            <text>
Buffer Pool percentage.
The buffer pool size will be available_buffer * percentage / 100 if percentage is provided.
It is valid in dynamic buffer model only.</text>
          </description>
          <must condition="(not(current()/../size))">
            <error-message>
              <value>Percentage should not be configured along with size</value>
            </error-message>
          </must>
          <must condition="/device_metadata:sonic-device_metadata/device_metadata:DEVICE_METADATA/device_metadata:localhost/device_metadata:buffer_model = 'dynamic'">
            <error-message>
              <value>Percentage must be configured in dynamic buffer model</value>
            </error-message>
          </must>
        </leaf>
      </list>
    </container>
  </container>
</module>
