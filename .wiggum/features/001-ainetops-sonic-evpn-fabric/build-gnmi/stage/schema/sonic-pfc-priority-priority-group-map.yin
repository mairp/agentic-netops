<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-pfc-priority-priority-group-map"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:pppgm="http://github.com/sonic-net/sonic-pfc-priority-priority-group-map">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-pfc-priority-priority-group-map"/>
  <prefix value="pppgm"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>PFC_PRIORITY_TO_PRIORITY_GROUP_MAP yang Module for SONiC OS</text>
  </description>
  <revision date="2021-04-15">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-pfc-priority-priority-group-map">
    <container name="PFC_PRIORITY_TO_PRIORITY_GROUP_MAP">
      <description>
        <text>Maps PFC priority values to ingress priority groups for lossless traffic handling.</text>
      </description>
      <list name="PFC_PRIORITY_TO_PRIORITY_GROUP_MAP_LIST">
        <key value="name"/>
        <description>
          <text>A named PFC priority to priority group map.</text>
        </description>
        <leaf name="name">
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for map name.</value>
              </error-message>
              <error-app-tag value="map-name-invalid-length"/>
            </length>
          </type>
          <description>
            <text>Name of the PFC priority to priority group map.</text>
          </description>
        </leaf>
        <list name="PFC_PRIORITY_TO_PRIORITY_GROUP_MAP">
          <key value="pfc_priority"/>
          <description>
            <text>Single mapping entry from a PFC priority to a priority group.</text>
          </description>
          <leaf name="pfc_priority">
            <type name="string">
              <pattern value="[0-7]?">
                <error-message>
                  <value>Invalid pfc priority</value>
                </error-message>
                <error-app-tag value="pfc-priority-invalid"/>
              </pattern>
            </type>
            <description>
              <text>PFC priority value (0-7).</text>
            </description>
          </leaf>
          <leaf name="pg">
            <type name="string">
              <pattern value="[0-7]?">
                <error-message>
                  <value>Invalid Priority Group</value>
                </error-message>
                <error-app-tag value="pg-invalid"/>
              </pattern>
            </type>
            <description>
              <text>Target ingress priority group (0-7).</text>
            </description>
          </leaf>
        </list>
      </list>
    </container>
  </container>
</module>
