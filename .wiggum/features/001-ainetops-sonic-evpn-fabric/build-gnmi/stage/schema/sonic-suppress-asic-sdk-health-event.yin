<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-suppress-asic-sdk-health-event"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:sch="http://github.com/sonic-net/sonic-suppress-asic-sdk-health-event">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-suppress-asic-sdk-health-event"/>
  <prefix value="sch"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>Suppress ASIC/SDK health event yang Module for SONiC OS</text>
  </description>
  <revision date="2023-11-29">
    <description>
      <text>Initial revision</text>
    </description>
  </revision>
  <container name="sonic-suppress-asic-sdk-health-event">
    <container name="SUPPRESS_ASIC_SDK_HEALTH_EVENT">
      <description>
        <text>Rules for suppressing ASIC/SDK health events by severity and category</text>
      </description>
      <list name="SUPPRESS_ASIC_SDK_HEALTH_EVENT_LIST">
        <key value="severity"/>
        <leaf name="severity">
          <type name="enumeration">
            <enum name="fatal"/>
            <enum name="warning"/>
            <enum name="notice"/>
          </type>
          <description>
            <text>Severity of the ASIC/SDK health event to suppress</text>
          </description>
        </leaf>
        <leaf name="max_events">
          <type name="uint32"/>
          <description>
            <text>Maximum of events that can be stored in the database</text>
          </description>
        </leaf>
        <leaf-list name="categories">
          <type name="enumeration">
            <enum name="software"/>
            <enum name="firmware"/>
            <enum name="cpu_hw"/>
            <enum name="asic_hw"/>
          </type>
          <ordered-by value="user"/>
          <description>
            <text>Category of the ASIC/SDK health event to suppress</text>
          </description>
        </leaf-list>
      </list>
    </container>
  </container>
</module>
