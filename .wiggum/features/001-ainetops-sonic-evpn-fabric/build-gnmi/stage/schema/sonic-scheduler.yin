<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-scheduler"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:sch="http://github.com/sonic-net/sonic-scheduler">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-scheduler"/>
  <prefix value="sch"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SCHEDULER yang Module for SONiC OS</text>
  </description>
  <revision date="2021-04-01">
    <description>
      <text>Initial revision</text>
    </description>
  </revision>
  <container name="sonic-scheduler">
    <container name="SCHEDULER">
      <description>
        <text>Configures queue scheduling (WRR/DWRR/strict priority) and traffic shaping profiles.</text>
      </description>
      <list name="SCHEDULER_LIST">
        <key value="name"/>
        <description>
          <text>A named scheduler profile with scheduling algorithm and optional shaping parameters.</text>
        </description>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Scheduler name</text>
          </description>
        </leaf>
        <leaf name="type">
          <type name="enumeration">
            <enum name="DWRR">
              <description>
                <text>Deficit Weighted Round-Robin Scheduling</text>
              </description>
            </enum>
            <enum name="WRR">
              <description>
                <text>Weighted Round-Robin Scheduling</text>
              </description>
            </enum>
            <enum name="STRICT">
              <description>
                <text>Strict Scheduling</text>
              </description>
            </enum>
          </type>
          <default value="WRR"/>
          <description>
            <text>Scheduling algorithm type</text>
          </description>
        </leaf>
        <leaf name="weight">
          <type name="uint8">
            <range value="1..100"/>
          </type>
          <default value="1"/>
          <description>
            <text>Scheduling algorithm weight</text>
          </description>
        </leaf>
        <leaf name="priority">
          <type name="uint8">
            <range value="0..9"/>
          </type>
          <description>
            <text>Scheduler priority</text>
          </description>
        </leaf>
        <leaf name="meter_type">
          <type name="enumeration">
            <enum name="packets">
              <description>
                <text>Metering is based on packets</text>
              </description>
            </enum>
            <enum name="bytes">
              <description>
                <text>Metering is based on bytes</text>
              </description>
            </enum>
          </type>
          <default value="bytes"/>
          <description>
            <text>Metering unit for shaping rates (packets or bytes).</text>
          </description>
        </leaf>
        <leaf name="cir">
          <type name="uint64"/>
          <description>
            <text>Committed information rate for the dual-rate token
bucket policer.This value represents the rate at which
tokens are added to the primary bucket.nt Units is
Bps(Bytes per second) for meter type is bytes else
Pps(packets per second) for meter type is packets</text>
          </description>
        </leaf>
        <leaf name="pir">
          <must condition="((current()/../cir) and (current()/../cir &gt; 0))">
            <error-message>
              <value>pir can't be configured without cir.</value>
            </error-message>
          </must>
          <must condition="(current() &gt;= current()/../cir)">
            <error-message>
              <value>pir must be greater than or equal to cir</value>
            </error-message>
          </must>
          <type name="uint64"/>
          <description>
            <text>Peak information rate for the dual-rate token bucket
policer.This value represents the rate at which tokens
are added to the secondary bucket.Unit is Bps(Bytes
per second) for meter type bytes else Pps(packets per
second) for meter type is packets</text>
          </description>
        </leaf>
        <leaf name="cbs">
          <must condition="((current()/../cir) and (current()/../cir &gt; 0))">
            <error-message>
              <value>cbs can't be configured without cir.</value>
            </error-message>
          </must>
          <type name="uint32"/>
          <description>
            <text>Committed burst size for the dual-rate token bucket
policer.This value represents the depth of the token
bucket.Unit is bytes for meter type bytes else packets
for meter type is packets</text>
          </description>
        </leaf>
        <leaf name="pbs">
          <must condition="((current()/../pir) and (current()/../pir &gt; 0))">
            <error-message>
              <value>pbs can't be configured without pir.</value>
            </error-message>
          </must>
          <must condition="((not(current()/../cbs)) or (current() &gt;= current()/../cbs))">
            <error-message>
              <value>pbs must be greater than or equal to cbs</value>
            </error-message>
          </must>
          <type name="uint32"/>
          <description>
            <text>Excess burst size for the dual-rate token bucket policer.
This value represents the depth of the secondary bucket.
Unit is bytes for meter type bytes else packets for meter type
is packets</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
