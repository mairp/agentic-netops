<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-dot1p-tc-map"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:dot1ptm="http://github.com/sonic-net/sonic-dot1p-tc-map"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-dot1p-tc-map"/>
  <prefix value="dot1ptm"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>DOT1P_TO_TC_MAP yang Module for SONiC OS</text>
  </description>
  <revision date="2021-04-15">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-dot1p-tc-map">
    <container name="DOT1P_TO_TC_MAP">
      <description>
        <text>Maps 802.1p priority values (0-7) to traffic class for QoS classification.</text>
      </description>
      <list name="DOT1P_TO_TC_MAP_LIST">
        <key value="name"/>
        <description>
          <text>A named 802.1p to traffic class map.</text>
        </description>
        <leaf name="name">
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for map name.</value>
              </error-message>
              <error-app-tag value="map-name-invalid-length"/>
            </length>
          </type>
          <description>
            <text>Name of the DOT1P to TC map.</text>
          </description>
        </leaf>
        <list name="DOT1P_TO_TC_MAP">
          <key value="dot1p"/>
          <description>
            <text>Single mapping entry from a DOT1P value to a traffic class.</text>
          </description>
          <leaf name="dot1p">
            <type name="string">
              <pattern value="[0-7]?">
                <error-message>
                  <value>Invalid DOT1P</value>
                </error-message>
                <error-app-tag value="dot1p-invalid"/>
              </pattern>
            </type>
            <description>
              <text>IEEE 802.1p priority value (0-7).</text>
            </description>
          </leaf>
          <leaf name="tc">
            <type name="stypes:tc_type"/>
            <description>
              <text>Target traffic class.</text>
            </description>
          </leaf>
        </list>
      </list>
    </container>
  </container>
</module>
