<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-tc-dscp-map"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:tdm="http://github.com/sonic-net/sonic-tc-dscp-map"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-tc-dscp-map"/>
  <prefix value="tdm"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>TC_TO_DSCP_MAP yang Module for SONiC OS</text>
  </description>
  <revision date="2025-01-10">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-tc-dscp-map">
    <container name="TC_TO_DSCP_MAP">
      <description>
        <text>Maps traffic class to DSCP values for egress packet remarking.</text>
      </description>
      <list name="TC_TO_DSCP_MAP_LIST">
        <key value="name"/>
        <description>
          <text>A named traffic class to DSCP remarking map.</text>
        </description>
        <leaf name="name">
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for map name.</value>
              </error-message>
              <error-app-tag value="map-name-invalid-length"/>
            </length>
          </type>
          <description>
            <text>Name of the TC to DSCP map.</text>
          </description>
        </leaf>
        <list name="TC_TO_DSCP_MAP">
          <key value="tc"/>
          <description>
            <text>Single mapping entry from a traffic class to a DSCP value.</text>
          </description>
          <leaf name="tc">
            <type name="stypes:tc_type"/>
            <description>
              <text>Source traffic class.</text>
            </description>
          </leaf>
          <leaf name="dscp">
            <type name="string">
              <pattern value="6[0-3]|[1-5][0-9]?|[0-9]?">
                <error-message>
                  <value>Invalid DSCP</value>
                </error-message>
                <error-app-tag value="dscp-invalid"/>
              </pattern>
            </type>
            <description>
              <text>DSCP value (0-63) to remark on egress.</text>
            </description>
          </leaf>
        </list>
      </list>
    </container>
  </container>
</module>
