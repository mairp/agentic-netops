<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-event"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:sevents="http://github.com/sonic-net/sonic-event">
  <namespace uri="http://github.com/sonic-net/sonic-event"/>
  <prefix value="sevents"/>
  <yang-version value="1.1"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>This module defines operational state data for SONiC events.</text>
  </description>
  <revision date="2024-01-30">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <typedef name="severity-type">
    <type name="enumeration">
      <enum name="CRITICAL"/>
      <enum name="MAJOR"/>
      <enum name="MINOR"/>
      <enum name="WARNING"/>
      <enum name="INFORMATIONAL"/>
    </type>
    <description>
      <text>Severity of a raised condition.</text>
    </description>
  </typedef>
  <typedef name="action-type">
    <type name="enumeration">
      <enum name="RAISE"/>
      <enum name="CLEAR"/>
      <enum name="ACKNOWLEDGE"/>
      <enum name="UNACKNOWLEDGE"/>
    </type>
    <description>
      <text>Action on a raised condition.</text>
    </description>
  </typedef>
  <grouping name="event-state">
    <leaf name="id">
      <type name="string"/>
      <description>
        <text>Sequence identifier for events.</text>
      </description>
    </leaf>
    <leaf name="resource">
      <type name="string"/>
      <description>
        <text>The item in the device that raised the event.</text>
      </description>
    </leaf>
    <leaf name="text">
      <type name="string"/>
      <description>
        <text>Dynamic message raised with the event.</text>
      </description>
    </leaf>
    <leaf name="time-created">
      <type name="uint64"/>
      <description>
        <text>The time at which the event was raised by the system.
Expressed in epoch time.</text>
      </description>
    </leaf>
    <leaf name="type-id">
      <type name="string"/>
      <description>
        <text>Type of event raised by the device.</text>
      </description>
    </leaf>
    <leaf name="severity">
      <type name="severity-type"/>
      <description>
        <text>Severity of the event.</text>
      </description>
    </leaf>
    <leaf name="action">
      <type name="action-type"/>
      <description>
        <text>Action on the event.</text>
      </description>
    </leaf>
  </grouping>
  <container name="sonic-event">
    <container name="EVENT">
      <list name="EVENT_LIST">
        <key value="id"/>
        <uses name="event-state"/>
      </list>
    </container>
    <container name="EVENT_STATS">
      <list name="EVENT_STATS_LIST">
        <key value="id"/>
        <leaf name="id">
          <type name="enumeration">
            <enum name="state"/>
          </type>
          <description>
            <text>Table identifier value defined as state.</text>
          </description>
        </leaf>
        <leaf name="events">
          <type name="uint64"/>
          <description>
            <text>Total number of events in the system store.</text>
          </description>
        </leaf>
        <leaf name="raised">
          <type name="uint64"/>
          <description>
            <text>Total number of events for raise operation in system store.</text>
          </description>
        </leaf>
        <leaf name="acked">
          <type name="uint64"/>
          <description>
            <text>Total number of events for ack operation in system store.</text>
          </description>
        </leaf>
        <leaf name="cleared">
          <type name="uint64"/>
          <description>
            <text>Total number of events for clear operation in system store.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
