<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-versions"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:versions="http://github.com/sonic-net/sonic-versions">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-versions"/>
  <prefix value="versions"/>
  <description>
    <text>VERSIONS YANG Module for SONiC OS</text>
  </description>
  <revision date="2020-04-10">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-versions">
    <container name="VERSIONS">
      <description>
        <text>Database schema version tracking for config_db migrations</text>
      </description>
      <container name="DATABASE">
        <leaf name="VERSION">
          <description>
            <text>Database schema version string</text>
          </description>
          <type name="string">
            <length value="1..255"/>
            <pattern value="version_(([1-9]|[1-9]{1}[0-9]{1})_([0-9]{1,2})_([0-9]{1,2})|([1-9]{1}[0-9]{5})_([0-9]{2}))"/>
          </type>
        </leaf>
      </container>
    </container>
  </container>
</module>
