<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-exp-fc-map"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:dtm="http://github.com/sonic-net/sonic-exp-fc-map">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-exp-fc-map"/>
  <prefix value="dtm"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>EXP_TO_FC_MAP yang Module for SONiC OS</text>
  </description>
  <revision date="2021-10-29">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-exp-fc-map">
    <container name="EXP_TO_FC_MAP">
      <description>
        <text>Maps MPLS EXP bits to forwarding class for Class-Based Forwarding.</text>
      </description>
      <list name="EXP_TO_FC_MAP_LIST">
        <key value="name"/>
        <description>
          <text>A named MPLS EXP to forwarding class map.</text>
        </description>
        <leaf name="name">
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for map name.</value>
              </error-message>
              <error-app-tag value="map-name-invalid-length"/>
            </length>
          </type>
          <description>
            <text>Name of the EXP to FC map.</text>
          </description>
        </leaf>
        <list name="EXP_TO_FC_MAP">
          <key value="exp"/>
          <description>
            <text>Single mapping entry from an MPLS EXP value to a forwarding class.</text>
          </description>
          <leaf name="exp">
            <type name="string">
              <pattern value="[0-7]?">
                <error-message>
                  <value>Invalid EXP</value>
                </error-message>
                <error-app-tag value="exp-invalid"/>
              </pattern>
            </type>
            <description>
              <text>MPLS EXP bit value (0-7).</text>
            </description>
          </leaf>
          <leaf name="fc">
            <type name="string">
              <pattern value="[0-7]?">
                <error-message>
                  <value>Invalid Forwarding Class</value>
                </error-message>
                <error-app-tag value="fc-invalid"/>
              </pattern>
            </type>
            <description>
              <text>Target forwarding class (0-7) for Class-Based Forwarding.</text>
            </description>
          </leaf>
        </list>
      </list>
    </container>
  </container>
</module>
