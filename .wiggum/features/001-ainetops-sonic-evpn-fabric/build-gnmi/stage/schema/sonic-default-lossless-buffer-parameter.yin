<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-default-lossless-buffer-parameter"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:default-lossless-buffer-parameter="http://github.com/sonic-net/sonic-default-lossless-buffer-parameter">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-default-lossless-buffer-parameter"/>
  <prefix value="default-lossless-buffer-parameter"/>
  <description>
    <text>DEFAULT_LOSSLESS_BUFFER_PARAMETER YANG module for SONiC OS</text>
  </description>
  <revision date="2022-05-31">
    <description>
      <text>Initial version</text>
    </description>
  </revision>
  <container name="sonic-default-lossless-buffer-parameter">
    <container name="DEFAULT_LOSSLESS_BUFFER_PARAMETER">
      <description>
        <text>Default parameters for dynamically generated lossless buffer profiles</text>
      </description>
      <list name="DEFAULT_LOSSLESS_BUFFER_PARAMETER_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Name of the default lossless buffer parameter entry</text>
          </description>
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})">
              <error-message>
                <value>Invalid default lossless buffer parameter list name.</value>
              </error-message>
              <error-app-tag value="default-lossless-buffer-parameter-invalid-list-name"/>
            </pattern>
            <length value="1..32">
              <error-message>
                <value>Invalid length for the default lossless buffer parameter list name.</value>
              </error-message>
              <error-app-tag value="default-lossless-buffer-parameter-invalid-list-name-length"/>
            </length>
          </type>
        </leaf>
        <leaf name="default_dynamic_th">
          <type name="int8">
            <range value="-8..7">
              <error-message>
                <value>Invalid default dynamic_th which should be a number in the range [-8, 7].</value>
              </error-message>
            </range>
          </type>
          <mandatory value="true"/>
          <description>
            <text>The default dynamic_th used in lossless buffer profile generated dynamically</text>
          </description>
        </leaf>
        <leaf name="over_subscribe_ratio">
          <type name="uint16"/>
          <description>
            <text>The over subscribe ratio of shared headroom pool</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
