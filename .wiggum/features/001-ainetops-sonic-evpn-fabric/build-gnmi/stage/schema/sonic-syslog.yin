<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-syslog"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:syslog="http://github.com/sonic-net/sonic-system-syslog"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:mvrf="http://github.com/sonic-net/sonic-mgmt_vrf"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf"
        xmlns:feature="http://github.com/sonic-net/sonic-feature">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-system-syslog"/>
  <prefix value="syslog"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-mgmt_vrf">
    <prefix value="mvrf"/>
  </import>
  <import module="sonic-vrf">
    <prefix value="vrf"/>
  </import>
  <import module="sonic-feature">
    <prefix value="feature"/>
  </import>
  <description>
    <text>Remote syslog server and logging configuration YANG module for SONiC OS.</text>
  </description>
  <revision date="2022-04-18">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <typedef name="vrf-device">
    <description>
      <text>Represents syslog VRF device</text>
    </description>
    <type name="enumeration">
      <enum name="default"/>
      <enum name="mgmt"/>
    </type>
  </typedef>
  <typedef name="syslog-rate-limit-interval">
    <description>
      <text>Message rate limit interval in second</text>
    </description>
    <type name="uint32">
      <range value="0..2147483647"/>
    </type>
  </typedef>
  <typedef name="syslog-rate-limit-burst">
    <description>
      <text>Message rate limit burst in message count</text>
    </description>
    <type name="uint32">
      <range value="0..2147483647"/>
    </type>
  </typedef>
  <typedef name="log-format">
    <description>
      <text>Represents syslog log format</text>
    </description>
    <type name="enumeration">
      <enum name="welf"/>
      <enum name="standard"/>
    </type>
  </typedef>
  <typedef name="rsyslog-protocol">
    <description>
      <text>The protocol to send logs to remote server</text>
    </description>
    <type name="enumeration">
      <enum name="tcp"/>
      <enum name="udp"/>
    </type>
  </typedef>
  <typedef name="syslog-filter-type">
    <description>
      <text>The filter type</text>
    </description>
    <type name="enumeration">
      <enum name="include"/>
      <enum name="exclude"/>
    </type>
  </typedef>
  <typedef name="rsyslog-severity">
    <description>
      <text>Minimum syslog severity level for log forwarding.</text>
    </description>
    <type name="enumeration">
      <enum name="none"/>
      <enum name="debug"/>
      <enum name="info"/>
      <enum name="notice"/>
      <enum name="warn"/>
      <enum name="error"/>
      <enum name="crit"/>
    </type>
  </typedef>
  <container name="sonic-syslog">
    <container name="SYSLOG_SERVER">
      <description>
        <text>Remote syslog server destination configuration.</text>
      </description>
      <list name="SYSLOG_SERVER_LIST">
        <description>
          <text>A remote syslog server entry identified by address.</text>
        </description>
        <key value="server_address"/>
        <leaf name="server_address">
          <description>
            <text>Syslog server IP address</text>
          </description>
          <type name="inet:host"/>
        </leaf>
        <leaf name="source">
          <description>
            <text>Syslog source IP address</text>
          </description>
          <type name="inet:ip-address"/>
          <must condition="(contains(current(), '.') and contains(../server_address, '.'))&#10;or (contains(current(), ':') and contains(../server_address, ':'))"/>
        </leaf>
        <leaf name="port">
          <description>
            <text>Syslog server UDP port</text>
          </description>
          <type name="inet:port-number"/>
        </leaf>
        <leaf name="vrf">
          <description>
            <text>Syslog VRF device</text>
          </description>
          <type name="union">
            <type name="leafref">
              <path value="/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name"/>
            </type>
            <type name="vrf-device"/>
          </type>
          <must condition="(current() != 'mgmt')&#10;or (/mvrf:sonic-mgmt_vrf/mvrf:MGMT_VRF_CONFIG/mvrf:vrf_global/mvrf:mgmtVrfEnabled = 'true')"/>
        </leaf>
        <leaf name="filter">
          <description>
            <text>Syslog filter type</text>
          </description>
          <type name="syslog-filter-type"/>
        </leaf>
        <leaf name="filter_regex">
          <description>
            <text>Filter regex</text>
          </description>
          <type name="string">
            <pattern value="[^\n\r]+"/>
          </type>
        </leaf>
        <leaf name="protocol">
          <description>
            <text>The protocol to send logs to remote server</text>
          </description>
          <type name="rsyslog-protocol"/>
        </leaf>
        <leaf name="severity">
          <description>
            <text>Limit the severity to send logs to remote server</text>
          </description>
          <type name="rsyslog-severity"/>
        </leaf>
      </list>
    </container>
    <container name="SYSLOG_CONFIG">
      <description>
        <text>Global syslog daemon configuration.</text>
      </description>
      <container name="GLOBAL">
        <description>
          <text>Global syslog rate limiting, format, and severity settings.</text>
        </description>
        <leaf name="rate_limit_interval">
          <type name="syslog-rate-limit-interval"/>
          <description>
            <text>Rate limiting interval in seconds for syslog messages.</text>
          </description>
        </leaf>
        <leaf name="rate_limit_burst">
          <type name="syslog-rate-limit-burst"/>
          <description>
            <text>Maximum burst of syslog messages allowed per rate limit interval.</text>
          </description>
        </leaf>
        <leaf name="format">
          <description>
            <text>Log format</text>
          </description>
          <type name="log-format"/>
          <default value="standard"/>
        </leaf>
        <leaf name="welf_firewall_name">
          <description>
            <text>WELF format Firewall name</text>
          </description>
          <type name="string"/>
          <must condition="(../format != 'standard')"/>
        </leaf>
        <leaf name="severity">
          <type name="rsyslog-severity"/>
          <default value="notice"/>
          <description>
            <text>Minimum severity level for local syslog messages.</text>
          </description>
        </leaf>
      </container>
    </container>
    <container name="SYSLOG_CONFIG_FEATURE">
      <description>
        <text>Per-service syslog rate limiting configuration.</text>
      </description>
      <list name="SYSLOG_CONFIG_FEATURE_LIST">
        <description>
          <text>Per-service syslog rate limit entry.</text>
        </description>
        <key value="service"/>
        <leaf name="service">
          <description>
            <text>Service name</text>
          </description>
          <type name="leafref">
            <path value="/feature:sonic-feature/feature:FEATURE/feature:FEATURE_LIST/feature:name"/>
          </type>
        </leaf>
        <leaf name="rate_limit_interval">
          <type name="syslog-rate-limit-interval"/>
          <description>
            <text>Per-service rate limiting interval in seconds.</text>
          </description>
        </leaf>
        <leaf name="rate_limit_burst">
          <type name="syslog-rate-limit-burst"/>
          <description>
            <text>Per-service maximum burst of syslog messages per interval.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
