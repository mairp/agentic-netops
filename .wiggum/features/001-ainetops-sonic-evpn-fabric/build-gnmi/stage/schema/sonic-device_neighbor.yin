<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-device_neighbor"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:device_neighbor="http://github.com/sonic-net/sonic-device_neighbor"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:port="http://github.com/sonic-net/sonic-port">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-device_neighbor"/>
  <prefix value="device_neighbor"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
    <revision-date date="2019-07-01"/>
  </import>
  <description>
    <text>DEVICE_NEIGHBOR YANG Module for SONiC OS</text>
  </description>
  <revision date="2020-04-10">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-device_neighbor">
    <container name="DEVICE_NEIGHBOR">
      <description>
        <text>Directly connected neighbor devices with hostname and port mapping</text>
      </description>
      <list name="DEVICE_NEIGHBOR_LIST">
        <key value="peer_name"/>
        <leaf name="peer_name">
          <description>
            <text>Key identifying the neighbor device entry</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="name">
          <description>
            <text>Hostname of the neighbor device</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="mgmt_addr">
          <description>
            <text>Management IP address of the neighbor device</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="local_port">
          <description>
            <text>Local port connected to the neighbor device</text>
          </description>
          <type name="leafref">
            <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
          </type>
        </leaf>
        <leaf name="port">
          <description>
            <text>Port on the neighbor device connected to the local port</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="type">
          <description>
            <text>Type of the neighbor device</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
      </list>
    </container>
  </container>
</module>
