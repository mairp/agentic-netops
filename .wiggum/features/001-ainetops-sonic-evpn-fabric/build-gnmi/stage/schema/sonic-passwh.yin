<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-passwh"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:password="http://github.com/sonic-net/sonic-passwh">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-passwh"/>
  <prefix value="password"/>
  <description>
    <text>Password hardening policy YANG module for SONiC OS.</text>
  </description>
  <revision date="2022-05-03">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-passwh">
    <typedef name="feature_state">
      <type name="enumeration">
        <enum name="enabled"/>
        <enum name="disabled"/>
      </type>
    </typedef>
    <container name="PASSW_HARDENING">
      <description>
        <text>Password complexity, aging, and history policies.</text>
      </description>
      <container name="POLICIES">
        <description>
          <text>Password hardening policy settings.</text>
        </description>
        <leaf name="state">
          <description>
            <text>Enable or disable password hardening enforcement.</text>
          </description>
          <type name="feature_state"/>
          <default value="disabled"/>
        </leaf>
        <leaf name="expiration">
          <description>
            <text>Password expiration period in days; -1 disables expiration.</text>
          </description>
          <type name="int16">
            <range value="-1..365"/>
          </type>
        </leaf>
        <leaf name="expiration_warning">
          <description>
            <text>Number of days before expiration to warn the user; -1 disables the warning.</text>
          </description>
          <type name="int8">
            <range value="-1..30"/>
          </type>
        </leaf>
        <leaf name="history_cnt">
          <description>
            <text>Number of previous passwords remembered to prevent reuse.</text>
          </description>
          <type name="uint8">
            <range value="1..100"/>
          </type>
        </leaf>
        <leaf name="len_min">
          <description>
            <text>Minimum required password length in characters.</text>
          </description>
          <type name="uint8">
            <range value="1..32"/>
          </type>
        </leaf>
        <leaf name="reject_user_passw_match">
          <description>
            <text>When true, reject passwords that match the username.</text>
          </description>
          <type name="boolean"/>
        </leaf>
        <leaf name="lower_class">
          <description>
            <text>When true, require at least one lowercase letter (a-z).</text>
          </description>
          <type name="boolean"/>
        </leaf>
        <leaf name="upper_class">
          <description>
            <text>When true, require at least one uppercase letter (A-Z).</text>
          </description>
          <type name="boolean"/>
        </leaf>
        <leaf name="digits_class">
          <description>
            <text>When true, require at least one digit (0-9).</text>
          </description>
          <type name="boolean"/>
        </leaf>
        <leaf name="special_class">
          <description>
            <text>When true, require at least one special character.</text>
          </description>
          <type name="boolean"/>
        </leaf>
      </container>
    </container>
  </container>
</module>
