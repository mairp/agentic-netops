<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-feature"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:feature="http://github.com/sonic-net/sonic-feature"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-feature"/>
  <prefix value="feature"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>SONiC service/feature enable, disable, and auto-restart control YANG module.</text>
  </description>
  <typedef name="feature-state">
    <description>
      <text>configuration to set the feature running state</text>
    </description>
    <type name="string"/>
  </typedef>
  <typedef name="feature-owner">
    <description>
      <text>configuration to set if the container is controlled
by kubernetes or locally</text>
    </description>
    <type name="string">
      <pattern value="kube|local"/>
    </type>
  </typedef>
  <typedef name="feature-scope-status">
    <description>
      <text>configuration to set the feature has asic scope as true/false</text>
    </description>
    <type name="string"/>
  </typedef>
  <typedef name="feature-delay-status">
    <description>
      <text>configuration to set the feature has delay scope as True/False</text>
    </description>
    <type name="string"/>
  </typedef>
  <container name="sonic-feature">
    <container name="FEATURE">
      <description>
        <text>Per-feature runtime state and management settings.</text>
      </description>
      <list name="FEATURE_LIST">
        <key value="name"/>
        <description>
          <text>A SONiC feature/service entry keyed by name.</text>
        </description>
        <leaf name="name">
          <description>
            <text>Name of the SONiC feature or service.</text>
          </description>
          <type name="string">
            <length value="1..32"/>
          </type>
        </leaf>
        <leaf name="state">
          <description>
            <text>Administrative state of the feature (enabled, disabled, or always_enabled).</text>
          </description>
          <type name="feature-state"/>
          <default value="enabled"/>
        </leaf>
        <leaf name="auto_restart">
          <type name="feature-state"/>
          <default value="enabled"/>
          <description>
            <text>Enable or disable automatic restart of the feature on failure.</text>
          </description>
        </leaf>
        <leaf name="delayed">
          <description>
            <text>Delay starting this feature until system initialization completes.</text>
          </description>
          <type name="feature-delay-status"/>
          <default value="false"/>
        </leaf>
        <leaf name="has_global_scope">
          <description>
            <text>When true, only one instance of this service runs on the device.</text>
          </description>
          <type name="feature-scope-status"/>
          <default value="false"/>
        </leaf>
        <leaf name="has_per_asic_scope">
          <description>
            <text>When true, one instance of this service runs per ASIC.</text>
          </description>
          <type name="feature-scope-status"/>
          <default value="false"/>
        </leaf>
        <leaf name="has_per_dpu_scope">
          <description>
            <text>When true, one instance of this service runs per DPU.</text>
          </description>
          <type name="feature-scope-status"/>
          <default value="false"/>
        </leaf>
        <leaf name="high_mem_alert">
          <description>
            <text>Enable or disable alerting on high memory utilization by this feature.</text>
          </description>
          <type name="feature-state"/>
          <default value="disabled"/>
        </leaf>
        <leaf name="set_owner">
          <description>
            <text>Whether the feature container is managed by Kubernetes or locally.</text>
          </description>
          <type name="feature-owner"/>
          <default value="local"/>
        </leaf>
        <leaf name="check_up_status">
          <description>
            <text>When true, the system-ready tool monitors this feature's readiness.</text>
          </description>
          <type name="stypes:boolean_type"/>
          <default value="false"/>
        </leaf>
        <leaf name="support_syslog_rate_limit">
          <description>
            <text>When true, this feature supports per-service syslog rate limiting.</text>
          </description>
          <type name="stypes:boolean_type"/>
          <default value="false"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
