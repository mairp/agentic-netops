<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-dhcpv4-relay"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:dhcpv4relay="http://github.com/sonic-net/sonic-dhcpv4-relay"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:loopback="http://github.com/sonic-net/sonic-loopback-interface">
  <namespace uri="http://github.com/sonic-net/sonic-dhcpv4-relay"/>
  <prefix value="dhcpv4relay"/>
  <yang-version value="1.1"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <import module="sonic-vrf">
    <prefix value="vrf"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-loopback-interface">
    <prefix value="loopback"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>DHCPv4 Relay yang Module for SONiC OS</text>
  </description>
  <revision date="2024-12-30">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-dhcpv4-relay">
    <container name="DHCPV4_RELAY">
      <description>
        <text>DHCPv4 relay agent configuration per VLAN interface</text>
      </description>
      <list name="DHCPV4_RELAY_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>VLAN ID</text>
          </description>
          <type name="union">
            <type name="string">
              <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
            </type>
          </type>
        </leaf>
        <leaf-list name="dhcpv4_servers">
          <description>
            <text>Server IPv4 address list</text>
          </description>
          <min-elements value="1"/>
          <type name="inet:ipv4-address"/>
        </leaf-list>
        <leaf name="server_vrf">
          <description>
            <text>Server VRF</text>
          </description>
          <type name="leafref">
            <path value="/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name"/>
          </type>
          <must condition="(current()/../server_id_override = 'enable' and&#10; current()/../link_selection = 'enable')">
            <description>
              <text>when server_vrf is set, link_selection and server_id_override must be enabled</text>
            </description>
          </must>
          <must condition="current()/../vrf_selection = 'enable'">
            <description>
              <text>if vrf_selection is enabled, server-vrf must be set</text>
            </description>
          </must>
        </leaf>
        <leaf name="source_interface">
          <description>
            <text>Used to determine the source IP address of the relayed packet</text>
          </description>
          <type name="union">
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
            <type name="string">
              <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
            </type>
            <type name="leafref">
              <path value="/loopback:sonic-loopback-interface/loopback:LOOPBACK_INTERFACE/loopback:LOOPBACK_INTERFACE_LIST/loopback:name"/>
            </type>
          </type>
        </leaf>
        <leaf name="link_selection">
          <description>
            <text>Enable link selection</text>
          </description>
          <type name="stypes:mode-status"/>
          <default value="disable"/>
          <must condition="current() = 'disable' or current()/../source_interface != ''">
            <description>
              <text>if link_selection is enabled, source_interface must be set</text>
            </description>
          </must>
        </leaf>
        <leaf name="vrf_selection">
          <description>
            <text>Enable VRF selection</text>
          </description>
          <type name="stypes:mode-status"/>
          <default value="disable"/>
        </leaf>
        <leaf name="server_id_override">
          <description>
            <text>Enable server id override</text>
          </description>
          <type name="stypes:mode-status"/>
          <default value="disable"/>
        </leaf>
        <leaf name="agent_relay_mode">
          <description>
            <text>How to forward packets that already have a relay option</text>
          </description>
          <type name="stypes:relay-agent-mode"/>
          <default value="discard"/>
        </leaf>
        <leaf name="max_hop_count">
          <description>
            <text>Maximum hop count for relayed packets</text>
          </description>
          <type name="uint8">
            <range value="1..16"/>
          </type>
          <default value="4"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
