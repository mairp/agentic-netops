<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-debug-counter"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:dbgcnt="http://github.com/sonic-net/sonic-debug-counter"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <namespace uri="http://github.com/sonic-net/sonic-debug-counter"/>
  <prefix value="dbgcnt"/>
  <yang-version value="1.1"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONiC Debug Counter Yang Model</text>
  </description>
  <revision date="2024-03-07">
    <description>
      <text>Initial revision</text>
    </description>
  </revision>
  <container name="sonic-debug-counter">
    <container name="DEBUG_COUNTER">
      <description>
        <text>Configurable packet drop counters for debugging.</text>
      </description>
      <list name="DEBUG_COUNTER_LIST">
        <key value="name"/>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Unique name for this debug counter.</text>
          </description>
        </leaf>
        <leaf name="alias">
          <type name="string"/>
          <description>
            <text>Alias of the counter</text>
          </description>
        </leaf>
        <leaf name="desc">
          <type name="string"/>
          <description>
            <text>Description of counter (can include counter type, intended use, etc.)</text>
          </description>
        </leaf>
        <leaf name="group">
          <type name="string"/>
          <description>
            <text>Group name to organize counters</text>
          </description>
        </leaf>
        <leaf name="drop_monitor_status">
          <type name="stypes:admin_mode"/>
          <default value="disabled"/>
          <description>
            <text>Indicates whether the feature is enabled or disabled.</text>
          </description>
        </leaf>
        <leaf name="window">
          <type name="uint64"/>
          <default value="900"/>
          <units name="seconds"/>
          <description>
            <text>The length of the time window in seconds</text>
          </description>
        </leaf>
        <leaf name="incident_count_threshold">
          <type name="uint64"/>
          <default value="3"/>
          <description>
            <text>The number of incidents that have to occur per window for it to be registered as a syslog</text>
          </description>
        </leaf>
        <leaf name="drop_count_threshold">
          <type name="uint64"/>
          <default value="100"/>
          <description>
            <text>The number of packet drops required for being classified as an incident</text>
          </description>
        </leaf>
        <leaf name="type">
          <type name="stypes:debug_counter_type"/>
          <mandatory value="true"/>
          <description>
            <text>Counter type indicating scope (switch or port) and direction (ingress or egress)</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="DEBUG_COUNTER_DROP_REASON">
      <description>
        <text>Drop reasons assigned to each debug counter.</text>
      </description>
      <list name="DEBUG_COUNTER_DROP_REASON_LIST">
        <key value="name reason"/>
        <leaf name="name">
          <must condition="(current() = ../../../DEBUG_COUNTER/DEBUG_COUNTER_LIST[name=current()]/name)">
            <error-message>
              <value>The counter does not exist in the DEBUG_COUNTER table</value>
            </error-message>
          </must>
          <type name="string"/>
          <description>
            <text>Name of the debug counter this reason belongs to.</text>
          </description>
        </leaf>
        <leaf name="reason">
          <type name="stypes:counter_drop_reason"/>
          <description>
            <text>Drop reason which will cause the counter to increment</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="DEBUG_DROP_MONITOR">
      <description>
        <text>Global debug drop monitor settings.</text>
      </description>
      <container name="CONFIG">
        <description>
          <text>Global configuration for persistent drop monitoring.</text>
        </description>
        <leaf name="status">
          <type name="stypes:admin_mode"/>
          <default value="disabled"/>
          <description>
            <text>Indicates whether the feature is enabled or disabled.</text>
          </description>
        </leaf>
      </container>
    </container>
  </container>
</module>
