<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-extension"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:sonic-extension="http://github.com/sonic-net/sonic-extension">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-extension"/>
  <prefix value="sonic-extension"/>
  <description>
    <text>Extension yang Module for SONiC OS</text>
  </description>
  <revision date="2019-07-01">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <extension name="db-name">
    <description>
      <text>DB name, e.g. APPL_DB, CONFIG_DB</text>
    </description>
    <argument name="value"/>
  </extension>
</module>
