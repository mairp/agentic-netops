<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-ntp"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:ntp="http://github.com/sonic-net/sonic-system-ntp"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:mvrf="http://github.com/sonic-net/sonic-mgmt_vrf"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:lo="http://github.com/sonic-net/sonic-loopback-interface"
        xmlns:mprt="http://github.com/sonic-net/sonic-mgmt_port"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-system-ntp"/>
  <prefix value="ntp"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-mgmt_vrf">
    <prefix value="mvrf"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-loopback-interface">
    <prefix value="lo"/>
  </import>
  <import module="sonic-mgmt_port">
    <prefix value="mprt"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>Network Time Protocol (NTP) client configuration YANG module for SONiC OS.</text>
  </description>
  <revision date="2021-04-07">
    <description>
      <text>First revision</text>
    </description>
  </revision>
  <revision date="2023-03-20">
    <description>
      <text>Add extended configuration options</text>
    </description>
  </revision>
  <revision date="2025-07-21">
    <description>
      <text>Corrected NTP_KEY_LIST list name</text>
    </description>
  </revision>
  <typedef name="association-type">
    <description>
      <text>NTP server association type</text>
    </description>
    <type name="enumeration">
      <enum name="server"/>
      <enum name="pool"/>
    </type>
  </typedef>
  <typedef name="key-type">
    <description>
      <text>NTP key encryption type</text>
    </description>
    <type name="enumeration">
      <enum name="md5"/>
      <enum name="sha1"/>
      <enum name="sha256"/>
      <enum name="sha384"/>
      <enum name="sha512"/>
    </type>
  </typedef>
  <typedef name="key-id">
    <description>
      <text>NTP key ID</text>
    </description>
    <type name="uint16">
      <range value="1..65535">
        <error-message>
          <value>Failed NTP key ID</value>
        </error-message>
      </range>
    </type>
  </typedef>
  <container name="sonic-ntp">
    <container name="NTP">
      <description>
        <text>NTP global configuration container.</text>
      </description>
      <container name="global">
        <description>
          <text>Global NTP client settings.</text>
        </description>
        <leaf-list name="src_intf">
          <type name="union">
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
            <type name="leafref">
              <path value="/lo:sonic-loopback-interface/lo:LOOPBACK_INTERFACE/lo:LOOPBACK_INTERFACE_LIST/lo:name"/>
            </type>
            <type name="leafref">
              <path value="/mprt:sonic-mgmt_port/mprt:MGMT_PORT/mprt:MGMT_PORT_LIST/mprt:name"/>
            </type>
            <type name="string">
              <pattern value="eth0"/>
            </type>
          </type>
          <ordered-by value="user"/>
          <description>
            <text>This is the interface whose IP address is used as the source IP address for
generating NTP traffic. User is required to make sure that the NTP server
is reachable via this IP address and the same IP address is reachable
from the NTP server. The source interface should be in the same VRF as the
VRF NTP is enabled in.</text>
          </description>
        </leaf-list>
        <leaf name="vrf">
          <must condition="(current() != 'mgmt') or (/mvrf:sonic-mgmt_vrf/mvrf:MGMT_VRF_CONFIG/mvrf:vrf_global/mvrf:mgmtVrfEnabled = 'true')">
            <error-message>
              <value>Must condition not satisfied. Try enable Management VRF.</value>
            </error-message>
          </must>
          <type name="string">
            <pattern value="mgmt|default"/>
          </type>
          <description>
            <text>NTP can be enabled only in one VRF at a time. In this revision, it is either
default VRF or Management VRF.</text>
          </description>
        </leaf>
        <leaf name="authentication">
          <type name="stypes:admin_mode"/>
          <default value="disabled"/>
          <description>
            <text>NTP authentication state</text>
          </description>
        </leaf>
        <leaf name="dhcp">
          <type name="stypes:admin_mode"/>
          <default value="enabled"/>
          <description>
            <text>Use NTP servers distributed by DHCP</text>
          </description>
        </leaf>
        <leaf name="server_role">
          <type name="stypes:admin_mode"/>
          <default value="enabled"/>
          <description>
            <text>NTP server functionality state</text>
          </description>
        </leaf>
        <leaf name="admin_state">
          <type name="stypes:admin_mode"/>
          <default value="enabled"/>
          <description>
            <text>NTP feature state</text>
          </description>
        </leaf>
      </container>
    </container>
    <container name="NTP_SERVER">
      <description>
        <text>NTP upstream server and pool configuration.</text>
      </description>
      <list name="NTP_SERVER_LIST">
        <max-elements value="10"/>
        <description>
          <text>Number of upstream NTP servers is discussed at
https://support.ntp.org/bin/view/Support/SelectingOffsiteNTPServers
(5.3.4. Excessive Number of Upstream Time Servers).</text>
        </description>
        <key value="server_address"/>
        <leaf name="server_address">
          <type name="inet:host"/>
          <description>
            <text>Hostname or IP address of the NTP server or pool.</text>
          </description>
        </leaf>
        <leaf name="association_type">
          <type name="association-type"/>
          <default value="server"/>
          <description>
            <text>NTP remote association type: server or pool.</text>
          </description>
        </leaf>
        <leaf name="iburst">
          <type name="stypes:on-off"/>
          <default value="on"/>
          <description>
            <text>NTP aggressive polling</text>
          </description>
        </leaf>
        <leaf name="key">
          <description>
            <text>NTP server key ID</text>
          </description>
          <type name="leafref">
            <path value="/ntp:sonic-ntp/ntp:NTP_KEY/ntp:NTP_KEY_LIST/ntp:id"/>
          </type>
        </leaf>
        <leaf name="resolve_as">
          <type name="inet:host"/>
          <description>
            <text>Server resolved IP address</text>
          </description>
        </leaf>
        <leaf name="admin_state">
          <type name="stypes:admin_mode"/>
          <default value="enabled"/>
          <description>
            <text>NTP server state</text>
          </description>
        </leaf>
        <leaf name="trusted">
          <type name="stypes:yes-no"/>
          <default value="no"/>
          <description>
            <text>Trust this server. It will force time
synchronization only to this server when
authentication is enabled</text>
          </description>
        </leaf>
        <leaf name="version">
          <type name="uint8">
            <range value="3..4">
              <error-message>
                <value>Failed NTP version</value>
              </error-message>
            </range>
          </type>
          <default value="4"/>
          <description>
            <text>NTP proto version to communicate with NTP
server</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="NTP_KEY">
      <description>
        <text>NTP authentication keys inventory</text>
      </description>
      <list name="NTP_KEY_LIST">
        <description>
          <text>NTP authentication keys inventory</text>
        </description>
        <key value="id"/>
        <leaf name="id">
          <type name="key-id"/>
          <description>
            <text>NTP key ID</text>
          </description>
        </leaf>
        <leaf name="trusted">
          <type name="stypes:yes-no"/>
          <default value="no"/>
          <description>
            <text>Trust this NTP key</text>
          </description>
        </leaf>
        <leaf name="value">
          <type name="string">
            <length value="1..64"/>
          </type>
          <description>
            <text>NTP encrypted authentication key</text>
          </description>
        </leaf>
        <leaf name="type">
          <type name="key-type"/>
          <default value="md5"/>
          <description>
            <text>NTP authentication key type</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
