<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-route-map"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:rmap="http://github.com/sonic-net/sonic-route-map"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:rpolsets="http://github.com/sonic-net/sonic-routing-policy-lists"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf"
        xmlns:loopback="http://github.com/sonic-net/sonic-loopback-interface">
  <namespace uri="http://github.com/sonic-net/sonic-route-map"/>
  <prefix value="rmap"/>
  <yang-version value="1.1"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-routing-policy-sets">
    <prefix value="rpolsets"/>
  </import>
  <import module="sonic-vrf">
    <prefix value="vrf"/>
  </import>
  <import module="sonic-loopback-interface">
    <prefix value="loopback"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC Route map YANG</text>
  </description>
  <revision date="2021-02-26">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <typedef name="route-map-intf">
    <type name="union">
      <type name="leafref">
        <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
      </type>
      <type name="leafref">
        <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
      </type>
      <type name="leafref">
        <path value="/loopback:sonic-loopback-interface/loopback:LOOPBACK_INTERFACE/loopback:LOOPBACK_INTERFACE_LIST/loopback:name"/>
      </type>
      <type name="string">
        <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
      </type>
    </type>
  </typedef>
  <typedef name="bgp-origin-attr-type">
    <type name="enumeration">
      <enum name="IGP">
        <description>
          <text>Origin of the NLRI is internal</text>
        </description>
      </enum>
      <enum name="EGP">
        <description>
          <text>Origin of the NLRI is EGP</text>
        </description>
      </enum>
      <enum name="INCOMPLETE">
        <description>
          <text>Origin of the NLRI is neither IGP or EGP</text>
        </description>
      </enum>
    </type>
    <description>
      <text>Type definition for standard BGP origin attribute</text>
    </description>
    <reference>
      <text>RFC 4271 - A Border Gateway Protocol 4 (BGP-4),
Sec 4.3</text>
    </reference>
  </typedef>
  <typedef name="metric-action-type">
    <type name="enumeration">
      <enum name="METRIC_SET_VALUE">
        <description>
          <text>Set a specified metric value.</text>
        </description>
      </enum>
      <enum name="METRIC_ADD_VALUE">
        <description>
          <text>Add a specified metric value from current
set value of metric.</text>
        </description>
      </enum>
      <enum name="METRIC_SUBTRACT_VALUE">
        <description>
          <text>Subtract a specified metric value from current
set value of metric.</text>
        </description>
      </enum>
      <enum name="METRIC_SET_RTT">
        <description>
          <text>Add round trip time value as metric.</text>
        </description>
      </enum>
      <enum name="METRIC_ADD_RTT">
        <description>
          <text>Add round trip time value from current
set value of metric.</text>
        </description>
      </enum>
      <enum name="METRIC_SUBTRACT_RTT">
        <description>
          <text>Subtract round trip time value from current
set value of metric.</text>
        </description>
      </enum>
    </type>
    <description>
      <text>Type used to specify type of route metric value
to be set in a policy chain.</text>
    </description>
  </typedef>
  <container name="sonic-route-map">
    <container name="ROUTE_MAP_SET">
      <list name="ROUTE_MAP_SET_LIST">
        <key value="name"/>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Route map name</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="ROUTE_MAP">
      <list name="ROUTE_MAP_LIST">
        <key value="name stmt_name"/>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Route map name</text>
          </description>
        </leaf>
        <leaf name="stmt_name">
          <type name="uint16">
            <range value="1..65535"/>
          </type>
          <description>
            <text>Statement name, this helps to provide multiple statements
under a particular route-map</text>
          </description>
        </leaf>
        <leaf name="route_operation">
          <type name="rpolsets:routing-policy-action-type"/>
          <description>
            <text>permit/deny operation</text>
          </description>
        </leaf>
        <leaf name="match_interface">
          <type name="route-map-intf"/>
          <description>
            <text>Match based on interface</text>
          </description>
        </leaf>
        <leaf name="match_prefix_set">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:PREFIX_SET/rpolsets:PREFIX_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Match a prefix list name that contains IPv4 prefixes.</text>
          </description>
        </leaf>
        <leaf name="match_ipv6_prefix_set">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:PREFIX_SET/rpolsets:PREFIX_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Match a prefix list name that contains IPv6 prefixes.</text>
          </description>
        </leaf>
        <leaf name="match_protocol">
          <type name="string"/>
          <description>
            <text>Match based on IP protocols bgp, connected, ospf, ospf3 and static</text>
          </description>
        </leaf>
        <leaf name="match_next_hop_set">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:PREFIX_SET/rpolsets:PREFIX_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Match based on nexthop</text>
          </description>
        </leaf>
        <leaf name="match_src_vrf">
          <type name="union">
            <type name="string">
              <pattern value="default"/>
            </type>
            <type name="leafref">
              <path value="/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name"/>
            </type>
          </type>
          <description>
            <text>Match based on source VRF</text>
          </description>
        </leaf>
        <leaf-list name="match_neighbor">
          <type name="union">
            <type name="inet:ip-address"/>
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
            <type name="string">
              <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
            </type>
          </type>
          <ordered-by value="user"/>
          <description>
            <text>IP addresse or interface for match operation.</text>
          </description>
          <max-elements value="1"/>
        </leaf-list>
        <leaf-list name="match_tag">
          <type name="uint32"/>
          <ordered-by value="user"/>
          <description>
            <text>Value of the tag match member</text>
          </description>
          <max-elements value="1"/>
        </leaf-list>
        <leaf name="match_med">
          <type name="uint32"/>
          <description>
            <text>Match based on MED value</text>
          </description>
        </leaf>
        <leaf name="match_origin">
          <type name="string"/>
          <description>
            <text>Match based on BGP route origin egp, igp and incomplete</text>
          </description>
        </leaf>
        <leaf name="match_local_pref">
          <type name="uint32"/>
          <description>
            <text>Match based on BGP local preference value</text>
          </description>
        </leaf>
        <leaf name="match_community">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:COMMUNITY_SET/rpolsets:COMMUNITY_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Match based on community value</text>
          </description>
        </leaf>
        <leaf name="match_ext_community">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:EXTENDED_COMMUNITY_SET/rpolsets:EXTENDED_COMMUNITY_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Match based on extended community value</text>
          </description>
        </leaf>
        <leaf name="match_as_path">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:AS_PATH_SET/rpolsets:AS_PATH_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Match based on BGP AS-PATH</text>
          </description>
        </leaf>
        <leaf name="call_route_map">
          <type name="leafref">
            <path value="../../../ROUTE_MAP_SET/ROUTE_MAP_SET_LIST/name"/>
          </type>
          <description>
            <text>Invoke another route-map</text>
          </description>
        </leaf>
        <leaf name="set_origin">
          <type name="string"/>
          <description>
            <text>Set BGP origin value</text>
          </description>
        </leaf>
        <leaf name="set_local_pref">
          <type name="uint32"/>
          <description>
            <text>Set BGP local preference value</text>
          </description>
        </leaf>
        <leaf name="set_med">
          <type name="uint32"/>
          <description>
            <text>Set BGP MED value</text>
          </description>
        </leaf>
        <leaf name="set_metric_action">
          <type name="metric-action-type"/>
          <description>
            <text>Set metric action</text>
          </description>
        </leaf>
        <leaf name="set_metric">
          <type name="uint32"/>
          <description>
            <text>Set metric value</text>
          </description>
        </leaf>
        <leaf name="set_next_hop">
          <type name="string"/>
          <description>
            <text>Set IP nexthop</text>
          </description>
        </leaf>
        <leaf name="set_ipv6_next_hop_global">
          <type name="string"/>
          <description>
            <text>Set IPv6 global next hop</text>
          </description>
        </leaf>
        <leaf name="set_ipv6_next_hop_prefer_global">
          <type name="boolean"/>
          <description>
            <text>Set to prefer IPv6 nexthop global address</text>
          </description>
        </leaf>
        <leaf name="set_repeat_asn">
          <type name="uint8"/>
          <description>
            <text>Indicates number of times the ASN value to be repeated</text>
          </description>
        </leaf>
        <leaf name="set_asn">
          <type name="uint32"/>
          <description>
            <text>Set ASN value</text>
          </description>
        </leaf>
        <leaf name="set_asn_list">
          <type name="string"/>
          <description>
            <text>Set list of ASN values</text>
          </description>
        </leaf>
        <leaf-list name="set_community_inline">
          <type name="string"/>
          <ordered-by value="user"/>
          <description>
            <text>Set community string</text>
          </description>
        </leaf-list>
        <leaf name="set_community_ref">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:COMMUNITY_SET/rpolsets:COMMUNITY_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Refer community from community list</text>
          </description>
        </leaf>
        <leaf-list name="set_ext_community_inline">
          <type name="string"/>
          <ordered-by value="user"/>
          <description>
            <text>Set extended community string</text>
          </description>
        </leaf-list>
        <leaf name="set_ext_community_ref">
          <type name="leafref">
            <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:EXTENDED_COMMUNITY_SET/rpolsets:EXTENDED_COMMUNITY_SET_LIST/rpolsets:name"/>
          </type>
          <description>
            <text>Refer extended community from extended community list</text>
          </description>
        </leaf>
        <leaf name="set_tag">
          <type name="uint32"/>
          <description>
            <text>Value of the tag set member</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
