<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-events-dhcp-relay"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:events-dhcp-relay="http://github.com/sonic-net/sonic-events-dhcp-relay"
        xmlns:evtcmn="http://github.com/sonic-net/sonic-events-common">
  <namespace uri="http://github.com/sonic-net/sonic-events-dhcp-relay"/>
  <yang-version value="1.1"/>
  <prefix value="events-dhcp-relay"/>
  <import module="sonic-events-common">
    <prefix value="evtcmn"/>
    <revision-date date="2022-12-01"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC dhcp-relay events</text>
  </description>
  <revision date="2022-12-01">
    <description>
      <text>dhcp-relay alert events.</text>
    </description>
  </revision>
  <container name="sonic-events-dhcp-relay">
    <container name="dhcp-relay-discard">
      <evtcmn:ALARM_SEVERITY_MAJOR/>
      <description>
        <text>
Declares an event for dhcp-relay discarding packet on an
interface due to missing IP address assigned.
Params:
name of the interface discarding.</text>
      </description>
      <leaf name="ifname">
        <type name="string">
          <pattern value="[a-zA-Z0-9]+"/>
        </type>
        <description>
          <text>Name of the i/f discarding</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="dhcp-relay-disparity">
      <evtcmn:ALARM_SEVERITY_MAJOR/>
      <description>
        <text>
Declares an event for disparity detected in
DHCP Relay behavior by dhcpmon.
parameters:
vlan that shows this disparity
The duration of disparity</text>
      </description>
      <leaf name="vlan">
        <type name="string">
          <pattern value="(Agg-Vlan|Vlan)([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
        </type>
        <description>
          <text>Name of the vlan affected</text>
        </description>
      </leaf>
      <leaf name="duration">
        <type name="uint32"/>
        <description>
          <text>Duration of disparity</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="dhcp-relay-bind-failure">
      <evtcmn:ALARM_SEVERITY_MAJOR/>
      <description>
        <text>
Declares an event for socket binding failure.
parameters:
vlan that shows this failure
type either local or global</text>
      </description>
      <leaf name="vlan">
        <type name="string">
          <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
        </type>
        <description>
          <text>Name of the vlan affected</text>
        </description>
      </leaf>
      <leaf name="type">
        <type name="enumeration">
          <enum name="local"/>
          <enum name="global"/>
        </type>
        <description>
          <text>Address type</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
  </container>
</module>
