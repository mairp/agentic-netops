<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bgp-common"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bgpcmn="http://github.com/sonic-net/sonic-bgp-common"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:lointf="http://github.com/sonic-net/sonic-loopback-interface"
        xmlns:rpolsets="http://github.com/sonic-net/sonic-routing-policy-lists"
        xmlns:rmap="http://github.com/sonic-net/sonic-route-map"
        xmlns:ext="http://github.com/sonic-net/sonic-extension">
  <namespace uri="http://github.com/sonic-net/sonic-bgp-common"/>
  <prefix value="bgpcmn"/>
  <yang-version value="1.1"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-loopback-interface">
    <prefix value="lointf"/>
  </import>
  <import module="sonic-routing-policy-sets">
    <prefix value="rpolsets"/>
  </import>
  <import module="sonic-route-map">
    <prefix value="rmap"/>
  </import>
  <import module="sonic-extension">
    <prefix value="ext"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC BGP common YANG attributes for Neighbors and Peer group</text>
  </description>
  <revision date="2021-02-26">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <typedef name="bgp_peer_type">
    <type name="enumeration">
      <enum name="internal">
        <description>
          <text>Internal peer</text>
        </description>
      </enum>
      <enum name="external">
        <description>
          <text>External peer</text>
        </description>
      </enum>
    </type>
  </typedef>
  <typedef name="bgp_tx_add_paths_type">
    <type name="enumeration">
      <enum name="tx_all_paths">
        <description>
          <text>Send multiple path advertisements for an NLRI from
the neighbor or group</text>
        </description>
      </enum>
      <enum name="tx_best_path_per_as">
        <description>
          <text>Send only best path per AS advertisements for an NLRI from
the neighbor or group</text>
        </description>
      </enum>
    </type>
    <description>
      <text>Type to describe the add paths advertisement method.</text>
    </description>
  </typedef>
  <typedef name="bgp_community_type">
    <type name="enumeration">
      <enum name="standard">
        <description>
          <text>Standard communities</text>
        </description>
      </enum>
      <enum name="extended">
        <description>
          <text>Extended communities</text>
        </description>
      </enum>
      <enum name="both">
        <description>
          <text>Both standard and extended communities</text>
        </description>
      </enum>
      <enum name="large">
        <description>
          <text>Large communities</text>
        </description>
      </enum>
      <enum name="all">
        <description>
          <text>Standard, Extended and Large communities</text>
        </description>
      </enum>
      <enum name="none">
        <description>
          <text>No community attribute</text>
        </description>
      </enum>
    </type>
    <description>
      <text>type describing variations of community attributes</text>
    </description>
  </typedef>
  <typedef name="sonic_bgp_direction">
    <type name="enumeration">
      <enum name="in">
        <description>
          <text>Refers to information received from the BGP peer</text>
        </description>
      </enum>
      <enum name="out">
        <description>
          <text>Refers to information advertised to the BGP peer</text>
        </description>
      </enum>
    </type>
    <description>
      <text>Type to describe the direction</text>
    </description>
  </typedef>
  <typedef name="sonic_bgp_orf">
    <type name="enumeration">
      <enum name="send">
        <description>
          <text>Capability to receive the outbound route filtering from this neighbor</text>
        </description>
      </enum>
      <enum name="receive">
        <description>
          <text>Capability to send the outbound route filtering to this neighbor</text>
        </description>
      </enum>
      <enum name="both">
        <description>
          <text>Capability to send and receive the outbound route filtering to/from this neighbor</text>
        </description>
      </enum>
    </type>
    <description>
      <text>Type to describe the BGP ORF(Outbound route filtering) capability</text>
    </description>
  </typedef>
  <grouping name="sonic-bgp-cmn">
    <leaf name="local_asn">
      <type name="uint32">
        <range value="1..4294967295"/>
      </type>
      <description>
        <text>Local AS number</text>
      </description>
    </leaf>
    <leaf name="name">
      <type name="string"/>
      <description>
        <text>Peer description</text>
      </description>
    </leaf>
    <leaf name="asn">
      <type name="uint32">
        <range value="1..4294967295"/>
      </type>
      <description>
        <text>Peer AS number</text>
      </description>
    </leaf>
    <leaf name="peer_type">
      <type name="bgp_peer_type"/>
      <description>
        <text>BGP peer type internal/external</text>
      </description>
    </leaf>
    <leaf name="ebgp_multihop">
      <type name="boolean"/>
      <description>
        <text>Enable eBGP multihop to allow peering with non-directly-connected external neighbors.</text>
      </description>
    </leaf>
    <leaf name="ebgp_multihop_ttl">
      <type name="uint8">
        <range value="1..255"/>
      </type>
      <description>
        <text>Maximum number of hops for eBGP multihop sessions.</text>
      </description>
    </leaf>
    <leaf name="auth_password">
      <type name="string"/>
      <description>
        <text>MD5 authentication password for the BGP session.</text>
      </description>
    </leaf>
    <leaf name="keepalive">
      <type name="uint16"/>
      <description>
        <text>BGP keepalive interval in seconds.</text>
      </description>
    </leaf>
    <leaf name="holdtime">
      <type name="uint16"/>
      <description>
        <text>BGP hold time in seconds; session is reset if no keepalive is received within this period.</text>
      </description>
    </leaf>
    <leaf name="conn_retry">
      <type name="uint16">
        <range value="1..65535"/>
      </type>
      <description>
        <text>BGP connect retry timer in seconds.</text>
      </description>
    </leaf>
    <leaf name="min_adv_interval">
      <type name="uint16">
        <range value="0..600"/>
      </type>
      <description>
        <text>Minimum interval in seconds between sending BGP route updates to a peer.</text>
      </description>
    </leaf>
    <leaf name="local_addr">
      <type name="union">
        <type name="inet:ip-address"/>
        <type name="leafref">
          <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
        </type>
        <type name="leafref">
          <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
        </type>
        <type name="leafref">
          <path value="/lointf:sonic-loopback-interface/lointf:LOOPBACK_INTERFACE/lointf:LOOPBACK_INTERFACE_LIST/lointf:name"/>
        </type>
        <type name="string">
          <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
        </type>
      </type>
      <description>
        <text>Local source address or interface name to use for connection.</text>
      </description>
    </leaf>
    <leaf name="passive_mode">
      <type name="boolean"/>
      <description>
        <text>Wait for the peer to initiate the BGP session instead of actively connecting.</text>
      </description>
    </leaf>
    <leaf name="capability_ext_nexthop">
      <type name="boolean"/>
      <description>
        <text>Advertise extended nexthop capability to allow IPv4 prefixes over IPv6 nexthops.</text>
      </description>
    </leaf>
    <leaf name="disable_ebgp_connected_route_check">
      <type name="boolean"/>
      <description>
        <text>Disable the check that an eBGP peer's address must be a connected route.</text>
      </description>
    </leaf>
    <leaf name="enforce_first_as">
      <type name="boolean"/>
      <description>
        <text>Require the first AS in the AS path to be the peer's AS number for eBGP sessions.</text>
      </description>
    </leaf>
    <leaf name="solo_peer">
      <type name="boolean"/>
      <description>
        <text>Place this peer in its own update group to prevent route sharing with other peers.</text>
      </description>
    </leaf>
    <leaf name="ttl_security_hops">
      <type name="uint8">
        <range value="1..254"/>
      </type>
      <description>
        <text>Maximum number of hops expected for the BGP TTL security mechanism (GTSM).</text>
      </description>
    </leaf>
    <leaf name="bfd">
      <type name="boolean"/>
      <description>
        <text>Enable Bidirectional Forwarding Detection (BFD) for rapid link failure detection on this peer.</text>
      </description>
    </leaf>
    <leaf name="bfd_check_ctrl_plane_failure">
      <type name="boolean"/>
      <description>
        <text>Trigger BGP session reset when a BFD control plane failure is detected.</text>
      </description>
    </leaf>
    <leaf name="capability_dynamic">
      <type name="boolean"/>
      <description>
        <text>Advertise dynamic capability</text>
      </description>
    </leaf>
    <leaf name="dont_negotiate_capability">
      <type name="boolean"/>
      <description>
        <text>Do not perform capability negotiation</text>
      </description>
    </leaf>
    <leaf name="enforce_multihop">
      <type name="boolean"/>
      <description>
        <text>Enforce EBGP neighbors perform multihop</text>
      </description>
    </leaf>
    <leaf name="override_capability">
      <type name="boolean"/>
      <description>
        <text>Override capability negotiation result</text>
      </description>
    </leaf>
    <leaf name="peer_port">
      <type name="uint16"/>
      <description>
        <text>Peer port number</text>
      </description>
    </leaf>
    <leaf name="shutdown_message">
      <type name="string">
        <length value="1..127"/>
      </type>
      <description>
        <text>Human-readable message sent in the BGP NOTIFICATION when administratively shutting down the peer.</text>
      </description>
    </leaf>
    <leaf name="strict_capability_match">
      <type name="boolean"/>
      <description>
        <text>Require exact match of capabilities; tear down session if capabilities do not match.</text>
      </description>
    </leaf>
    <leaf name="admin_status">
      <type name="stypes:admin_status"/>
      <description>
        <text>Administrative status to enable or disable this BGP peer.</text>
      </description>
    </leaf>
    <leaf name="local_as_no_prepend">
      <type name="boolean"/>
      <description>
        <text>Do not prepend the local AS number to updates received from eBGP peers.</text>
      </description>
    </leaf>
    <leaf name="local_as_replace_as">
      <type name="boolean"/>
      <description>
        <text>Replace the real AS number with the local AS number in outbound updates.</text>
      </description>
    </leaf>
  </grouping>
  <grouping name="sonic-bgp-cmn-af">
    <leaf name="afi_safi">
      <type name="string"/>
      <description>
        <text>Address family</text>
      </description>
    </leaf>
    <leaf name="admin_status">
      <type name="stypes:admin_status"/>
      <description>
        <text>Indicates address family active/inactive status</text>
      </description>
    </leaf>
    <leaf name="send_default_route">
      <type name="boolean"/>
      <description>
        <text>Originate a default route to this neighbor.</text>
      </description>
    </leaf>
    <leaf name="default_rmap">
      <type name="leafref">
        <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
      </type>
      <description>
        <text>Route map applied when originating a default route to this neighbor.</text>
      </description>
    </leaf>
    <leaf name="max_prefix_limit">
      <type name="uint32"/>
      <description>
        <text>Maximum number of prefixes accepted from this neighbor before taking action.</text>
      </description>
    </leaf>
    <leaf name="max_prefix_warning_only">
      <type name="boolean"/>
      <description>
        <text>Only log a warning instead of tearing down the session when the maximum prefix limit is exceeded.</text>
      </description>
    </leaf>
    <leaf name="max_prefix_warning_threshold">
      <type name="uint8">
        <range value="1..100"/>
      </type>
      <description>
        <text>Percentage of the maximum prefix limit at which a warning is generated.</text>
      </description>
    </leaf>
    <leaf name="max_prefix_restart_interval">
      <type name="uint16">
        <range value="1..65535"/>
      </type>
      <description>
        <text>Time in seconds to wait before re-establishing the session after a max-prefix limit shutdown.</text>
      </description>
    </leaf>
    <leaf-list name="route_map_in">
      <type name="leafref">
        <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
      </type>
      <ordered-by value="user"/>
      <description>
        <text>Route-map filter for incoming routes</text>
      </description>
      <max-elements value="1"/>
    </leaf-list>
    <leaf-list name="route_map_out">
      <type name="leafref">
        <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
      </type>
      <ordered-by value="user"/>
      <description>
        <text>Route-map filter for outgoing routes</text>
      </description>
      <max-elements value="1"/>
    </leaf-list>
    <leaf name="soft_reconfiguration_in">
      <type name="boolean"/>
      <description>
        <text>Enable storing of inbound updates to allow route refresh without resetting the session.</text>
      </description>
    </leaf>
    <leaf name="unsuppress_map_name">
      <type name="leafref">
        <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
      </type>
      <description>
        <text>Route map used to selectively unsuppress suppressed routes to this neighbor.</text>
      </description>
    </leaf>
    <leaf name="rrclient">
      <type name="boolean"/>
      <description>
        <text>Configure this neighbor as a route reflector client.</text>
      </description>
    </leaf>
    <leaf name="weight">
      <type name="uint16">
        <range value="0..65535"/>
      </type>
      <description>
        <text>Default weight assigned to routes received from this neighbor for best-path selection.</text>
      </description>
    </leaf>
    <leaf name="as_override">
      <type name="boolean"/>
      <description>
        <text>Replace the peer AS number with the local AS in outbound updates to prevent loops in dual-homed networks.</text>
      </description>
    </leaf>
    <leaf name="send_community">
      <type name="bgp_community_type"/>
      <description>
        <text>Send Community attribute to this neighbor</text>
      </description>
    </leaf>
    <leaf name="tx_add_paths">
      <type name="bgp_tx_add_paths_type"/>
      <description>
        <text>Advertise all paths or best path per AS using add path</text>
      </description>
    </leaf>
    <leaf name="unchanged_as_path">
      <type name="boolean"/>
      <description>
        <text>Propagate the AS path attribute unchanged to this neighbor.</text>
      </description>
    </leaf>
    <leaf name="unchanged_med">
      <type name="boolean"/>
      <description>
        <text>Propagate the MED attribute unchanged to this neighbor.</text>
      </description>
    </leaf>
    <leaf name="unchanged_nexthop">
      <type name="boolean"/>
      <description>
        <text>Propagate the nexthop attribute unchanged to this neighbor.</text>
      </description>
    </leaf>
    <leaf name="filter_list_in">
      <type name="leafref">
        <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:AS_PATH_SET/rpolsets:AS_PATH_SET_LIST/rpolsets:name"/>
      </type>
      <description>
        <text>AS-path access list name for filtering inbound routes.</text>
      </description>
    </leaf>
    <leaf name="filter_list_out">
      <type name="leafref">
        <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:AS_PATH_SET/rpolsets:AS_PATH_SET_LIST/rpolsets:name"/>
      </type>
      <description>
        <text>AS-path access list name for filtering outbound routes.</text>
      </description>
    </leaf>
    <leaf name="nhself">
      <type name="boolean"/>
      <description>
        <text>Nexthop is self, no nexthop calculation</text>
      </description>
    </leaf>
    <leaf name="nexthop_self_force">
      <type name="boolean"/>
      <description>
        <text>Force nexthop to be self for reflected routes</text>
      </description>
    </leaf>
    <leaf name="prefix_list_in">
      <type name="leafref">
        <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:PREFIX_SET/rpolsets:PREFIX_SET_LIST/rpolsets:name"/>
      </type>
      <description>
        <text>Prefix list name for filtering inbound routes.</text>
      </description>
    </leaf>
    <leaf name="prefix_list_out">
      <type name="leafref">
        <path value="/rpolsets:sonic-routing-policy-sets/rpolsets:PREFIX_SET/rpolsets:PREFIX_SET_LIST/rpolsets:name"/>
      </type>
      <description>
        <text>Prefix list name for filtering outbound routes.</text>
      </description>
    </leaf>
    <leaf name="remove_private_as_enabled">
      <type name="boolean"/>
      <description>
        <text>Remove private AS numbers from the AS path in outbound updates.</text>
      </description>
    </leaf>
    <leaf name="replace_private_as">
      <type name="boolean"/>
      <description>
        <text>Replace private AS numbers with the local AS number in outbound updates.</text>
      </description>
    </leaf>
    <leaf name="remove_private_as_all">
      <type name="boolean"/>
      <description>
        <text>Remove all private AS numbers (including in the middle of the path) from outbound updates.</text>
      </description>
    </leaf>
    <leaf name="allow_as_in">
      <type name="boolean"/>
      <description>
        <text>Accept inbound routes even when the local AS number appears in the AS path.</text>
      </description>
    </leaf>
    <leaf name="allow_as_count">
      <type name="uint8"/>
      <description>
        <text>Maximum number of times the local AS number may appear in a received AS path.</text>
      </description>
    </leaf>
    <leaf name="allow_as_origin">
      <type name="boolean"/>
      <description>
        <text>Accept routes that originated from the local AS.</text>
      </description>
    </leaf>
    <leaf name="cap_orf">
      <type name="sonic_bgp_orf"/>
      <description>
        <text>Outbound Route Filtering (ORF) prefix-list capability to negotiate with this neighbor.</text>
      </description>
    </leaf>
    <leaf name="route_server_client">
      <type name="boolean"/>
      <description>
        <text>Configure this neighbor as a route server client, disabling attribute modification.</text>
      </description>
    </leaf>
  </grouping>
  <grouping name="sonic-bgp-cmn-neigh">
    <leaf name="asn">
      <type name="uint32">
        <range value="0..4294967295"/>
      </type>
      <description>
        <text>Peer AS number.</text>
      </description>
    </leaf>
    <leaf name="holdtime">
      <type name="uint16"/>
      <description>
        <text>BGP hold time in seconds; session is reset if no keepalive is received within this period.</text>
      </description>
    </leaf>
    <leaf name="keepalive">
      <type name="uint16"/>
      <description>
        <text>BGP keepalive interval in seconds.</text>
      </description>
    </leaf>
    <leaf name="local_addr">
      <type name="inet:ip-address"/>
      <description>
        <text>Local source address to use for the BGP session.</text>
      </description>
    </leaf>
    <leaf name="name">
      <type name="string"/>
      <description>
        <text>Human-readable description text for this BGP peer.</text>
      </description>
    </leaf>
    <leaf name="nhopself">
      <type name="uint8">
        <range value="0..1"/>
      </type>
      <description>
        <text>Set nexthop to self for routes advertised to this peer.</text>
      </description>
    </leaf>
    <leaf name="rrclient">
      <type name="uint8">
        <range value="0..1"/>
      </type>
      <description>
        <text>Configure this neighbor as a route reflector client.</text>
      </description>
    </leaf>
    <leaf name="admin_status">
      <type name="stypes:admin_status"/>
      <description>
        <text>Administrative status to enable or disable this BGP peer.</text>
      </description>
    </leaf>
  </grouping>
</module>
