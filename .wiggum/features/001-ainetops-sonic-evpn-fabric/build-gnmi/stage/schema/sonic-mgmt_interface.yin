<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-mgmt_interface"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:mgmtintf="http://github.com/sonic-net/sonic-mgmt_interface"
        xmlns:mgmtprt="http://github.com/sonic-net/sonic-mgmt_port"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-mgmt_interface"/>
  <prefix value="mgmtintf"/>
  <import module="sonic-mgmt_port">
    <prefix value="mgmtprt"/>
  </import>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>Out-of-band management interface (eth0) IP addressing and gateway configuration</text>
  </description>
  <revision date="2021-04-07">
    <description>
      <text>First revision</text>
    </description>
  </revision>
  <container name="sonic-mgmt_interface">
    <container name="MGMT_INTERFACE">
      <description>
        <text>Management interface IP address and gateway configuration table</text>
      </description>
      <list name="MGMT_INTERFACE_LIST">
        <description>
          <text>IP address and gateway configuration for a management interface</text>
        </description>
        <key value="name ip_prefix"/>
        <leaf name="name">
          <description>
            <text>Reference to the management port (e.g. eth0)</text>
          </description>
          <type name="leafref">
            <path value="/mgmtprt:sonic-mgmt_port/mgmtprt:MGMT_PORT/mgmtprt:MGMT_PORT_LIST/mgmtprt:name"/>
          </type>
        </leaf>
        <leaf name="ip_prefix">
          <description>
            <text>IPv4 or IPv6 address with prefix length for the management interface</text>
          </description>
          <must condition="(contains(current(), ':') and contains(../gwaddr, ':')) or (contains(current(), '.') and contains(../gwaddr, '.'))"/>
          <type name="stypes:sonic-ip-prefix"/>
        </leaf>
        <leaf name="gwaddr">
          <description>
            <text>Default gateway IP address for the management interface</text>
          </description>
          <must condition="(contains(current(), ':') and contains(../ip_prefix, ':')) or (contains(current(), '.') and contains(../ip_prefix, '.'))"/>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf-list name="forced_mgmt_routes">
          <type name="union">
            <type name="stypes:sonic-ip-prefix"/>
            <type name="inet:ip-address"/>
          </type>
          <ordered-by value="user"/>
          <description>
            <text>This configuration allows addtional routes to be added to default VRF table
or mgmt VRF table, based on if Management VRF is configured.
Details can be found in interfaces.j2.</text>
          </description>
        </leaf-list>
      </list>
    </container>
  </container>
</module>
