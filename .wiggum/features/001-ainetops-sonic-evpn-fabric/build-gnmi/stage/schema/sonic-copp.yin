<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-copp"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:copp="http://github.com/sonic-net/sonic-copp"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-copp"/>
  <prefix value="copp"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>CoPP YANG Module for SONiC OS</text>
  </description>
  <revision date="2021-03-31">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-copp">
    <container name="COPP_GROUP">
      <description>
        <text>Configures Control Plane Policing groups that rate-limit traffic destined to the CPU.</text>
      </description>
      <list name="COPP_GROUP_LIST">
        <description>
          <text>A named CoPP group with queue, trap action, and policer settings.</text>
        </description>
        <key value="name"/>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Control plane policing group name</text>
          </description>
        </leaf>
        <leaf name="queue">
          <type name="uint32"/>
          <default value="0"/>
          <description>
            <text>CPU receive queue number; higher values indicate higher priority.</text>
          </description>
        </leaf>
        <leaf name="trap_priority">
          <type name="uint32"/>
          <default value="0"/>
          <description>
            <text>Priority assigned to the trap; higher values are matched first.</text>
          </description>
        </leaf>
        <leaf name="trap_action">
          <mandatory value="true"/>
          <type name="stypes:policer_packet_action"/>
          <description>
            <text>Action applied to trapped packets (forward, drop, copy, etc.).</text>
          </description>
        </leaf>
        <leaf name="meter_type">
          <mandatory value="true"/>
          <type name="stypes:meter_type"/>
          <description>
            <text>Metering unit for the embedded policer (packets or bytes).</text>
          </description>
        </leaf>
        <leaf name="mode">
          <mandatory value="true"/>
          <type name="enumeration">
            <enum name="sr_tcm"/>
            <enum name="tr_tcm"/>
            <enum name="storm"/>
          </type>
          <description>
            <text>Policer mode: single-rate TCM, two-rate TCM, or storm control.</text>
          </description>
        </leaf>
        <leaf name="color">
          <type name="stypes:policer_color_source"/>
          <description>
            <text>Policer color awareness mode (aware or blind).</text>
          </description>
        </leaf>
        <leaf name="cir">
          <type name="uint64"/>
          <default value="0"/>
          <description>
            <text>Committed information rate for the dual-rate token
 					bucket policer.  This value represents the rate at which
 					tokens are added to the primary bucket.</text>
          </description>
        </leaf>
        <leaf name="cbs">
          <must condition="((current()/../cir) and (current()/../cir &gt; 0))">
            <error-message>
              <value>cbs can't be configured without cir.</value>
            </error-message>
          </must>
          <must condition="(current() &gt;= current()/../cir)">
            <error-message>
              <value>cbs must be greater than or equal to cir</value>
            </error-message>
          </must>
          <type name="uint64"/>
          <default value="0"/>
          <description>
            <text>Committed burst size for the dual-rate token bucket
 					policer.  This value represents the depth of the token
 					bucket.</text>
          </description>
        </leaf>
        <leaf name="pir">
          <when condition="current()/../mode = 'tr_tcm'"/>
          <must condition="((current()/../cir) and (current()/../cir &gt; 0))">
            <error-message>
              <value>pir can't be configured without cir.</value>
            </error-message>
          </must>
          <must condition="(current() &gt;= current()/../cir)">
            <error-message>
              <value>pir must be greater than or equal to cir</value>
            </error-message>
          </must>
          <type name="uint64"/>
          <description>
            <text>Peak information rate for the dual-rate token bucket
 					policer.  This value represents the rate at which tokens
 					are added to the secondary bucket.</text>
          </description>
        </leaf>
        <leaf name="pbs">
          <when condition="((current()/../mode = 'sr_tcm') or (current()/../mode = 'tr_tcm'))"/>
          <must condition="((not(current()/../cbs)) or (current() &gt;= current()/../cbs))">
            <error-message>
              <value>pbs must be greater than or equal to cbs</value>
            </error-message>
          </must>
          <type name="uint64"/>
          <description>
            <text>Excess burst size for the dual-rate token bucket policer.
 					This value represents the depth of the secondary bucket.</text>
          </description>
        </leaf>
        <leaf name="green_action">
          <type name="stypes:policer_packet_action"/>
          <default value="forward"/>
          <description>
            <text>Action for packets classified as green by the policer.</text>
          </description>
        </leaf>
        <leaf name="yellow_action">
          <when condition="((current()/../mode = 'sr_tcm') or (current()/../mode = 'tr_tcm'))"/>
          <type name="stypes:policer_packet_action"/>
          <default value="forward"/>
          <description>
            <text>Action for packets classified as yellow by the policer.</text>
          </description>
        </leaf>
        <leaf name="red_action">
          <type name="stypes:policer_packet_action"/>
          <default value="forward"/>
          <description>
            <text>Action for packets classified as red by the policer.</text>
          </description>
        </leaf>
      </list>
    </container>
    <container name="COPP_TRAP">
      <description>
        <text>Configures CoPP trap entries that bind trap IDs to CoPP groups.</text>
      </description>
      <list name="COPP_TRAP_LIST">
        <description>
          <text>A named CoPP trap binding trap IDs to a policing group.</text>
        </description>
        <key value="name"/>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Control plane policing trap name</text>
          </description>
        </leaf>
        <leaf name="trap_ids">
          <mandatory value="true"/>
          <type name="string"/>
          <description>
            <text>Comma-separated list of trap identifiers bound to this entry.</text>
          </description>
        </leaf>
        <leaf name="trap_group">
          <type name="leafref">
            <path value="/sonic-copp/COPP_GROUP/COPP_GROUP_LIST/name"/>
          </type>
          <description>
            <text>Reference to the CoPP group that polices these traps.</text>
          </description>
        </leaf>
        <leaf name="always_enabled">
          <type name="boolean"/>
          <description>
            <text>When true, the trap is always installed regardless of feature enablement.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
  <rpc name="get-match-protocols">
    <description>
      <text>RPC to get allowed match protocols</text>
    </description>
    <output>
      <list name="Match_protocols">
        <key value="Protocol"/>
        <leaf name="Protocol">
          <type name="string"/>
          <description>
            <text>Protocol name</text>
          </description>
        </leaf>
      </list>
    </output>
  </rpc>
</module>
