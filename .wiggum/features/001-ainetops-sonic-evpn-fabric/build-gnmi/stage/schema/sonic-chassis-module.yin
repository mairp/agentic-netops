<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-chassis-module"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:chassis_mod="http://github.com/sonic-net/sonic-chassis-module"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-chassis-module"/>
  <prefix value="chassis_mod"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>CHASSIS_MODULE YANG to administratively set SONIC modules state</text>
  </description>
  <revision date="2026-04-17">
    <description>
      <text>Add SWITCH-HOST to name pattern; add power_on_delay and graceful_shutdown_timeout leaves for BMC support</text>
    </description>
  </revision>
  <revision date="2023-02-24">
    <description>
      <text>Initial version</text>
    </description>
  </revision>
  <container name="sonic-chassis-module">
    <container name="CHASSIS_MODULE">
      <description>
        <text>List of modules in the chassis</text>
      </description>
      <list name="CHASSIS_MODULE_LIST">
        <key value="name"/>
        <leaf name="name">
          <type name="string">
            <pattern value="LINE-CARD[0-9]+|FABRIC-CARD[0-9]+|DPU[0-9]+|SWITCH-HOST"/>
          </type>
          <description>
            <text>Line-card, fabric-card, dpu, or switch-host module name</text>
          </description>
        </leaf>
        <leaf name="admin_status">
          <type name="stypes:admin_status"/>
          <default value="up"/>
          <description>
            <text>Administrative state of chassis module</text>
          </description>
        </leaf>
        <leaf name="power_on_delay">
          <type name="uint32"/>
          <must condition="current()/../name = 'SWITCH-HOST'">
            <error-message>
              <value>power_on_delay is only applicable to SWITCH-HOST</value>
            </error-message>
          </must>
          <description>
            <text>Time in seconds BMC waits before powering on Switch-Host when device is powered ON. Applicable only to SWITCH-HOST.</text>
          </description>
        </leaf>
        <leaf name="graceful_shutdown_timeout">
          <type name="uint32"/>
          <must condition="current()/../name = 'SWITCH-HOST'">
            <error-message>
              <value>graceful_shutdown_timeout is only applicable to SWITCH-HOST</value>
            </error-message>
          </must>
          <description>
            <text>Time in seconds BMC waits for graceful shutdown before forcing power-off. Set to 0 to skip graceful shutdown and power off immediately. Applicable only to SWITCH-HOST.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
