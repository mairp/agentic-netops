<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-restapi"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:restapi="http://github.com/sonic-net/sonic-restapi">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-restapi"/>
  <prefix value="restapi"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>RESTAPI YANG Module for SONiC OS</text>
  </description>
  <revision date="2022-10-05">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-restapi">
    <container name="RESTAPI">
      <description>
        <text>REST API server certificate and connection configuration</text>
      </description>
      <container name="certs">
        <description>
          <text>TLS certificate paths for the REST API server</text>
        </description>
        <leaf name="ca_crt">
          <type name="string">
            <pattern value="(/[a-zA-Z0-9_-]+)*/([a-zA-Z0-9_-]+).([a-z]+)"/>
          </type>
          <description>
            <text>Local path for ca_crt.</text>
          </description>
        </leaf>
        <leaf name="server_crt">
          <type name="string">
            <pattern value="(/[a-zA-Z0-9_-]+)*/([a-zA-Z0-9_-]+).crt"/>
          </type>
          <description>
            <text>Local path for server_crt.</text>
          </description>
        </leaf>
        <leaf name="client_crt_cname">
          <type name="string">
            <pattern value="((\*\.)?[a-zA-Z0-9_\-\.]+,)*((\*\.)?[a-zA-Z0-9_\-\.]+)"/>
          </type>
          <description>
            <text>Client cert name.</text>
          </description>
        </leaf>
        <leaf name="server_key">
          <type name="string">
            <pattern value="(/[a-zA-Z0-9_-]+)*/([a-zA-Z0-9_-]+).key"/>
          </type>
          <description>
            <text>Local path for server_key.</text>
          </description>
        </leaf>
      </container>
      <container name="config">
        <description>
          <text>REST API server runtime configuration</text>
        </description>
        <leaf name="client_auth">
          <type name="boolean"/>
          <default value="true"/>
          <description>
            <text>Enable client authentication</text>
          </description>
        </leaf>
        <leaf name="log_level">
          <type name="string">
            <pattern value="trace|info"/>
          </type>
          <description>
            <text>container log level for restapi</text>
          </description>
        </leaf>
        <leaf name="allow_insecure">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Allow insecure connection</text>
          </description>
        </leaf>
      </container>
    </container>
  </container>
</module>
