<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-system-radius"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:ssys="http://github.com/sonic-net/sonic-system-radius"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:loopback="http://github.com/sonic-net/sonic-loopback-interface"
        xmlns:mgmt-port="http://github.com/sonic-net/sonic-mgmt_port">
  <namespace uri="http://github.com/sonic-net/sonic-system-radius"/>
  <prefix value="ssys"/>
  <yang-version value="1.1"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-loopback-interface">
    <prefix value="loopback"/>
  </import>
  <import module="sonic-mgmt_port">
    <prefix value="mgmt-port"/>
  </import>
  <description>
    <text>Remote Authentication Dial-In User Service (RADIUS) YANG module for SONiC OS.</text>
  </description>
  <revision date="2022-11-11">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <typedef name="auth_type_enumeration">
    <type name="enumeration">
      <enum name="pap"/>
      <enum name="chap"/>
      <enum name="mschapv2"/>
    </type>
  </typedef>
  <container name="sonic-system-radius">
    <container name="RADIUS">
      <description>
        <text>Global RADIUS client configuration.</text>
      </description>
      <container name="global">
        <description>
          <text>Global RADIUS authentication settings applied to all servers.</text>
        </description>
        <leaf name="passkey">
          <type name="string">
            <length value="1..65"/>
            <pattern value="[^ #,]*">
              <error-message>
                <value>RADIUS shared secret (Valid chars are ASCII printable except SPACE, "#", and ",")</value>
              </error-message>
            </pattern>
          </type>
          <description>
            <text>Default shared secret for authenticating RADIUS server communication.</text>
          </description>
        </leaf>
        <leaf name="auth_type">
          <default value="pap"/>
          <type name="auth_type_enumeration"/>
          <description>
            <text>Default authentication protocol (pap, chap, or mschapv2) for RADIUS communication.</text>
          </description>
        </leaf>
        <leaf name="src_ip">
          <type name="inet:ip-address"/>
          <description>
            <text>Source IP address (IPv4 or IPv6) used for outgoing RADIUS packets.</text>
          </description>
        </leaf>
        <leaf name="nas_ip">
          <type name="inet:ip-address"/>
          <description>
            <text>NAS-IP-Address or NAS-IPv6-Address attribute sent in outgoing RADIUS packets.</text>
          </description>
        </leaf>
        <leaf name="statistics">
          <type name="boolean"/>
          <description>
            <text>Enable or disable RADIUS server statistics collection.</text>
          </description>
        </leaf>
        <leaf name="timeout">
          <default value="5"/>
          <type name="uint16">
            <range value="1..60">
              <error-message>
                <value>RADIUS timeout must be 1..60</value>
              </error-message>
            </range>
          </type>
          <description>
            <text>Default timeout in seconds for RADIUS server responses.</text>
          </description>
        </leaf>
        <leaf name="retransmit">
          <default value="3"/>
          <type name="uint8">
            <range value="0..10">
              <error-message>
                <value>RADIUS retransmit must be 0..10</value>
              </error-message>
            </range>
          </type>
          <description>
            <text>Default number of times to retransmit a RADIUS request before giving up.</text>
          </description>
        </leaf>
      </container>
    </container>
    <container name="RADIUS_SERVER">
      <description>
        <text>Per-server RADIUS configuration entries.</text>
      </description>
      <list name="RADIUS_SERVER_LIST">
        <key value="ipaddress"/>
        <description>
          <text>A RADIUS server entry identified by hostname or IP address.</text>
        </description>
        <max-elements value="8"/>
        <leaf name="ipaddress">
          <type name="inet:host"/>
          <description>
            <text>RADIUS server's Domain name or IP address (IPv4 or IPv6)</text>
          </description>
        </leaf>
        <leaf name="auth_port">
          <default value="1812"/>
          <type name="inet:port-number"/>
          <description>
            <text>RADIUS authentication port number.</text>
          </description>
        </leaf>
        <leaf name="passkey">
          <type name="string">
            <length value="1..65"/>
            <pattern value="[^ #,]*">
              <error-message>
                <value>RADIUS shared secret (Valid chars are ASCII printable except SPACE, "#", and ",")</value>
              </error-message>
            </pattern>
          </type>
          <description>
            <text>Per-server shared secret overriding the global passkey.</text>
          </description>
        </leaf>
        <leaf name="auth_type">
          <default value="pap"/>
          <type name="auth_type_enumeration"/>
          <description>
            <text>Per-server authentication protocol overriding the global auth_type.</text>
          </description>
        </leaf>
        <leaf name="priority">
          <type name="uint8">
            <range value="1..64">
              <error-message>
                <value>RADIUS priority must be 1..64</value>
              </error-message>
            </range>
          </type>
          <description>
            <text>Server selection priority; higher values are tried first.</text>
          </description>
        </leaf>
        <leaf name="timeout">
          <default value="5"/>
          <type name="uint16">
            <range value="1..60">
              <error-message>
                <value>RADIUS timeout must be 1..60</value>
              </error-message>
            </range>
          </type>
          <description>
            <text>Per-server response timeout in seconds.</text>
          </description>
        </leaf>
        <leaf name="retransmit">
          <default value="3"/>
          <type name="uint8">
            <range value="0..10">
              <error-message>
                <value>RADIUS retransmit must be 0..10</value>
              </error-message>
            </range>
          </type>
          <description>
            <text>Per-server number of retransmit attempts before failing over.</text>
          </description>
        </leaf>
        <leaf name="vrf">
          <type name="string">
            <pattern value="mgmt|default">
              <error-message>
                <value>Error: Invalid VRF name</value>
              </error-message>
            </pattern>
          </type>
          <description>
            <text>VRF used to reach this RADIUS server (mgmt or default).</text>
          </description>
        </leaf>
        <leaf name="src_intf">
          <type name="union">
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
            <type name="string">
              <pattern value="Vlan([0-9]{1,3}|[1-3][0-9]{3}|[4][0][0-8][0-9]|[4][0][9][0-4])"/>
            </type>
            <type name="leafref">
              <path value="/loopback:sonic-loopback-interface/loopback:LOOPBACK_INTERFACE/loopback:LOOPBACK_INTERFACE_LIST/loopback:name"/>
            </type>
            <type name="leafref">
              <path value="/mgmt-port:sonic-mgmt_port/mgmt-port:MGMT_PORT/mgmt-port:MGMT_PORT_LIST/mgmt-port:name"/>
            </type>
          </type>
          <description>
            <text>Source interface to use for RADIUS server communication.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
