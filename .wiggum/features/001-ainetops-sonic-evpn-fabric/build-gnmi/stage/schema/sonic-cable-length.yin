<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-cable-length"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:cable-length="http://github.com/sonic-net/sonic-cable-length"
        xmlns:port="http://github.com/sonic-net/sonic-port">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-cable-length"/>
  <prefix value="cable-length"/>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <description>
    <text>CABLE_LENGTH YANG module for SONiC OS</text>
  </description>
  <revision date="2021-11-11">
    <description>
      <text>Initial version</text>
    </description>
  </revision>
  <container name="sonic-cable-length">
    <container name="CABLE_LENGTH">
      <description>
        <text>Cable length per port, used for lossless buffer calculation</text>
      </description>
      <list name="CABLE_LENGTH_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Name of the cable length configuration group</text>
          </description>
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})">
              <error-message>
                <value>Invalid cable length list name.</value>
              </error-message>
              <error-app-tag value="cable-length-invalid-list-name"/>
            </pattern>
            <length value="1..32">
              <error-message>
                <value>Invalid length for the cable length list name.</value>
              </error-message>
              <error-app-tag value="cable-length-invalid-list-name-length"/>
            </length>
          </type>
        </leaf>
        <list name="CABLE_LENGTH">
          <key value="port"/>
          <leaf name="port">
            <description>
              <text>Port associated with this cable length entry</text>
            </description>
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
          </leaf>
          <leaf name="length">
            <description>
              <text>Cable length in meters (e.g., '40m')</text>
            </description>
            <type name="string">
              <pattern value="[0-9]+m">
                <error-message>
                  <value>Invalid cable length.</value>
                </error-message>
                <error-app-tag value="cable-length-invalid-length"/>
              </pattern>
            </type>
          </leaf>
        </list>
      </list>
    </container>
  </container>
</module>
