<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-events-common"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:evtcmn="http://github.com/sonic-net/sonic-events-common"
        xmlns:yang="urn:ietf:params:xml:ns:yang:ietf-yang-types">
  <namespace uri="http://github.com/sonic-net/sonic-events-common"/>
  <prefix value="evtcmn"/>
  <yang-version value="1.1"/>
  <import module="ietf-yang-types">
    <prefix value="yang"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC Events common definition</text>
  </description>
  <revision date="2022-12-01">
    <description>
      <text>Common reusable definitions</text>
    </description>
  </revision>
  <typedef name="action-type">
    <type name="enumeration">
      <enum name="RAISE">
        <description>
          <text>Event with raise alarm action.</text>
        </description>
      </enum>
      <enum name="CLEAR">
        <description>
          <text>Event with clear alarm action.</text>
        </description>
      </enum>
    </type>
    <description>
      <text>This type defines the actions associated with an event notification.</text>
    </description>
  </typedef>
  <grouping name="sonic-events-cmn">
    <leaf name="timestamp">
      <type name="yang:date-and-time"/>
      <description>
        <text>time of the event</text>
      </description>
    </leaf>
    <leaf name="type-id">
      <type name="string"/>
      <description>
        <text>The abbreviated name of the event, for example FAN_SPEED_STATUS,
SYSTEM_STATUS, or PSU_FAULTY.</text>
      </description>
    </leaf>
    <leaf name="resource">
      <type name="string"/>
      <description>
        <text>The item generating the event. for example eth1, cpu_sensor</text>
      </description>
    </leaf>
    <leaf name="text">
      <type name="string"/>
      <description>
        <text>The string used to inform operators about the event. This
MUST contain enough information for an operator to be able
to understand the problem. If this string contains structure,
this format should be clearly documented for programs to be
able to parse that information</text>
      </description>
    </leaf>
    <leaf name="action">
      <type name="action-type"/>
      <description>
        <text>This denotes the action associated with the event.</text>
      </description>
    </leaf>
  </grouping>
  <grouping name="sonic-events-usage">
    <leaf name="usage">
      <type name="decimal64">
        <fraction-digits value="1"/>
      </type>
      <description>
        <text>Percentage in use</text>
      </description>
    </leaf>
    <leaf name="limit">
      <type name="decimal64">
        <fraction-digits value="1"/>
      </type>
      <description>
        <text>Percentage limit set</text>
      </description>
    </leaf>
  </grouping>
  <extension name="EVENT_SEVERITY_2">
    <description>
      <text>Indicates that the severity level of this type of event is 2</text>
    </description>
  </extension>
  <extension name="EVENT_SEVERITY_3">
    <description>
      <text>Indicates that the severity level of this type of event is 3</text>
    </description>
  </extension>
  <extension name="EVENT_SEVERITY_4">
    <description>
      <text>Indicates that the severity level of this type of event is 4</text>
    </description>
  </extension>
  <extension name="ALARM_SEVERITY_MINOR">
    <description>
      <text>Indicates the existence of a non-service affecting fault condition
and that corrective action should be taken in order to prevent a more serious
(for example, service affecting) fault. Such a severity can be reported,
for example, when the detected alarm condition is not currently degrading the capacity of the resource</text>
    </description>
  </extension>
  <extension name="ALARM_SEVERITY_MAJOR">
    <description>
      <text>Indicates that a service affecting condition has developed and an urgent corrective
action is required. Such a severity can be reported, for example, when there is a severe
degradation in the capability of the resource and its full capability must be restored.</text>
    </description>
  </extension>
</module>
