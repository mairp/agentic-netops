<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-warm-restart"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:wrm="http://github.com/sonic-net/sonic-warm-restart">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-warm-restart"/>
  <prefix value="wrm"/>
  <description>
    <text>Warm restart configuration per module for hitless software upgrades</text>
  </description>
  <revision date="2021-05-24">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <typedef name="module-name">
    <type name="enumeration">
      <enum name="bgp">
        <description>
          <text>BGP module</text>
        </description>
      </enum>
      <enum name="teamd">
        <description>
          <text>Teamd module</text>
        </description>
      </enum>
      <enum name="swss">
        <description>
          <text>Switch State Services module</text>
        </description>
      </enum>
      <enum name="system">
        <description>
          <text>Warm Restart on a System level.</text>
        </description>
      </enum>
    </type>
    <description>
      <text>The modules supported in warm-restart</text>
    </description>
  </typedef>
  <container name="sonic-warm-restart">
    <container name="WARM_RESTART">
      <list name="WARM_RESTART_LIST">
        <key value="module"/>
        <leaf name="module">
          <type name="module-name"/>
          <description>
            <text>Name of the module</text>
          </description>
        </leaf>
        <leaf name="bgp_eoiu">
          <type name="boolean"/>
          <must condition="current()/../module = 'bgp'">
            <error-message>
              <value>bgp_eoiu is only supported for module bgp.</value>
            </error-message>
          </must>
          <description>
            <text>BGP End-of-Initial Update (EOIU) signal enable/disable</text>
          </description>
        </leaf>
        <leaf name="bgp_timer">
          <type name="uint16">
            <range value="1..3600">
              <error-message>
                <value>Timer must be 1..3600</value>
              </error-message>
              <error-app-tag value="timer-invalid"/>
            </range>
          </type>
          <must condition="current()/../module = 'bgp'">
            <error-message>
              <value>bgp_timer is only supported for module bgp.</value>
            </error-message>
          </must>
          <description>
            <text>Timer value for BGP module</text>
          </description>
        </leaf>
        <leaf name="teamsyncd_timer">
          <type name="uint16">
            <range value="1..3600">
              <error-message>
                <value>Timer must be 1..3600</value>
              </error-message>
              <error-app-tag value="timer-invalid"/>
            </range>
          </type>
          <must condition="current()/../module = 'teamd'">
            <error-message>
              <value>teamsyncd_timer is only supported for module teamd.</value>
            </error-message>
          </must>
          <description>
            <text>Timer value for teamd module</text>
          </description>
        </leaf>
        <leaf name="neighsyncd_timer">
          <type name="uint16">
            <range value="1..9999">
              <error-message>
                <value>Timer must be 1..9999</value>
              </error-message>
              <error-app-tag value="timer-invalid"/>
            </range>
          </type>
          <must condition="current()/../module = 'swss'">
            <error-message>
              <value>neighsyncd_timer is only supported for module swss.</value>
            </error-message>
          </must>
          <description>
            <text>Timer value for swss module</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
