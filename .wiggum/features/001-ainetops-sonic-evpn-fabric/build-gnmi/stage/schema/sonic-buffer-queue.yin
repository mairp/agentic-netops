<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-buffer-queue"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bqueue="http://github.com/sonic-net/sonic-buffer-queue"
        xmlns:prt="http://github.com/sonic-net/sonic-port"
        xmlns:bpf="http://github.com/sonic-net/sonic-buffer-profile"
        xmlns:sdm="http://github.com/sonic-net/sonic-device_metadata"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <namespace uri="http://github.com/sonic-net/sonic-buffer-queue"/>
  <prefix value="bqueue"/>
  <import module="sonic-port">
    <prefix value="prt"/>
  </import>
  <import module="sonic-buffer-profile">
    <prefix value="bpf"/>
  </import>
  <import module="sonic-device_metadata">
    <prefix value="sdm"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>Egress queue buffer configuration per port.</text>
  </description>
  <revision date="2021-07-01">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-buffer-queue">
    <container name="BUFFER_QUEUE">
      <description>
        <text>Configures buffer profiles for egress queues on ports.</text>
      </description>
      <list name="BUFFER_QUEUE_LIST">
        <description>
          <text>Buffer queue entry for a non-VOQ port.</text>
        </description>
        <when condition="not(/sdm:sonic-device_metadata/sdm:DEVICE_METADATA/sdm:localhost/sdm:switch_type) or&#10;(/sdm:sonic-device_metadata/sdm:DEVICE_METADATA/sdm:localhost/sdm:switch_type!='voq')"/>
        <key value="port qindex"/>
        <leaf name="port">
          <type name="leafref">
            <path value="/prt:sonic-port/prt:PORT/prt:PORT_LIST/prt:name"/>
          </type>
          <description>
            <text>Port on which the egress queue buffer is configured.</text>
          </description>
        </leaf>
        <leaf name="qindex">
          <type name="string">
            <pattern value="(1[0-5]|[0-9])((-)(1[0-5]|[0-9]))?">
              <error-message>
                <value>Invalid Q-index</value>
              </error-message>
              <error-app-tag value="qindex-invalid"/>
            </pattern>
          </type>
          <description>
            <text>Egress queue index or range (e.g. 0-3) on the port.</text>
          </description>
        </leaf>
        <leaf name="profile">
          <default value="0"/>
          <type name="leafref">
            <path value="/bpf:sonic-buffer-profile/bpf:BUFFER_PROFILE/bpf:BUFFER_PROFILE_LIST/bpf:name"/>
          </type>
          <description>
            <text>Buffer profile applied to this egress queue.</text>
          </description>
        </leaf>
      </list>
      <list name="VOQ_BUFFER_QUEUE_LIST">
        <description>
          <text>Buffer queue entry for a VOQ chassis port.</text>
        </description>
        <when condition="boolean(/sdm:sonic-device_metadata/sdm:DEVICE_METADATA/sdm:localhost/sdm:switch_type) and&#10;(/sdm:sonic-device_metadata/sdm:DEVICE_METADATA/sdm:localhost/sdm:switch_type='voq')"/>
        <key value="hostname asic_name port qindex"/>
        <leaf name="hostname">
          <type name="stypes:hostname"/>
          <description>
            <text>VOQ chassis hostname owning this port.</text>
          </description>
        </leaf>
        <leaf name="asic_name">
          <type name="stypes:asic_name"/>
          <description>
            <text>ASIC instance name within the VOQ chassis.</text>
          </description>
        </leaf>
        <leaf name="port">
          <type name="string">
            <length value="1..128"/>
          </type>
          <description>
            <text>Port name on the VOQ chassis linecard.</text>
          </description>
        </leaf>
        <leaf name="qindex">
          <type name="string">
            <pattern value="(1[0-5]|[0-9])((-)(1[0-5]|[0-9]))?">
              <error-message>
                <value>Invalid Q-index</value>
              </error-message>
              <error-app-tag value="qindex-invalid"/>
            </pattern>
          </type>
          <description>
            <text>Egress queue index or range (e.g. 0-3) on the port.</text>
          </description>
        </leaf>
        <leaf name="profile">
          <default value="0"/>
          <type name="leafref">
            <path value="/bpf:sonic-buffer-profile/bpf:BUFFER_PROFILE/bpf:BUFFER_PROFILE_LIST/bpf:name"/>
          </type>
          <description>
            <text>Buffer profile applied to this egress queue.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
