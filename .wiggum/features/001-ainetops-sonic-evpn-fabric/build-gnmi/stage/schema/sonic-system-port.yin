<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-system-port"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:system-port="http://github.com/sonic-net/sonic-system-port"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-system-port"/>
  <prefix value="system-port"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>VoQ system port configuration YANG module for SONiC OS.</text>
  </description>
  <revision date="2022-11-10">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-system-port">
    <container name="SYSTEM_PORT">
      <description>
        <text>System port definitions for VoQ-based distributed switch architectures.</text>
      </description>
      <list name="SYSTEM_PORT_LIST">
        <key value="hostname asic_name ifname"/>
        <description>
          <text>A system port entry uniquely identified by host, ASIC, and interface name.</text>
        </description>
        <leaf name="hostname">
          <type name="stypes:hostname"/>
          <description>
            <text>Hostname of the switch owning this port.</text>
          </description>
        </leaf>
        <leaf name="asic_name">
          <type name="stypes:asic_name"/>
          <description>
            <text>ASIC namespace name within the switch.</text>
          </description>
        </leaf>
        <leaf name="ifname">
          <type name="string">
            <length value="1..128"/>
          </type>
          <description>
            <text>Interface name of the port on the specified ASIC.</text>
          </description>
        </leaf>
        <leaf name="core_index">
          <type name="uint8">
            <range value="0..7"/>
          </type>
          <description>
            <text>Hardware core index a port is affiliated with.</text>
          </description>
        </leaf>
        <leaf name="core_port_index">
          <type name="uint16"/>
          <description>
            <text>Local port index index to an ASIC core.</text>
          </description>
        </leaf>
        <leaf name="num_voq">
          <type name="uint8">
            <range value="1..8"/>
          </type>
          <description>
            <text>Number of VoQs associated with a port.</text>
          </description>
        </leaf>
        <leaf name="speed">
          <type name="uint32">
            <range value="1..800000"/>
          </type>
          <description>
            <text>Port speed in Mbps.</text>
          </description>
        </leaf>
        <leaf name="switch_id">
          <type name="uint16"/>
          <description>
            <text>On a VoQ switch, the global ASIC identifier.</text>
          </description>
        </leaf>
        <leaf name="system_port_id">
          <type name="uint32"/>
          <description>
            <text>On a VoQ switch, the global port identifier.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
