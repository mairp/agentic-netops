<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bgp-allowed-prefix"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bgppre="http://github.com/sonic-net/sonic-bgp-allowed-prefix"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:rpolsets="http://github.com/sonic-net/sonic-routing-policy-lists">
  <namespace uri="http://github.com/sonic-net/sonic-bgp-allowed-prefix"/>
  <prefix value="bgppre"/>
  <yang-version value="1.1"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-routing-policy-sets">
    <prefix value="rpolsets"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC BGP Allowed Prefix</text>
  </description>
  <revision date="2022-02-26">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <typedef name="bgp-allowed-ipv4-prefix">
    <type name="string">
      <pattern value="(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])/(([0-9])|([1-2][0-9])|(3[0-2]))( (le|ge) (([0-9])|([1-2][0-9])|(3[0-2])))?"/>
    </type>
    <description>
      <text>The bgp-allowed-ipv4-prefix type represents an IPv4 address prefix
in BGP allowed prefix format.

The string format is an inet:ipv4-prefix (defined in RFC 6991) value
appended with an optional suffix.

The optional suffix consists of a string 'le' or 'ge' followed by a
number which is less than or equal to 32.</text>
    </description>
  </typedef>
  <typedef name="bgp-allowed-ipv6-prefix">
    <type name="string">
      <pattern value="((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))( (le|ge) (([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))?"/>
      <pattern value="(([^:]+:){6}(([^:]+:[^:]+)|(.*\..*)))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)(/.+)( (le|ge) (([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))?"/>
    </type>
    <description>
      <text>The bgp-allowed-ipv6-prefix type represents an IPv6 address prefix
in BGP allowed prefix format.

The string format is an inet:ipv6-prefix (defined in RFC 6991) value
appended with an optional suffix.

The optional suffix consists of a string 'le' or 'ge' followed by a
number which is less than or equal to 128.</text>
    </description>
  </typedef>
  <container name="sonic-bgp-allowed-prefix">
    <container name="BGP_ALLOWED_PREFIXES">
      <list name="BGP_ALLOWED_PREFIXES_LIST">
        <key value="deployment id"/>
        <leaf name="deployment">
          <type name="string">
            <pattern value="DEPLOYMENT_ID"/>
          </type>
          <description>
            <text>BGP allowed prefix list key type</text>
          </description>
        </leaf>
        <leaf name="id">
          <type name="uint32"/>
          <description>
            <text>BGP allowed prefix list deployment id</text>
          </description>
        </leaf>
        <leaf name="default_action">
          <type name="rpolsets:routing-policy-action-type"/>
          <description>
            <text>Permit/Deny action for BGP allow prefix list</text>
          </description>
        </leaf>
        <leaf-list name="prefixes_v4">
          <type name="bgp-allowed-ipv4-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V4 allowed prefix list</text>
          </description>
        </leaf-list>
        <leaf-list name="prefixes_v6">
          <type name="bgp-allowed-ipv6-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V6 allowed prefix list</text>
          </description>
        </leaf-list>
      </list>
      <list name="BGP_ALLOWED_PREFIXES_NEIGH_LIST">
        <key value="deployment id neighbor neighbor_type"/>
        <leaf name="deployment">
          <type name="string">
            <pattern value="DEPLOYMENT_ID"/>
          </type>
          <description>
            <text>BGP allowed prefix list key type</text>
          </description>
        </leaf>
        <leaf name="id">
          <type name="uint32"/>
          <description>
            <text>BGP allowed prefix list deployment id</text>
          </description>
        </leaf>
        <leaf name="neighbor">
          <type name="string">
            <pattern value="NEIGHBOR_TYPE"/>
          </type>
          <description>
            <text>BGP allowed prefix list neighbor</text>
          </description>
        </leaf>
        <leaf name="neighbor_type">
          <type name="string"/>
          <description>
            <text>BGP allowed prefix list neighbor type</text>
          </description>
        </leaf>
        <leaf name="default_action">
          <type name="rpolsets:routing-policy-action-type"/>
          <description>
            <text>Permit/Deny action for BGP allow prefix list</text>
          </description>
        </leaf>
        <leaf-list name="prefixes_v4">
          <type name="bgp-allowed-ipv4-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V4 allowed prefix list</text>
          </description>
        </leaf-list>
        <leaf-list name="prefixes_v6">
          <type name="bgp-allowed-ipv6-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V6 allowed prefix list</text>
          </description>
        </leaf-list>
      </list>
      <list name="BGP_ALLOWED_PREFIXES_COM_LIST">
        <key value="deployment id community"/>
        <leaf name="deployment">
          <type name="string">
            <pattern value="DEPLOYMENT_ID"/>
          </type>
          <description>
            <text>BGP allowed prefix list key type</text>
          </description>
        </leaf>
        <leaf name="id">
          <type name="uint32"/>
          <description>
            <text>BGP allowed prefix list deployment id</text>
          </description>
        </leaf>
        <leaf name="community">
          <type name="string"/>
          <description>
            <text>BGP allowed prefix list deployment community</text>
          </description>
        </leaf>
        <leaf name="default_action">
          <type name="rpolsets:routing-policy-action-type"/>
          <description>
            <text>Permit/Deny action for BGP allow prefix list</text>
          </description>
        </leaf>
        <leaf-list name="prefixes_v4">
          <type name="bgp-allowed-ipv4-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V4 allowed prefix list</text>
          </description>
        </leaf-list>
        <leaf-list name="prefixes_v6">
          <type name="bgp-allowed-ipv6-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V6 allowed prefix list</text>
          </description>
        </leaf-list>
      </list>
      <list name="BGP_ALLOWED_PREFIXES_NEIGH_COM_LIST">
        <key value="deployment id neighbor neighbor_type community"/>
        <leaf name="deployment">
          <type name="string">
            <pattern value="DEPLOYMENT_ID"/>
          </type>
          <description>
            <text>BGP allowed prefix list key type</text>
          </description>
        </leaf>
        <leaf name="id">
          <type name="uint32"/>
          <description>
            <text>BGP allowed prefix list deployment id</text>
          </description>
        </leaf>
        <leaf name="neighbor">
          <type name="string">
            <pattern value="NEIGHBOR_TYPE"/>
          </type>
          <description>
            <text>BGP allowed prefix list neighbor</text>
          </description>
        </leaf>
        <leaf name="neighbor_type">
          <type name="string"/>
          <description>
            <text>BGP allowed prefix list neighbor type</text>
          </description>
        </leaf>
        <leaf name="community">
          <type name="string"/>
          <description>
            <text>BGP allowed prefix list deployment community</text>
          </description>
        </leaf>
        <leaf name="default_action">
          <type name="rpolsets:routing-policy-action-type"/>
          <description>
            <text>Permit/Deny action for BGP allow prefix list</text>
          </description>
        </leaf>
        <leaf-list name="prefixes_v4">
          <type name="bgp-allowed-ipv4-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V4 allowed prefix list</text>
          </description>
        </leaf-list>
        <leaf-list name="prefixes_v6">
          <type name="bgp-allowed-ipv6-prefix"/>
          <ordered-by value="user"/>
          <description>
            <text>BGP V6 allowed prefix list</text>
          </description>
        </leaf-list>
      </list>
    </container>
  </container>
</module>
