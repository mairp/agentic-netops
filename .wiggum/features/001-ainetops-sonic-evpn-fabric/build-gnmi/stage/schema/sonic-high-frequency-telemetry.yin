<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-high-frequency-telemetry"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:sonic-high-frequency-telemetry="http://github.com/sonic-net/sonic-high-frequency-telemetry"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:bpl="http://github.com/sonic-net/sonic-buffer-pool"
        xmlns:bpg="http://github.com/sonic-net/sonic-buffer-pg"
        xmlns:bql="http://github.com/sonic-net/sonic-buffer-queue">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-high-frequency-telemetry"/>
  <prefix value="sonic-high-frequency-telemetry"/>
  <import module="sonic-port">
    <prefix value="port"/>
  </import>
  <import module="sonic-buffer-pool">
    <prefix value="bpl"/>
  </import>
  <import module="sonic-buffer-pg">
    <prefix value="bpg"/>
  </import>
  <import module="sonic-buffer-queue">
    <prefix value="bql"/>
  </import>
  <description>
    <text>Sub-second counter polling configuration for high-frequency telemetry in SONiC.</text>
  </description>
  <container name="sonic-high-frequency-telemetry">
    <container name="HIGH_FREQUENCY_TELEMETRY_PROFILE">
      <description>
        <text>Sub-second counter polling profiles for high-frequency telemetry.</text>
      </description>
      <list name="HIGH_FREQUENCY_TELEMETRY_PROFILE_LIST">
        <key value="name"/>
        <leaf name="name">
          <type name="string">
            <length value="1..128"/>
          </type>
          <description>
            <text>Unique name for this telemetry profile.</text>
          </description>
        </leaf>
        <leaf name="stream_state">
          <mandatory value="true"/>
          <type name="string">
            <pattern value="enabled|disabled"/>
          </type>
          <description>
            <text>Whether this telemetry stream is enabled or disabled.</text>
          </description>
        </leaf>
        <leaf name="poll_interval">
          <mandatory value="true"/>
          <description>
            <text>The interval to poll counter, unit milliseconds.</text>
          </description>
          <type name="uint32"/>
        </leaf>
        <leaf name="otel_endpoint">
          <description>
            <text>The endpoint of OpenTelemetry collector. E.G. 192.168.0.100:4318. It will use the local OpenTelemetry collector if this value isn't provided.</text>
          </description>
          <type name="string">
            <length value="1..4096"/>
          </type>
        </leaf>
        <leaf name="otel_certs">
          <description>
            <text>The path of certificates for OpenTelemetry collector. E.G. /etc/sonic/otel/cert.private. If this value isn't provided, we will use a non-secure channel.</text>
          </description>
          <type name="string">
            <length value="1..4096"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="HIGH_FREQUENCY_TELEMETRY_GROUP">
      <description>
        <text>Groups of SAI objects and counters monitored by a high-frequency telemetry profile.</text>
      </description>
      <list name="HIGH_FREQUENCY_TELEMETRY_GROUP_LIST">
        <key value="profile_name group_name"/>
        <leaf name="profile_name">
          <type name="leafref">
            <path value="/sonic-high-frequency-telemetry:sonic-high-frequency-telemetry/HIGH_FREQUENCY_TELEMETRY_PROFILE/HIGH_FREQUENCY_TELEMETRY_PROFILE_LIST/name"/>
          </type>
          <description>
            <text>Reference to the parent telemetry profile.</text>
          </description>
        </leaf>
        <leaf name="group_name">
          <type name="enumeration">
            <enum name="PORT"/>
            <enum name="BUFFER_POOL"/>
            <enum name="QUEUE"/>
            <enum name="INGRESS_PRIORITY_GROUP"/>
          </type>
          <description>
            <text>SAI object type to monitor in this group.</text>
          </description>
        </leaf>
        <leaf-list name="object_names">
          <description>
            <text>SAI object instances to poll for this group.</text>
          </description>
          <type name="string"/>
          <must condition="( ../group_name = 'PORT' and current() = /port:sonic-port/port:PORT/port:PORT_LIST/port:name ) or ( ../group_name = 'BUFFER_POOL' and current() = /bpl:sonic-buffer-pool/bpl:BUFFER_POOL/bpl:BUFFER_POOL_LIST/bpl:name ) or ( ../group_name = 'INGRESS_PRIORITY_GROUP' and substring-before(current(), '|') = /bpg:sonic-buffer-pg/bpg:BUFFER_PG/bpg:BUFFER_PG_LIST/bpg:port and re-match(substring-after(current(), '|'), '[0-9]+') ) or ( ../group_name = 'QUEUE' and substring-before(current(), '|') = /bql:sonic-buffer-queue/bql:BUFFER_QUEUE/bql:BUFFER_QUEUE_LIST/bql:port and re-match(substring-after(current(), '|'), '[0-9]+') )"/>
        </leaf-list>
        <leaf-list name="object_counters">
          <description>
            <text>Counter names to collect for the objects in this group.</text>
          </description>
          <type name="string"/>
          <must condition="( ../group_name = 'PORT' and re-match(current(), 'IF_IN_OCTETS|IF_IN_UCAST_PKTS|IF_IN_DISCARDS|IF_IN_ERRORS|IN_CURR_OCCUPANCY_BYTES|IF_OUT_OCTETS|IF_OUT_DISCARDS|IF_OUT_ERRORS|IF_OUT_UCAST_PKTS|OUT_CURR_OCCUPANCY_BYTES|TRIM_PACKETS|PAUSE_RX_PKTS|PAUSE_TX_PKTS|PFC_[0-7]_RX_PKTS|PFC_[0-7]_TX_PKTS') ) or ( ../group_name = 'BUFFER_POOL' and re-match(current(), 'DROPPED_PACKETS|CURR_OCCUPANCY_BYTES|WATERMARK_BYTES|XOFF_ROOM_WATERMARK_BYTES|CURR_OCCUPANCY_CELLS|WATERMARK_CELLS') ) or ( ../group_name = 'INGRESS_PRIORITY_GROUP' and re-match(current(), 'PACKETS|BYTES|CURR_OCCUPANCY_BYTES|WATERMARK_BYTES|XOFF_ROOM_CURR_OCCUPANCY_BYTES|XOFF_ROOM_WATERMARK_BYTES|DROPPED_PACKETS|CURR_OCCUPANCY_CELLS|WATERMARK_CELLS|XOFF_ROOM_CURR_OCCUPANCY_CELLS|XOFF_ROOM_WATERMARK_CELLS') ) or ( ../group_name = 'QUEUE' and re-match(current(), 'PACKETS|BYTES|DROPPED_PACKETS|CURR_OCCUPANCY_BYTES|WATERMARK_BYTES|WRED_ECN_MARKED_PACKETS|TRIM_PACKETS|CURR_OCCUPANCY_CELLS|WATERMARK_CELLS') )"/>
        </leaf-list>
      </list>
    </container>
  </container>
</module>
