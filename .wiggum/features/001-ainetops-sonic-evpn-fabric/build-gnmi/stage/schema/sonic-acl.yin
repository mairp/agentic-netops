<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-acl"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:acl="http://github.com/sonic-net/sonic-acl"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:yang="urn:ietf:params:xml:ns:yang:ietf-yang-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:ext="http://github.com/sonic-net/sonic-extension"
        xmlns:port="http://github.com/sonic-net/sonic-port"
        xmlns:lag="http://github.com/sonic-net/sonic-portchannel"
        xmlns:sms="http://github.com/sonic-net/sonic-mirror-session">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-acl"/>
  <prefix value="acl"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="ietf-yang-types">
    <prefix value="yang"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
    <revision-date date="2019-07-01"/>
  </import>
  <import module="sonic-extension">
    <prefix value="ext"/>
    <revision-date date="2019-07-01"/>
  </import>
  <import module="sonic-port">
    <prefix value="port"/>
    <revision-date date="2019-07-01"/>
  </import>
  <import module="sonic-portchannel">
    <prefix value="lag"/>
  </import>
  <import module="sonic-mirror-session">
    <prefix value="sms"/>
  </import>
  <description>
    <text>ACL YANG Module for SONiC OS</text>
  </description>
  <revision date="2019-07-01">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-acl">
    <container name="ACL_RULE">
      <description>
        <text>Defines packet matching criteria and actions for ACL filtering rules</text>
      </description>
      <list name="ACL_RULE_LIST">
        <key value="ACL_TABLE_NAME RULE_NAME"/>
        <leaf name="ACL_TABLE_NAME">
          <type name="leafref">
            <path value="/acl:sonic-acl/acl:ACL_TABLE/acl:ACL_TABLE_LIST/acl:ACL_TABLE_NAME"/>
          </type>
        </leaf>
        <leaf name="RULE_NAME">
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="PACKET_ACTION">
          <description>
            <text>Action to take on matching packets (forward, drop, redirect, or mirror)</text>
          </description>
          <type name="stypes:packet_action"/>
        </leaf>
        <must condition="(not(../../ACL_TABLE/ACL_TABLE_LIST[ACL_TABLE_NAME=current()/ACL_TABLE_NAME]/type = 'CTRLPLANE')) or (boolean(PACKET_ACTION))"/>
        <leaf name="MIRROR_INGRESS_ACTION">
          <description>
            <text>Mirror session name for ingress traffic mirroring</text>
          </description>
          <type name="leafref">
            <path value="/sms:sonic-mirror-session/sms:MIRROR_SESSION/sms:MIRROR_SESSION_LIST/sms:name"/>
          </type>
        </leaf>
        <leaf name="MIRROR_EGRESS_ACTION">
          <description>
            <text>Mirror session name for egress traffic mirroring</text>
          </description>
          <type name="leafref">
            <path value="/sms:sonic-mirror-session/sms:MIRROR_SESSION/sms:MIRROR_SESSION_LIST/sms:name"/>
          </type>
        </leaf>
        <leaf name="INNER_SRC_MAC_REWRITE_ACTION">
          <description>
            <text>Inner Source Mac-adress rewrite action mapped to mac address</text>
          </description>
          <type name="yang:mac-address"/>
        </leaf>
        <leaf name="IP_TYPE">
          <description>
            <text>IP type to match (IPv4, IPv6, ARP, etc.)</text>
          </description>
          <type name="stypes:ip_type"/>
        </leaf>
        <leaf name="PRIORITY">
          <description>
            <text>Rule priority, higher value means higher priority</text>
          </description>
          <mandatory value="true"/>
          <type name="uint32">
            <range value="0..999999"/>
          </type>
        </leaf>
        <choice name="src_dst_address">
          <case name="l2_src_dst_address">
            <when condition="(/acl:sonic-acl/acl:ACL_TABLE/acl:ACL_TABLE_LIST[ACL_TABLE_NAME=current()/acl:ACL_TABLE_NAME]/acl:type = 'L2')"/>
            <leaf name="SRC_MAC">
              <description>
                <text>Source MAC address and mask to match</text>
              </description>
              <type name="stypes:mac-addr-and-mask"/>
            </leaf>
            <leaf name="DST_MAC">
              <description>
                <text>Destination MAC address and mask to match</text>
              </description>
              <type name="stypes:mac-addr-and-mask"/>
            </leaf>
          </case>
          <case name="ip4_prefix">
            <when condition="not(IP_TYPE) or boolean(IP_TYPE[.='ANY' or .='IP' or .='IPV4' or .='IPv4ANY' or .='IPV4ANY' or .='ARP'])"/>
            <leaf name="SRC_IP">
              <description>
                <text>Source IPv4 address or prefix to match</text>
              </description>
              <type name="inet:ipv4-prefix"/>
            </leaf>
            <leaf name="DST_IP">
              <description>
                <text>Destination IPv4 address or prefix to match</text>
              </description>
              <type name="inet:ipv4-prefix"/>
            </leaf>
            <leaf name="INNER_SRC_IP">
              <description>
                <text>Source IP prefix for inner packet</text>
              </description>
              <type name="inet:ipv4-prefix"/>
            </leaf>
          </case>
          <case name="ip6_prefix">
            <when condition="not(IP_TYPE) or boolean(IP_TYPE[.='ANY' or .='IP' or .='IPV6' or .='IPv6ANY' or .='IPV6ANY'])"/>
            <leaf name="SRC_IPV6">
              <description>
                <text>Source IPv6 address or prefix to match</text>
              </description>
              <type name="inet:ipv6-prefix"/>
            </leaf>
            <leaf name="DST_IPV6">
              <description>
                <text>Destination IPv6 address or prefix to match</text>
              </description>
              <type name="inet:ipv6-prefix"/>
            </leaf>
          </case>
        </choice>
        <leaf name="IN_PORTS">
          <description>
            <text>Comma-separated list of ingress ports to match</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="OUT_PORTS">
          <description>
            <text>Comma-separated list of egress ports to match</text>
          </description>
          <type name="string"/>
        </leaf>
        <choice name="src_port">
          <case name="l4_src_port">
            <leaf name="L4_SRC_PORT">
              <description>
                <text>Layer 4 source port number to match</text>
              </description>
              <type name="uint16"/>
            </leaf>
          </case>
          <case name="l4_src_port_range">
            <leaf name="L4_SRC_PORT_RANGE">
              <description>
                <text>Layer 4 source port range to match (low-high)</text>
              </description>
              <type name="string">
                <pattern value="([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])-([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"/>
              </type>
            </leaf>
          </case>
        </choice>
        <choice name="dst_port">
          <case name="l4_dst_port">
            <leaf name="L4_DST_PORT">
              <description>
                <text>Layer 4 destination port number to match</text>
              </description>
              <type name="uint16"/>
            </leaf>
          </case>
          <case name="l4_dst_port_range">
            <leaf name="L4_DST_PORT_RANGE">
              <description>
                <text>Layer 4 destination port range to match (low-high)</text>
              </description>
              <type name="string">
                <pattern value="([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])-([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])"/>
              </type>
            </leaf>
          </case>
        </choice>
        <leaf name="ETHER_TYPE">
          <description>
            <text>Ethernet type field value to match</text>
          </description>
          <type name="string">
            <pattern value="0x0[6-9a-fA-F][0-9a-fA-F]{2}|0x[1-9a-fA-F][0-9a-fA-F]{3}|153[6-9]|15[4-9][0-9]|1[6-9][0-9][0-9]|[2-9][0-9]{3}|[1-5][0-9]{4}|6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}"/>
          </type>
        </leaf>
        <leaf name="IP_PROTOCOL">
          <description>
            <text>IP protocol number to match</text>
          </description>
          <type name="uint8">
            <range value="1..143"/>
          </type>
        </leaf>
        <leaf name="TCP_FLAGS">
          <description>
            <text>TCP flags to match as a hex bitmask</text>
          </description>
          <type name="string">
            <pattern value="0[xX][0-9a-fA-F]{1,2}(/0[xX][0-9a-fA-F]{1,2})?"/>
          </type>
        </leaf>
        <must condition="not(TCP_FLAGS) or count(/acl:sonic-acl/acl:ACL_TABLE_TYPE/acl:ACL_TABLE_TYPE_LIST[acl:ACL_TABLE_TYPE_NAME = /acl:sonic-acl/acl:ACL_TABLE/acl:ACL_TABLE_LIST[acl:ACL_TABLE_NAME = current()/ACL_TABLE_NAME]/acl:type]/acl:MATCHES[. = 'TCP_FLAGS']) &gt; 0"/>
        <leaf name="DSCP">
          <description>
            <text>DSCP value to match</text>
          </description>
          <type name="uint8"/>
        </leaf>
        <leaf name="TC">
          <description>
            <text>Traffic class value to match</text>
          </description>
          <type name="uint8"/>
        </leaf>
        <choice name="icmp">
          <case name="icmp4">
            <when condition="not(IP_TYPE) or boolean(IP_TYPE[.='ANY' or .='IP' or .='IPV4' or .='IPv4ANY' or .='IPV4ANY' or .='ARP'])"/>
            <leaf name="ICMP_TYPE">
              <description>
                <text>ICMPv4 type value to match</text>
              </description>
              <type name="uint8">
                <range value="0..255"/>
              </type>
            </leaf>
            <leaf name="ICMP_CODE">
              <description>
                <text>ICMPv4 code value to match</text>
              </description>
              <type name="uint8">
                <range value="0..255"/>
              </type>
            </leaf>
          </case>
          <case name="icmp6">
            <when condition="not(IP_TYPE) or boolean(IP_TYPE[.='ANY' or .='IP' or .='IPV6' or .='IPv6ANY' or .='IPV6ANY'])"/>
            <leaf name="ICMPV6_TYPE">
              <description>
                <text>ICMPv6 type value to match</text>
              </description>
              <type name="uint8">
                <range value="0..255"/>
              </type>
            </leaf>
            <leaf name="ICMPV6_CODE">
              <description>
                <text>ICMPv6 code value to match</text>
              </description>
              <type name="uint8">
                <range value="0..255"/>
              </type>
            </leaf>
          </case>
        </choice>
        <leaf name="INNER_ETHER_TYPE">
          <description>
            <text>Inner packet Ethernet type field to match for tunnel traffic</text>
          </description>
          <type name="string">
            <pattern value="(0x88CC|0x8100|0x8915|0x0806|0x0800|0x86DD|0x8847)"/>
          </type>
        </leaf>
        <leaf name="INNER_IP_PROTOCOL">
          <description>
            <text>Inner packet IP protocol number to match for tunnel traffic</text>
          </description>
          <type name="uint8">
            <range value="1..143"/>
          </type>
        </leaf>
        <leaf name="INNER_L4_SRC_PORT">
          <description>
            <text>Inner packet Layer 4 source port to match for tunnel traffic</text>
          </description>
          <type name="uint16"/>
        </leaf>
        <leaf name="INNER_L4_DST_PORT">
          <description>
            <text>Inner packet Layer 4 destination port to match for tunnel traffic</text>
          </description>
          <type name="uint16"/>
        </leaf>
        <leaf name="VLAN_ID">
          <description>
            <text>VLAN ID to match</text>
          </description>
          <type name="uint16">
            <range value="1..4094"/>
          </type>
        </leaf>
        <leaf name="TUNNEL_VNI">
          <description>
            <text>VXLAN Network Identifier</text>
          </description>
          <type name="stypes:vnid_type"/>
        </leaf>
        <leaf name="PCP">
          <description>
            <text>802.1Q Priority Code Point value to match</text>
          </description>
          <when condition="(/acl:sonic-acl/acl:ACL_TABLE/acl:ACL_TABLE_LIST[ACL_TABLE_NAME=current()/../acl:ACL_TABLE_NAME]/acl:type = 'L2')"/>
          <type name="string">
            <pattern value="[0-7]|[0-7]/[0-7]"/>
          </type>
        </leaf>
        <leaf name="DEI">
          <description>
            <text>802.1Q Drop Eligible Indicator value to match</text>
          </description>
          <when condition="(/acl:sonic-acl/acl:ACL_TABLE/acl:ACL_TABLE_LIST[ACL_TABLE_NAME=current()/../acl:ACL_TABLE_NAME]/acl:type = 'L2')"/>
          <type name="uint8">
            <range value="0..1"/>
          </type>
        </leaf>
        <leaf name="BTH_OPCODE">
          <description>
            <text>RoCEv2 BTH OPCODE field</text>
          </description>
          <type name="string">
            <pattern value="0[xX][0-9a-fA-F]{1,2}/0[xX][0-9a-fA-F]{1,2}"/>
          </type>
        </leaf>
        <leaf name="AETH_SYNDROME">
          <description>
            <text>RoCEv2 AETH SYNDROME field</text>
          </description>
          <type name="string">
            <pattern value="0[xX][0-9a-fA-F]{1,2}/0[xX][0-9a-fA-F]{1,2}"/>
          </type>
        </leaf>
        <leaf name="TUNNEL_TERM">
          <description>
            <text>Tunnel Termination Flag</text>
          </description>
          <type name="boolean"/>
        </leaf>
      </list>
    </container>
    <container name="ACL_TABLE_TYPE">
      <description>
        <text>Defines user-defined ACL table types with custom matches, actions, and bind points</text>
      </description>
      <list name="ACL_TABLE_TYPE_LIST">
        <description>
          <text>A custom ACL table type definition</text>
        </description>
        <key value="ACL_TABLE_TYPE_NAME"/>
        <leaf name="ACL_TABLE_TYPE_NAME">
          <description>
            <text>Name of the custom ACL table type</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf-list name="MATCHES">
          <description>
            <text>List of packet match fields supported by this table type</text>
          </description>
          <type name="string"/>
          <ordered-by value="user"/>
          <min-elements value="1"/>
        </leaf-list>
        <leaf-list name="ACTIONS">
          <description>
            <text>List of actions supported by this table type</text>
          </description>
          <type name="string"/>
          <ordered-by value="user"/>
          <default value=""/>
        </leaf-list>
        <leaf-list name="BIND_POINTS">
          <description>
            <text>List of bind point types where this table can be attached</text>
          </description>
          <type name="enumeration">
            <enum name="PORT"/>
            <enum name="PORTCHANNEL"/>
          </type>
          <ordered-by value="user"/>
          <min-elements value="1"/>
        </leaf-list>
      </list>
    </container>
    <container name="ACL_TABLE">
      <description>
        <text>Defines ACL tables including type, stage, and port bindings</text>
      </description>
      <list name="ACL_TABLE_LIST">
        <key value="ACL_TABLE_NAME"/>
        <leaf name="ACL_TABLE_NAME">
          <description>
            <text>Name of the ACL table</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="policy_desc">
          <description>
            <text>Human-readable description of the ACL policy</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="type">
          <description>
            <text>ACL table type defining the set of supported match fields and actions</text>
          </description>
          <mandatory value="true"/>
          <type name="union">
            <type name="leafref">
              <path value="/acl:sonic-acl/acl:ACL_TABLE_TYPE/acl:ACL_TABLE_TYPE_LIST/acl:ACL_TABLE_TYPE_NAME"/>
            </type>
            <type name="stypes:acl_table_type"/>
          </type>
        </leaf>
        <leaf name="stage">
          <description>
            <text>Pipeline stage where the ACL is applied (ingress or egress)</text>
          </description>
          <type name="string">
            <pattern value="ingress|egress|INGRESS|EGRESS"/>
          </type>
          <default value="INGRESS"/>
        </leaf>
        <leaf-list name="services">
          <description>
            <text>List of services this ACL table is applied to (for control plane ACLs)</text>
          </description>
          <type name="string"/>
          <ordered-by value="user"/>
        </leaf-list>
        <must condition="(not(type = 'CTRLPLANE')) or (boolean(services))"/>
        <leaf-list name="ports">
          <description>
            <text>List of ports or port channels this ACL table is bound to</text>
          </description>
          <type name="union">
            <type name="leafref">
              <path value="/port:sonic-port/port:PORT/port:PORT_LIST/port:name"/>
            </type>
            <type name="leafref">
              <path value="/lag:sonic-portchannel/lag:PORTCHANNEL/lag:PORTCHANNEL_LIST/lag:name"/>
            </type>
            <type name="string">
              <pattern value=""/>
            </type>
          </type>
          <ordered-by value="user"/>
          <default value=""/>
        </leaf-list>
      </list>
    </container>
  </container>
</module>
