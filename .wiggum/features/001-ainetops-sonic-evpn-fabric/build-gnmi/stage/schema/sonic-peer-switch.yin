<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-peer-switch"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:peer_switch="http://github.com/sonic-net/sonic-peer-switch"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-peer-switch"/>
  <prefix value="peer_switch"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONiC DualToR peer switch data</text>
  </description>
  <revision date="2022-08-23">
    <description>
      <text>Initial revision</text>
    </description>
  </revision>
  <container name="sonic-peer-switch">
    <container name="PEER_SWITCH">
      <list name="PEER_SWITCH_LIST">
        <max-elements value="1"/>
        <key value="peer_switch"/>
        <leaf name="peer_switch">
          <type name="stypes:hostname"/>
          <description>
            <text>SONiC DualToR peer host name.</text>
          </description>
        </leaf>
        <leaf name="address_ipv4">
          <type name="inet:ipv4-address"/>
          <description>
            <text>SONiC DualToR peer's IPv4 address.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
