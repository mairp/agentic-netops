<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-memory-statistics"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:memstats="http://github.com/sonic-net/sonic-memory-statistics">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-memory-statistics"/>
  <prefix value="memstats"/>
  <description>
    <text>YANG module for configuring memory statistics in SONiC-based OS.</text>
  </description>
  <revision date="2024-07-22">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-memory-statistics">
    <container name="MEMORY_STATISTICS">
      <description>
        <text>Memory statistics configuration parameters.</text>
      </description>
      <container name="memory_statistics">
        <leaf name="enabled">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Flag to enable or disable memory statistics collection. If set to false, the memory statistics collection will stop.</text>
          </description>
        </leaf>
        <leaf name="sampling_interval">
          <type name="uint8">
            <range value="3..15"/>
          </type>
          <units name="minutes"/>
          <default value="5"/>
          <description>
            <text>Time interval in minutes for sampling memory statistics. Valid range, is between 3 minutes to 30 minutes.</text>
          </description>
        </leaf>
        <leaf name="retention_period">
          <type name="uint8">
            <range value="1..30"/>
          </type>
          <units name="days"/>
          <default value="15"/>
          <description>
            <text>Retention period for memory statistics data, defined in days. Valid range is from 1 day to 30 days.</text>
          </description>
        </leaf>
      </container>
    </container>
  </container>
</module>
