<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-dash"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:dash="http://github.com/Azure/sonic-dash"
        xmlns:yang="urn:ietf:params:xml:ns:yang:ietf-yang-types"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/Azure/sonic-dash"/>
  <prefix value="dash"/>
  <import module="ietf-yang-types">
    <prefix value="yang"/>
  </import>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>Disaggregated API for SONiC Hosts (DASH) SmartNIC/DPU overlay configuration.</text>
  </description>
  <revision date="2022-12-07">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-dash">
    <container name="DASH_VNET">
      <description>
        <text>DASH virtual network definitions with VNI and address space.</text>
      </description>
      <list name="DASH_VNET_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Virtual network name.</text>
          </description>
          <type name="string">
            <pattern value="Vnet[a-zA-Z0-9_-]+">
              <error-message>
                <value>Invalid Vnet name</value>
              </error-message>
              <error-app-tag value="vnet-name-invalid"/>
            </pattern>
          </type>
        </leaf>
        <leaf name="vni">
          <description>
            <text>VXLAN Network Identifier for the virtual network.</text>
          </description>
          <type name="uint32">
            <range value="1..16777215"/>
          </type>
        </leaf>
        <leaf name="guid">
          <description>
            <text>Guid used for Vnet identification</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf-list name="address_spaces">
          <description>
            <text>IP prefixes belonging to this virtual network.</text>
          </description>
          <type name="stypes:sonic-ip-prefix"/>
          <ordered-by value="user"/>
        </leaf-list>
      </list>
    </container>
    <container name="DASH_QOS">
      <description>
        <text>DASH QoS profiles specifying bandwidth, connection, and flow limits.</text>
      </description>
      <list name="DASH_QOS_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>QoS profile name.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="bw">
          <description>
            <text>Bandwidth in kbps</text>
          </description>
          <type name="uint64">
            <range value="0..100000000">
              <error-message>
                <value>kbps value out of range</value>
              </error-message>
            </range>
          </type>
        </leaf>
        <leaf name="cps">
          <description>
            <text>Max number of connections per second</text>
          </description>
          <type name="uint64">
            <range value="0..100000000">
              <error-message>
                <value>cps value out of range</value>
              </error-message>
            </range>
          </type>
        </leaf>
        <leaf name="flows">
          <description>
            <text>Number of flows</text>
          </description>
          <type name="uint64">
            <range value="0..100000000">
              <error-message>
                <value>flows value out of range</value>
              </error-message>
            </range>
          </type>
        </leaf>
      </list>
    </container>
    <container name="DASH_ENI">
      <description>
        <text>DASH Elastic Network Interface (ENI) configuration.</text>
      </description>
      <list name="DASH_ENI_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>ENI name.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="eni_id">
          <description>
            <text>ENI guid for cross reference and identification</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="mac_address">
          <description>
            <text>MAC address of the ENI.</text>
          </description>
          <type name="yang:mac-address"/>
        </leaf>
        <leaf name="qos">
          <description>
            <text>Reference to the QoS profile applied to this ENI.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_QOS/dash:DASH_QOS_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="vnet">
          <description>
            <text>Reference to the virtual network this ENI belongs to.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_VNET/dash:DASH_VNET_LIST/dash:name"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="DASH_ACL_IN">
      <description>
        <text>DASH ingress ACL bindings associating an ENI stage with an ACL group.</text>
      </description>
      <list name="DASH_ACL_IN_LIST">
        <key value="eni stage"/>
        <leaf name="eni">
          <description>
            <text>Reference to the ENI this ingress ACL applies to.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ENI/dash:DASH_ENI_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="stage">
          <description>
            <text>ACL pipeline stage number.</text>
          </description>
          <type name="uint8">
            <range value="1..5"/>
          </type>
        </leaf>
        <leaf name="acl_group_id">
          <description>
            <text>Reference to the ACL group applied at this stage.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ACL_GROUP/dash:DASH_ACL_GROUP_LIST/dash:name"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="DASH_ACL_OUT">
      <description>
        <text>DASH egress ACL bindings associating an ENI stage with an ACL group.</text>
      </description>
      <list name="DASH_ACL_OUT_LIST">
        <key value="eni stage"/>
        <leaf name="eni">
          <description>
            <text>Reference to the ENI this egress ACL applies to.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ENI/dash:DASH_ENI_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="stage">
          <description>
            <text>ACL pipeline stage number.</text>
          </description>
          <type name="uint8">
            <range value="1..5"/>
          </type>
        </leaf>
        <leaf name="acl_group_id">
          <description>
            <text>Reference to the ACL group applied at this stage.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ACL_GROUP/dash:DASH_ACL_GROUP_LIST/dash:name"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="DASH_ACL_GROUP">
      <description>
        <text>DASH ACL group defining the IP version for a set of ACL rules.</text>
      </description>
      <list name="DASH_ACL_GROUP_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>ACL group name.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="ip_version">
          <description>
            <text>IP version (ipv4 or ipv6) for rules in this group.</text>
          </description>
          <type name="string">
            <pattern value="ipv4|ipv6"/>
          </type>
        </leaf>
        <leaf name="guid">
          <description>
            <text>Globally unique identifier for this ACL group.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="DASH_ACL_RULE">
      <description>
        <text>DASH ACL rules with match criteria and allow/deny actions.</text>
      </description>
      <list name="DASH_ACL_RULE_LIST">
        <key value="acl_group_id name"/>
        <leaf name="acl_group_id">
          <description>
            <text>Reference to the ACL group this rule belongs to.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ACL_GROUP/dash:DASH_ACL_GROUP_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="name">
          <description>
            <text>ACL rule name.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="priority">
          <description>
            <text>Rule evaluation priority, lower values are evaluated first.</text>
          </description>
          <type name="uint32">
            <range value="0..16777215"/>
          </type>
        </leaf>
        <leaf name="action">
          <description>
            <text>Allow or deny matching traffic.</text>
          </description>
          <type name="string">
            <pattern value="allow|deny"/>
          </type>
        </leaf>
        <leaf name="terminating">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>If set to true, stop processing further rules</text>
          </description>
        </leaf>
        <leaf-list name="ip_protocol">
          <description>
            <text>IP Protocol (tcp or udp or icmp etc)</text>
          </description>
          <type name="stypes:ip-protocol-type"/>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf-list name="src_addr">
          <description>
            <text>Source IP prefixes to match.</text>
          </description>
          <type name="stypes:sonic-ip-prefix"/>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf-list name="dst_addr">
          <description>
            <text>Destination IP prefixes to match.</text>
          </description>
          <type name="stypes:sonic-ip-prefix"/>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf-list name="src_port">
          <description>
            <text>List of L4 source port range as pattern '0-65365'</text>
          </description>
          <type name="string">
            <pattern value="([0-9]{1,4}|[0-5][0-9]{4}|[6][0-4][0-9]{3}|[6][5][0-2][0-9]{2}|[6][5][3][0-5]{2}|[6][5][3][6][0-5])-([0-9]{1,4}|[0-5][0-9]{4}|[6][0-4][0-9]{3}|[6][5][0-2][0-9]{2}|[6][5][3][0-5]{2}|[6][5][3][6][0-5])"/>
          </type>
          <ordered-by value="user"/>
        </leaf-list>
        <leaf-list name="dst_port">
          <description>
            <text>List of L4 dst port range as pattern '0-65365'</text>
          </description>
          <type name="string">
            <pattern value="([0-9]{1,4}|[0-5][0-9]{4}|[6][0-4][0-9]{3}|[6][5][0-2][0-9]{2}|[6][5][3][0-5]{2}|[6][5][3][6][0-5])-([0-9]{1,4}|[0-5][0-9]{4}|[6][0-4][0-9]{3}|[6][5][0-2][0-9]{2}|[6][5][3][0-5]{2}|[6][5][3][6][0-5])"/>
          </type>
          <ordered-by value="user"/>
        </leaf-list>
      </list>
    </container>
    <container name="DASH_APPLIANCE">
      <description>
        <text>DASH appliance-level configuration for SmartNIC/DPU devices.</text>
      </description>
      <list name="DASH_APPLIANCE_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Appliance name.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="sip">
          <description>
            <text>Source IP address of the appliance.</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="vni">
          <description>
            <text>VM VNI used for determining packet direction.</text>
          </description>
          <type name="uint32">
            <range value="1..16777215"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="DASH_ROUTING_TYPE">
      <description>
        <text>DASH routing type definitions mapping names to forwarding actions and encapsulation.</text>
      </description>
      <list name="DASH_ROUTING_TYPE_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Routing type identifier.</text>
          </description>
          <type name="string">
            <pattern value="direct|vnet|vnet_direct|vnet_encap|drop|appliance|privatelink|privatelinknsg|servicetunnel"/>
          </type>
        </leaf>
        <leaf name="action_name">
          <description>
            <text>Name of the forwarding action.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="action_type">
          <description>
            <text>Type of forwarding action to apply.</text>
          </description>
          <type name="string">
            <pattern value="none|maprouting|direct|staticencap|appliance|4to6|mapdecap|decap|drop"/>
          </type>
        </leaf>
        <leaf name="encap_type">
          <description>
            <text>Tunnel encapsulation type (VXLAN or NVGRE).</text>
          </description>
          <type name="string">
            <pattern value="vxlan|nvgre"/>
          </type>
        </leaf>
        <leaf name="vni">
          <description>
            <text>VNI to use for tunnel encapsulation.</text>
          </description>
          <type name="uint32">
            <range value="1..16777215"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="DASH_ROUTE_TABLE">
      <description>
        <text>DASH LPM route table for outbound routing per ENI.</text>
      </description>
      <list name="DASH_ROUTE_TABLE_LIST">
        <key value="eni prefix"/>
        <leaf name="eni">
          <description>
            <text>Reference to the ENI this route applies to.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ENI/dash:DASH_ENI_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="prefix">
          <description>
            <text>Destination IP prefix for LPM lookup.</text>
          </description>
          <type name="stypes:sonic-ip-prefix"/>
        </leaf>
        <leaf name="action_type">
          <description>
            <text>Routing type that determines the forwarding action.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ROUTING_TYPE/dash:DASH_ROUTING_TYPE_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="vnet">
          <description>
            <text>Target virtual network for vnet or vnet_direct routing.</text>
          </description>
          <when condition="((current()/../action_type = 'vnet') or (current()/../action_type = 'vnet_direct'))"/>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_VNET/dash:DASH_VNET_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="appliance">
          <description>
            <text>Target appliance for appliance routing.</text>
          </description>
          <when condition="(current()/../action_type = 'appliance')"/>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_APPLIANCE/dash:DASH_APPLIANCE_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="overlay_ip">
          <when condition="((current()/../action_type = 'vnet') or (current()/../action_type = 'vnet_direct'))"/>
          <description>
            <text>Overlay IP to use for mapping lookup, if routing_type is vnet_direct</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="overlay_sip">
          <when condition="(current()/../action_type = 'servicetunnel')"/>
          <description>
            <text>Overlay src ip for service tunnel</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="overlay_dip">
          <when condition="(current()/../action_type = 'servicetunnel')"/>
          <description>
            <text>Overlay dst ip for service tunnel</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="underlay_sip">
          <when condition="(current()/../action_type = 'servicetunnel')"/>
          <description>
            <text>Underlay src ip for service tunnel</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="underlay_dip">
          <when condition="(current()/../action_type = 'servicetunnel')"/>
          <description>
            <text>Underlay dst ip for service tunnel</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
      </list>
    </container>
    <container name="DASH_VNET_MAPPING_TABLE">
      <description>
        <text>DASH CA-to-PA mapping table for a virtual network.</text>
      </description>
      <list name="DASH_VNET_MAPPING_TABLE_LIST">
        <key value="vnet ip_addr"/>
        <leaf name="vnet">
          <description>
            <text>Reference to the virtual network this mapping belongs to.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_VNET/dash:DASH_VNET_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="ip_addr">
          <description>
            <text>Overlay CA address</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="routing_type">
          <description>
            <text>Routing type for this mapping entry.</text>
          </description>
          <type name="leafref">
            <path value="/dash:sonic-dash/dash:DASH_ROUTING_TYPE/dash:DASH_ROUTING_TYPE_LIST/dash:name"/>
          </type>
        </leaf>
        <leaf name="underlay_ip">
          <description>
            <text>PA address</text>
          </description>
          <type name="inet:ip-address"/>
        </leaf>
        <leaf name="mac_address">
          <description>
            <text>Inner destination MAC for the mapped endpoint.</text>
          </description>
          <type name="yang:mac-address"/>
        </leaf>
        <leaf name="use_dst_vni">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>If set to true, use destination VNET VNI for encap</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
