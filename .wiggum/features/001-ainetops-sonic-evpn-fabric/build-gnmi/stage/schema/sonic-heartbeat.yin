<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-heartbeat"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:heartbeat="http://github.com/sonic-net/sonic-heartbeat">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-heartbeat"/>
  <prefix value="heartbeat"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>HEARTBEAT YANG Module for SONiC OS</text>
  </description>
  <revision date="2025-01-09">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-heartbeat">
    <container name="HEARTBEAT">
      <description>
        <text>Heartbeat monitoring configuration for system processes</text>
      </description>
      <list name="HEARTBEAT_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>process name in HEARTBEAT table</text>
          </description>
          <type name="string">
            <length value="1..32"/>
          </type>
        </leaf>
        <leaf name="heartbeat_interval">
          <description>
            <text>Heartbeat interval in millisecond</text>
          </description>
          <type name="uint32"/>
          <default value="10000"/>
        </leaf>
        <leaf name="alert_interval">
          <description>
            <text>Alert interval in millisecond</text>
          </description>
          <type name="uint32"/>
          <default value="60000"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
