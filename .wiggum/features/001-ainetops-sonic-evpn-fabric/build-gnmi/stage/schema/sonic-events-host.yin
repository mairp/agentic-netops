<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-events-host"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:events-host="http://github.com/sonic-net/sonic-events-host"
        xmlns:evtcmn="http://github.com/sonic-net/sonic-events-common"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <namespace uri="http://github.com/sonic-net/sonic-events-host"/>
  <yang-version value="1.1"/>
  <prefix value="events-host"/>
  <import module="sonic-events-common">
    <prefix value="evtcmn"/>
    <revision-date date="2022-12-01"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>YANG schema defined for host events</text>
  </description>
  <revision date="2022-12-01">
    <description>
      <text>Host alert events.</text>
    </description>
  </revision>
  <container name="sonic-events-host">
    <container name="disk-usage">
      <evtcmn:ALARM_SEVERITY_MINOR/>
      <description>
        <text>
Declares an event for disk usage crossing set limit
The parameters describe the usage &amp; limit set.</text>
      </description>
      <leaf name="fs">
        <type name="string"/>
        <description>
          <text>Name of the file system</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-usage"/>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="memory-usage">
      <evtcmn:ALARM_SEVERITY_MINOR/>
      <description>
        <text>
Declares an event for memory usage crossing set limit
The parameters describe the usage &amp; limit set.</text>
      </description>
      <uses name="evtcmn:sonic-events-usage"/>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="cpu-usage">
      <evtcmn:ALARM_SEVERITY_MINOR/>
      <description>
        <text>
Declares an event for cpu usage crossing set limit
The parameters describe the usage &amp; limit set.</text>
      </description>
      <uses name="evtcmn:sonic-events-usage"/>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="event-sshd">
      <evtcmn:ALARM_SEVERITY_MINOR/>
      <description>
        <text>
Declares and event reported by sshd.
This implies an internal system state blocks sshd from
creating the new user.</text>
      </description>
      <leaf name="username">
        <type name="string"/>
        <description>
          <text>Name of the new user</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="event-disk">
      <evtcmn:ALARM_SEVERITY_MINOR/>
      <description>
        <text>
Declares an event reported by disk check.
The fail type declares the type of failure.
read-only - denotes that disk is in RO state.</text>
      </description>
      <leaf name="fail_type">
        <type name="enumeration">
          <enum name="read_only"/>
          <enum name="disk_full"/>
        </type>
        <description>
          <text>Type of failure</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="event-kernel">
      <evtcmn:ALARM_SEVERITY_MINOR/>
      <description>
        <text>
Declares an event reported by kernel.
The fail type declares the type of failure.</text>
      </description>
      <leaf name="fail_type">
        <type name="enumeration">
          <enum name="write_failed"/>
          <enum name="write_protected"/>
          <enum name="remount_read_only"/>
          <enum name="zlib_decompress"/>
        </type>
        <description>
          <text>Type of failure</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="event-down-ctr">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declares an container that is expected to be up is down.
Reported by monit periodically.</text>
      </description>
      <leaf name="ctr_name">
        <type name="string"/>
        <description>
          <text>Name of the container not running</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="event-stopped-ctr">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declare an event at the time point of container stopping.
event-down-ctr fires periodically until it starts up.</text>
      </description>
      <leaf name="ctr_name">
        <type name="string"/>
        <description>
          <text>Name of the container</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="watchdog-timeout">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declares an event for watchdog timeout failure.
Params:
limit provides max timeout limit</text>
      </description>
      <leaf name="limit">
        <type name="uint8"/>
        <description>
          <text>Timeout limit</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="event-seu">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declares an event for SEU error.</text>
      </description>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="invalid-freelist">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declares an event for invalid freelist failure.</text>
      </description>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="mem-threshold-exceeded">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declares an event for memory exceeding threshold failure.</text>
      </description>
      <leaf name="ctr_name">
        <type name="stypes:ctr_name"/>
        <description>
          <text>Container name of mem-threshold-exceeded event</text>
        </description>
      </leaf>
      <leaf name="mem_usage">
        <type name="decimal64">
          <fraction-digits value="2"/>
        </type>
        <description>
          <text>Memory usage of process</text>
        </description>
      </leaf>
      <leaf name="threshold">
        <type name="uint64"/>
        <description>
          <text>Threshold value of process</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="process-exited-unexpectedly">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declares an event in which a critical process exits unexpectedly.</text>
      </description>
      <leaf name="process_name">
        <type name="stypes:process_name"/>
        <description>
          <text>Name of process that is exiting unexpectedly</text>
        </description>
      </leaf>
      <leaf name="ctr_name">
        <type name="stypes:ctr_name"/>
        <description>
          <text>Container name of process that is exiting unexpectedly</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
    <container name="process-not-running">
      <evtcmn:EVENT_SEVERITY_2/>
      <description>
        <text>
Declares an event in which a critical process exits unexpectedly.</text>
      </description>
      <leaf name="process_name">
        <type name="stypes:process_name"/>
        <description>
          <text>Name of process that is not running</text>
        </description>
      </leaf>
      <leaf name="ctr_name">
        <type name="stypes:ctr_name"/>
        <description>
          <text>Container name</text>
        </description>
      </leaf>
      <uses name="evtcmn:sonic-events-cmn"/>
    </container>
  </container>
</module>
