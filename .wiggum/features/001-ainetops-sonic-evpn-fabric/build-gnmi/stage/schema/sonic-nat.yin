<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-nat"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:snat="http://github.com/sonic-net/sonic-nat"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <namespace uri="http://github.com/sonic-net/sonic-nat"/>
  <prefix value="snat"/>
  <yang-version value="1.1"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONiC NAT yang model</text>
  </description>
  <revision date="2021-03-14">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <typedef name="nat-type">
    <type name="enumeration">
      <enum name="snat">
        <description>
          <text>Source NAT.</text>
        </description>
      </enum>
      <enum name="dnat">
        <description>
          <text>Destination NAT.</text>
        </description>
      </enum>
    </type>
  </typedef>
  <typedef name="ip-address-range">
    <type name="union">
      <type name="inet:ipv4-address"/>
      <type name="string">
        <pattern value="(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(-(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))?"/>
      </type>
    </type>
    <description>
      <text>This type denotes a single IP address or a range of addresses.</text>
    </description>
  </typedef>
  <container name="sonic-nat">
    <container name="STATIC_NAPT">
      <description>
        <text>Static NAPT entries mapping global IP/port to local IP/port</text>
      </description>
      <list name="STATIC_NAPT_LIST">
        <key value="global_ip ip_protocol global_l4_port"/>
        <leaf name="global_ip">
          <description>
            <text>Global ip for the Static NAPT entry.</text>
          </description>
          <type name="inet:ipv4-address"/>
        </leaf>
        <leaf name="ip_protocol">
          <description>
            <text>IP Protocol (tcp or udp) for the Static NAPT entry.</text>
          </description>
          <type name="stypes:ip-protocol-type"/>
        </leaf>
        <leaf name="global_l4_port">
          <description>
            <text>Global L4 port for the Static NAPT entry.</text>
          </description>
          <type name="inet:port-number"/>
        </leaf>
        <leaf name="local_ip">
          <description>
            <text>Local ip for the Static NAPT entry.</text>
          </description>
          <mandatory value="true"/>
          <type name="inet:ipv4-address"/>
        </leaf>
        <leaf name="local_port">
          <description>
            <text>Local port for the Static NAPT entry.</text>
          </description>
          <mandatory value="true"/>
          <type name="inet:port-number"/>
        </leaf>
        <leaf name="nat_type">
          <description>
            <text>Nat type for the static napt entry - snat or dnat</text>
          </description>
          <type name="nat-type"/>
          <default value="dnat"/>
        </leaf>
        <leaf name="twice_nat_id">
          <description>
            <text>Twice nat id for the static napt to achieve the twice napt</text>
          </description>
          <type name="uint16">
            <range value="1..9999">
              <error-message>
                <value>Invalid twice nat id for the static NAPT.</value>
              </error-message>
              <error-app-tag value="twice-nat-id-invalid"/>
            </range>
          </type>
        </leaf>
      </list>
    </container>
    <container name="STATIC_NAT">
      <description>
        <text>Static NAT entries mapping global IP to local IP</text>
      </description>
      <list name="STATIC_NAT_LIST">
        <key value="global_ip"/>
        <leaf name="global_ip">
          <description>
            <text>Global ip for the Static NAT entry.</text>
          </description>
          <type name="inet:ipv4-address"/>
        </leaf>
        <leaf name="local_ip">
          <description>
            <text>Local ip for the Static NAT entry.</text>
          </description>
          <mandatory value="true"/>
          <type name="inet:ipv4-address"/>
        </leaf>
        <leaf name="nat_type">
          <description>
            <text>Nat type for the static nat entry - snat or dnat</text>
          </description>
          <type name="nat-type"/>
          <default value="dnat"/>
        </leaf>
        <leaf name="twice_nat_id">
          <description>
            <text>Twice nat id for the static nat to achieve the twice nat</text>
          </description>
          <type name="uint16">
            <range value="1..9999">
              <error-message>
                <value>Invalid twice nat id for the static NAT.</value>
              </error-message>
              <error-app-tag value="twice-nat-id-invalid"/>
            </range>
          </type>
        </leaf>
      </list>
    </container>
    <container name="NAT_GLOBAL">
      <description>
        <text>Global NAT settings including admin mode and timeouts</text>
      </description>
      <container name="Values">
        <description>
          <text>Global NAT parameter values</text>
        </description>
        <leaf name="admin_mode">
          <description>
            <text>Admin mode of the NAT feature.</text>
          </description>
          <type name="stypes:admin_mode"/>
          <default value="disabled"/>
        </leaf>
        <leaf name="nat_timeout">
          <description>
            <text>Timeout for the nat entries within the range of 300 sec to 432000 secs.</text>
          </description>
          <type name="uint32">
            <range value="300..432000">
              <error-message>
                <value>Invalid NAT Timeout, valid range 300 sec to 432000 sec.</value>
              </error-message>
              <error-app-tag value="nat-timeout-invalid"/>
            </range>
          </type>
          <default value="600"/>
        </leaf>
        <leaf name="nat_tcp_timeout">
          <description>
            <text>Timeout for the nat tcp entries within the range of 300 sec to 432000 secs.</text>
          </description>
          <type name="uint32">
            <range value="300..432000">
              <error-message>
                <value>Invalid NAT TCP Timeout, valid range 300 sec to 432000 sec.</value>
              </error-message>
              <error-app-tag value="nat-tcp-timeout-invalid"/>
            </range>
          </type>
          <default value="86400"/>
        </leaf>
        <leaf name="nat_udp_timeout">
          <description>
            <text>Timeout for the nat udp entries within the range of 120 sec to 600 secs.</text>
          </description>
          <type name="uint16">
            <range value="120..600">
              <error-message>
                <value>Invalid NAT UDP Timeout, valid range 120 sec to 600 sec.</value>
              </error-message>
              <error-app-tag value="nat-udp-timeout-invalid"/>
            </range>
          </type>
          <default value="300"/>
        </leaf>
      </container>
    </container>
    <container name="NAT_POOL">
      <description>
        <text>NAT address pools defining IP and port ranges for dynamic NAT</text>
      </description>
      <list name="NAT_POOL_LIST">
        <key value="name"/>
        <max-elements value="16"/>
        <leaf name="name">
          <description>
            <text>Key - Name of the NAT Pool</text>
          </description>
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for the pool name.</value>
              </error-message>
              <error-app-tag value="pool-name-invalid-length"/>
            </length>
          </type>
        </leaf>
        <leaf name="nat_ip">
          <description>
            <text>Single IP address or a range of addresses for a NAT pool.</text>
          </description>
          <mandatory value="true"/>
          <type name="ip-address-range"/>
        </leaf>
        <leaf name="nat_port">
          <description>
            <text>Range of port values for a NAT pool.</text>
          </description>
          <type name="string">
            <pattern value="(([0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-4])(-)([0-9]{1,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))"/>
          </type>
        </leaf>
      </list>
    </container>
    <container name="NAT_BINDINGS">
      <description>
        <text>NAT bindings associating ACLs with NAT pools for dynamic translation</text>
      </description>
      <list name="NAT_BINDINGS_LIST">
        <key value="name"/>
        <max-elements value="16"/>
        <leaf name="name">
          <description>
            <text>Key - Name of the NAT Binding</text>
          </description>
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for the binding name.</value>
              </error-message>
              <error-app-tag value="binding-name-invalid-length"/>
            </length>
          </type>
        </leaf>
        <leaf name="nat_pool">
          <description>
            <text>NAT Pool name mapping for the binding</text>
          </description>
          <mandatory value="true"/>
          <type name="leafref">
            <path value="../../../NAT_POOL/NAT_POOL_LIST/name"/>
          </type>
        </leaf>
        <leaf name="nat_type">
          <description>
            <text>Nat type for the binding - snat or dnat</text>
          </description>
          <type name="nat-type"/>
          <default value="snat"/>
        </leaf>
        <leaf name="twice_nat_id">
          <description>
            <text>Twice nat id for the binding to achieve the Dynamic twice nat</text>
          </description>
          <type name="uint16">
            <range value="1..9999">
              <error-message>
                <value>Invalid twice nat id for the binding.</value>
              </error-message>
              <error-app-tag value="twice-nat-id-invalid"/>
            </range>
          </type>
        </leaf>
      </list>
    </container>
  </container>
</module>
