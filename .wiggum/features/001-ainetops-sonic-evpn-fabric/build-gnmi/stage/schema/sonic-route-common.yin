<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-route-common"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:rtcmn="http://github.com/sonic-net/sonic-route-common"
        xmlns:vrf="http://github.com/sonic-net/sonic-vrf"
        xmlns:rmap="http://github.com/sonic-net/sonic-route-map">
  <namespace uri="http://github.com/sonic-net/sonic-route-common"/>
  <prefix value="rtcmn"/>
  <yang-version value="1.1"/>
  <import module="sonic-vrf">
    <prefix value="vrf"/>
  </import>
  <import module="sonic-route-map">
    <prefix value="rmap"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC ROUTE common YANG</text>
  </description>
  <revision date="2021-02-26">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-route-common">
    <container name="ROUTE_REDISTRIBUTE">
      <list name="ROUTE_REDISTRIBUTE_LIST">
        <key value="vrf_name src_protocol dst_protocol addr_family"/>
        <leaf name="vrf_name">
          <type name="union">
            <type name="string">
              <pattern value="default"/>
            </type>
            <type name="leafref">
              <path value="/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name"/>
            </type>
          </type>
          <description>
            <text>VRF name</text>
          </description>
        </leaf>
        <leaf name="src_protocol">
          <type name="string"/>
          <description>
            <text>IP protocols such as connected, ospf and static</text>
          </description>
        </leaf>
        <leaf name="dst_protocol">
          <type name="string"/>
          <description>
            <text>IP protocol such as bgp</text>
          </description>
        </leaf>
        <leaf name="addr_family">
          <type name="string"/>
          <description>
            <text>Address family ipv4/ipv6</text>
          </description>
        </leaf>
        <leaf-list name="route_map">
          <type name="leafref">
            <path value="/rmap:sonic-route-map/rmap:ROUTE_MAP_SET/rmap:ROUTE_MAP_SET_LIST/rmap:name"/>
          </type>
          <ordered-by value="user"/>
          <max-elements value="1"/>
          <description>
            <text>Router filter to apply while redistributing the routes from another protocol.</text>
          </description>
        </leaf-list>
        <leaf name="metric">
          <type name="uint32"/>
          <description>
            <text>Metric for redistributed routes</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
