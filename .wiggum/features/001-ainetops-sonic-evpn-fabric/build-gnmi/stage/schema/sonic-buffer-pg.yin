<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-buffer-pg"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bpg="http://github.com/sonic-net/sonic-buffer-pg"
        xmlns:prt="http://github.com/sonic-net/sonic-port"
        xmlns:bpf="http://github.com/sonic-net/sonic-buffer-profile">
  <namespace uri="http://github.com/sonic-net/sonic-buffer-pg"/>
  <prefix value="bpg"/>
  <yang-version value="1.1"/>
  <import module="sonic-port">
    <prefix value="prt"/>
  </import>
  <import module="sonic-buffer-profile">
    <prefix value="bpf"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>Ingress buffer priority group configuration for SONiC ports.</text>
  </description>
  <revision date="2021-07-01">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-buffer-pg">
    <container name="BUFFER_PG">
      <description>
        <text>Configures ingress buffer allocation per priority group on a port.</text>
      </description>
      <list name="BUFFER_PG_LIST">
        <key value="port pg_num"/>
        <description>
          <text>Buffer priority group entry for a specific port and priority group range.</text>
        </description>
        <leaf name="port">
          <type name="leafref">
            <path value="/prt:sonic-port/prt:PORT/prt:PORT_LIST/prt:name"/>
          </type>
          <description>
            <text>Port on which the buffer priority group is configured.</text>
          </description>
        </leaf>
        <leaf name="pg_num">
          <type name="string">
            <pattern value="[0-7]((-)[0-7])?">
              <error-message>
                <value>Invalid Buffer PG number</value>
              </error-message>
              <error-app-tag value="pg-num-invalid"/>
            </pattern>
          </type>
          <description>
            <text>Priority Group number</text>
          </description>
        </leaf>
        <leaf name="profile">
          <default value="0"/>
          <type name="union">
            <type name="leafref">
              <path value="/bpf:sonic-buffer-profile/bpf:BUFFER_PROFILE/bpf:BUFFER_PROFILE_LIST/bpf:name"/>
            </type>
            <type name="string">
              <pattern value="NULL"/>
            </type>
          </type>
          <description>
            <text>Buffer Profile associated with Priority Group number for a port</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
