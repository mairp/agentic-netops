<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-vnet"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:svnet="http://github.com/sonic-net/sonic-vnet"
        xmlns:yang="urn:ietf:params:xml:ns:yang:ietf-yang-types"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:svxlan="http://github.com/sonic-net/sonic-vxlan">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-vnet"/>
  <prefix value="svnet"/>
  <import module="ietf-yang-types">
    <prefix value="yang"/>
  </import>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <import module="sonic-vxlan">
    <prefix value="svxlan"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>Virtual Network (VNET) configuration for overlay networking using VxLAN tunnels</text>
  </description>
  <revision date="2023-04-25">
    <description>
      <text>First revision.</text>
    </description>
  </revision>
  <container name="sonic-vnet">
    <container name="VNET">
      <description>
        <text>Virtual Network configuration table for overlay networking</text>
      </description>
      <list name="VNET_LIST">
        <description>
          <text>Configuration entry for a Virtual Network instance</text>
        </description>
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Unique alphanumeric name identifying the virtual network</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="vxlan_tunnel">
          <mandatory value="true"/>
          <description>
            <text>A valid and active vxlan tunnel to be used with this vnet for traffic encapsulation.</text>
          </description>
          <type name="leafref">
            <path value="/svxlan:sonic-vxlan/svxlan:VXLAN_TUNNEL/svxlan:VXLAN_TUNNEL_LIST/svxlan:name"/>
          </type>
        </leaf>
        <leaf name="vni">
          <mandatory value="true"/>
          <description>
            <text>A valid and unique vni which will become part of the encapsulated traffic header.</text>
          </description>
          <type name="stypes:vnid_type"/>
        </leaf>
        <leaf name="peer_list">
          <description>
            <text>Set of peers</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="guid">
          <description>
            <text>An optional guid.</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="scope">
          <description>
            <text>can only be default.</text>
          </description>
          <type name="string">
            <pattern value="default">
              <error-message>
                <value>Invalid VRF name</value>
              </error-message>
            </pattern>
          </type>
        </leaf>
        <leaf name="advertise_prefix">
          <description>
            <text>Flag to enable advertisement of route prefixes belonging to the Vnet.</text>
          </description>
          <type name="boolean"/>
        </leaf>
        <leaf name="overlay_dmac">
          <description>
            <text>Overlay Dest MAC address to be used by Vnet ping.</text>
          </description>
          <type name="yang:mac-address"/>
        </leaf>
        <leaf name="src_mac">
          <description>
            <text>source mac address for the Vnet</text>
          </description>
          <type name="yang:mac-address"/>
        </leaf>
      </list>
    </container>
    <container name="VNET_ROUTE">
      <description>
        <text>Static routes within a virtual network</text>
      </description>
      <list name="VNET_ROUTE_LIST">
        <description>
          <text>Static route entry within a virtual network</text>
        </description>
        <key value="vnet_name prefix"/>
        <leaf name="vnet_name">
          <description>
            <text>VNET name</text>
          </description>
          <type name="leafref">
            <path value="/svnet:sonic-vnet/svnet:VNET/svnet:VNET_LIST/svnet:name"/>
          </type>
        </leaf>
        <leaf name="prefix">
          <description>
            <text>IPv4 prefix in CIDR format</text>
          </description>
          <type name="stypes:sonic-ip4-prefix"/>
        </leaf>
        <leaf name="nexthop">
          <description>
            <text>Nexthop IP addresses</text>
          </description>
          <type name="stypes:ipv4-address-list"/>
          <mandatory value="true"/>
        </leaf>
        <leaf name="ifname">
          <description>
            <text>Interface names</text>
          </description>
          <type name="string"/>
          <mandatory value="true"/>
        </leaf>
      </list>
    </container>
    <container name="VNET_ROUTE_TUNNEL">
      <description>
        <text>Tunnel-encapsulated routes within a virtual network</text>
      </description>
      <list name="VNET_ROUTE_TUNNEL_LIST">
        <description>
          <text>Tunnel-encapsulated route entry for overlay traffic within a virtual network</text>
        </description>
        <key value="vnet_name prefix"/>
        <leaf name="vnet_name">
          <description>
            <text>VNET name</text>
          </description>
          <type name="leafref">
            <path value="/svnet:sonic-vnet/svnet:VNET/svnet:VNET_LIST/svnet:name"/>
          </type>
        </leaf>
        <leaf name="prefix">
          <description>
            <text>IPv4 prefix in CIDR format</text>
          </description>
          <type name="stypes:sonic-ip4-prefix"/>
        </leaf>
        <leaf name="endpoint">
          <description>
            <text>Endpoint/nexthop tunnel IPs</text>
          </description>
          <type name="stypes:ipv4-address-list"/>
          <mandatory value="true"/>
        </leaf>
        <leaf name="mac_address">
          <description>
            <text>Inner dest macs in encapsulated packet</text>
          </description>
          <type name="stypes:mac-address-list"/>
        </leaf>
        <leaf name="vni">
          <description>
            <text>Valid and active vni values in encapsulated packet</text>
          </description>
          <type name="stypes:vnid-list"/>
        </leaf>
        <leaf name="consistent_hashing_buckets">
          <description>
            <text>Number of consistent hashing buckets to use, if consistent hashing is desired</text>
          </description>
          <type name="uint16"/>
        </leaf>
        <leaf name="metric">
          <description>
            <text>Value that can be set to categorize or determine the type of route. This value does not affect route behavior.</text>
          </description>
          <type name="uint8"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
