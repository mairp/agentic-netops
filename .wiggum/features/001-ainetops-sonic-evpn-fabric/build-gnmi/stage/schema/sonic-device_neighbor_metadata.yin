<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-device_neighbor_metadata"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:device_neighbor_metadata="http://github.com/sonic-net/sonic-device_neighbor_metadata"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-device_neighbor_metadata"/>
  <prefix value="device_neighbor_metadata"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>DEVICE_NEIGHBOR_METADATA YANG Module for SONiC OS</text>
  </description>
  <revision date="2022-08-25">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-device_neighbor_metadata">
    <container name="DEVICE_NEIGHBOR_METADATA">
      <description>
        <text>Metadata about neighbor devices including HWSKU, type, and management addresses</text>
      </description>
      <list name="DEVICE_NEIGHBOR_METADATA_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Host name string, max length 255</text>
          </description>
          <type name="string">
            <length value="1..255"/>
          </type>
        </leaf>
        <leaf name="cluster">
          <description>
            <text>The switch is a member of this cluster</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="hwsku">
          <description>
            <text>Hardware SKU of the neighbor device</text>
          </description>
          <type name="stypes:hwsku"/>
        </leaf>
        <leaf name="lo_addr">
          <description>
            <text>Device loopback ipv4 address, type of ietf-inet
ipv4-prefix or ipv4-address</text>
          </description>
          <type name="union">
            <type name="inet:ipv4-prefix"/>
            <type name="inet:ipv4-address"/>
          </type>
        </leaf>
        <leaf name="lo_addr_v6">
          <description>
            <text>Device loopback ipv6 address, type of ietf-inet
ipv6-prefix or ipv6-address</text>
          </description>
          <type name="union">
            <type name="inet:ipv6-prefix"/>
            <type name="inet:ipv6-address"/>
          </type>
        </leaf>
        <leaf name="mgmt_addr">
          <description>
            <text>Device management ipv4 address, type of ietf-inet
ipv4-prefix or ipv4-address</text>
          </description>
          <type name="union">
            <type name="inet:ipv4-prefix"/>
            <type name="inet:ipv4-address"/>
          </type>
        </leaf>
        <leaf name="mgmt_addr_v6">
          <description>
            <text>Device management ipv6 address, type of ietf-inet
ipv6-prefix or ipv6-address</text>
          </description>
          <type name="union">
            <type name="inet:ipv6-prefix"/>
            <type name="inet:ipv6-address"/>
          </type>
        </leaf>
        <leaf name="type">
          <description>
            <text>Network element type</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="deployment_id">
          <description>
            <text>Deployment identifier for the neighbor device</text>
          </description>
          <type name="uint32"/>
        </leaf>
        <leaf name="slice_type">
          <description>
            <text>Metadata tag for the device.</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="resource_type">
          <description>
            <text>Resource type of the neighbor device (e.g., Storage, Compute).</text>
          </description>
          <type name="string"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
