<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-tc-queue-map"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:tqm="http://github.com/sonic-net/sonic-tc-queue-map"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-tc-queue-map"/>
  <prefix value="tqm"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>TC_TO_QUEUE_MAP yang Module for SONiC OS</text>
  </description>
  <revision date="2021-04-15">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-tc-queue-map">
    <container name="TC_TO_QUEUE_MAP">
      <description>
        <text>Maps traffic class to egress queue for packet scheduling.</text>
      </description>
      <list name="TC_TO_QUEUE_MAP_LIST">
        <key value="name"/>
        <description>
          <text>A named traffic class to egress queue map.</text>
        </description>
        <leaf name="name">
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for map name.</value>
              </error-message>
              <error-app-tag value="map-name-invalid-length"/>
            </length>
          </type>
          <description>
            <text>Name of the TC to queue map.</text>
          </description>
        </leaf>
        <list name="TC_TO_QUEUE_MAP">
          <key value="tc"/>
          <description>
            <text>Single mapping entry from a traffic class to an egress queue.</text>
          </description>
          <leaf name="tc">
            <type name="stypes:tc_type"/>
            <description>
              <text>Source traffic class.</text>
            </description>
          </leaf>
          <leaf name="qindex">
            <type name="string">
              <pattern value="[0-9]?">
                <error-message>
                  <value>Invalid queue index</value>
                </error-message>
                <error-app-tag value="queue-index-invalid"/>
              </pattern>
            </type>
            <description>
              <text>Target egress queue index (0-9).</text>
            </description>
          </leaf>
        </list>
      </list>
    </container>
  </container>
</module>
