<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-fabric-monitor"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:fabric-monitor="http://github.com/sonic-net/sonic-fabric-monitor"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-fabric-monitor"/>
  <prefix value="fabric-monitor"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>FABRIC_MONITOR yang Module for SONiC OS</text>
  </description>
  <revision date="2023-03-14">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-fabric-monitor">
    <container name="FABRIC_MONITOR">
      <description>
        <text>Fabric link monitoring thresholds and isolation parameters</text>
      </description>
      <container name="FABRIC_MONITOR_DATA">
        <leaf name="monErrThreshCrcCells">
          <type name="uint32"/>
          <default value="1"/>
          <description>
            <text>The number of cells with errors.</text>
          </description>
        </leaf>
        <leaf name="monErrThreshRxCells">
          <type name="uint32"/>
          <default value="61035156"/>
          <description>
            <text>The number of cells received. If more than monErrThreshCrcCells out of monErrThreshRxCells seen with errors, the fabric port needs to be isolated</text>
          </description>
        </leaf>
        <leaf name="monPollThreshIsolation">
          <type name="uint8">
            <range value="1..10"/>
          </type>
          <default value="1"/>
          <description>
            <text>Consecutive polls with higher error rate for isolation.</text>
          </description>
        </leaf>
        <leaf name="monPollThreshRecovery">
          <type name="uint8">
            <range value="1..10"/>
          </type>
          <default value="8"/>
          <description>
            <text>Consecutive polls with lesser error rate for inclusion.</text>
          </description>
        </leaf>
        <leaf name="monCapacityThreshWarn">
          <type name="uint8">
            <range value="5..100"/>
          </type>
          <default value="10"/>
          <description>
            <text>Percentage of up fabric links.</text>
          </description>
        </leaf>
        <leaf name="monState">
          <description>
            <text>Configuration to set fabric link monitoring state: enable/disable</text>
          </description>
          <type name="stypes:mode-status"/>
          <default value="disable"/>
        </leaf>
      </container>
    </container>
  </container>
</module>
