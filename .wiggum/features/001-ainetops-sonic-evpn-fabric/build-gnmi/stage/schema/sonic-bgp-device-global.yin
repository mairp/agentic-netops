<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bgp-device-global"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bgp_device_global="http://github.com/sonic-net/sonic-bgp-device-global">
  <namespace uri="http://github.com/sonic-net/sonic-bgp-device-global"/>
  <prefix value="bgp_device_global"/>
  <yang-version value="1.1"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC Device-specific BGP global data</text>
  </description>
  <revision date="2024-01-28">
    <description>
      <text>Add Weighted ECMP using BGP link bandwidth</text>
    </description>
  </revision>
  <revision date="2022-06-26">
    <description>
      <text>Initial revision</text>
    </description>
  </revision>
  <container name="sonic-bgp-device-global">
    <container name="BGP_DEVICE_GLOBAL">
      <description>
        <text>Device-level BGP global settings such as TSA, WCMP, and IDF isolation.</text>
      </description>
      <container name="STATE">
        <description>
          <text>BGP device-specific global data</text>
        </description>
        <leaf name="tsa_enabled">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>When set to true, Traffic is shifted away (TSA), i.e, BGP routes are not advertised to neighboring routers</text>
          </description>
        </leaf>
        <leaf name="wcmp_enabled">
          <description>
            <text>Enables/Disables Weighted-Equal Cost-Multipath using BGP link bandwidth</text>
          </description>
          <type name="boolean"/>
          <default value="false"/>
        </leaf>
        <leaf name="idf_isolation_state">
          <description>
            <text>Configures device IDF isolation state</text>
          </description>
          <type name="enumeration">
            <enum name="isolated_no_export">
              <description>
                <text>IDF isolated using no-export community tag</text>
              </description>
            </enum>
            <enum name="isolated_withdraw_all">
              <description>
                <text>IDF isolated by withdrawing routes</text>
              </description>
            </enum>
            <enum name="unisolated">
              <description>
                <text>IDF un-isolated</text>
              </description>
            </enum>
          </type>
          <default value="unisolated"/>
        </leaf>
      </container>
      <container name="CONFED">
        <description>
          <text>BGP Confederation related configuration</text>
        </description>
        <leaf name="asn">
          <type name="uint32">
            <range value="1..4294967295"/>
          </type>
          <description>
            <text>Autonomous System Number for BGP confederation</text>
          </description>
        </leaf>
        <leaf name="peers">
          <type name="string"/>
          <description>
            <text>List of sub-ASNs in the confederation separated by semi-colon</text>
          </description>
        </leaf>
      </container>
    </container>
  </container>
</module>
