<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-voq-inband-interface"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:voq-inband-intf="http://github.com/sonic-net/sonic-voq-inband-interface"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <namespace uri="http://github.com/sonic-net/sonic-voq-inband-interface"/>
  <prefix value="voq-inband-intf"/>
  <yang-version value="1.1"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONIC BGP Internal Neighbor for voq chassis platforms</text>
  </description>
  <revision date="2022-10-06">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-voq-inband-interface">
    <container name="VOQ_INBAND_INTERFACE">
      <description>
        <text>VOQ inband interface in VOQ Chassis</text>
      </description>
      <list name="VOQ_INBAND_INTERFACE_LIST">
        <key value="name"/>
        <leaf name="name">
          <description>
            <text>Inband interface name for inter-linecard communication</text>
          </description>
          <type name="string">
            <pattern value="Ethernet-IB[0-9]+"/>
          </type>
        </leaf>
        <leaf name="inband_type">
          <description>
            <text>Type of inband interface</text>
          </description>
          <type name="string">
            <pattern value="port|Port"/>
          </type>
          <default value="port"/>
        </leaf>
      </list>
      <list name="VOQ_INBAND_INTERFACE_IPPREFIX_LIST">
        <description>
          <text>Prefix for VOQ_INBAND_INTERFACE</text>
        </description>
        <key value="name ip-prefix"/>
        <leaf name="name">
          <type name="leafref">
            <path value="../../VOQ_INBAND_INTERFACE_LIST/name"/>
          </type>
        </leaf>
        <leaf name="ip-prefix">
          <description>
            <text>IP prefix assigned to the inband interface</text>
          </description>
          <type name="stypes:sonic-ip-prefix"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
