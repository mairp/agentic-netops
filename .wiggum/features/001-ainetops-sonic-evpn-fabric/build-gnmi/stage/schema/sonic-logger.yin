<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-logger"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:logger="http://github.com/Azure/sonic-logger"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/Azure/sonic-logger"/>
  <prefix value="logger"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>Per-component log verbosity and output configuration YANG module for SONiC OS.</text>
  </description>
  <typedef name="swss_loglevel">
    <type name="enumeration">
      <enum name="EMERG"/>
      <enum name="ALERT"/>
      <enum name="CRIT"/>
      <enum name="ERROR"/>
      <enum name="WARN"/>
      <enum name="NOTICE"/>
      <enum name="INFO"/>
      <enum name="DEBUG"/>
    </type>
  </typedef>
  <typedef name="sai_loglevel">
    <type name="enumeration">
      <enum name="SAI_LOG_LEVEL_CRITICAL"/>
      <enum name="SAI_LOG_LEVEL_ERROR"/>
      <enum name="SAI_LOG_LEVEL_WARN"/>
      <enum name="SAI_LOG_LEVEL_NOTICE"/>
      <enum name="SAI_LOG_LEVEL_INFO"/>
      <enum name="SAI_LOG_LEVEL_DEBUG"/>
    </type>
  </typedef>
  <container name="sonic-logger">
    <container name="LOGGER">
      <description>
        <text>Per-component logging configuration.</text>
      </description>
      <list name="LOGGER_LIST">
        <key value="name"/>
        <description>
          <text>A logger entry keyed by component name.</text>
        </description>
        <leaf name="name">
          <description>
            <text>Name of the SONiC component (e.g. orchagent, syncd, SAI modules).</text>
          </description>
          <type name="string"/>
        </leaf>
        <leaf name="LOGLEVEL">
          <description>
            <text>The log verbosity for the component</text>
          </description>
          <mandatory value="true"/>
          <type name="union">
            <type name="swss_loglevel"/>
            <type name="sai_loglevel"/>
          </type>
        </leaf>
        <leaf name="LOGOUTPUT">
          <type name="enumeration">
            <enum name="SYSLOG"/>
            <enum name="STDOUT"/>
            <enum name="STDERR"/>
          </type>
          <default value="SYSLOG"/>
          <description>
            <text>Destination for log output (SYSLOG, STDOUT, or STDERR).</text>
          </description>
        </leaf>
        <leaf name="require_manual_refresh">
          <type name="stypes:boolean_type"/>
          <description>
            <text>When true, log level changes require a SIGHUP to the process to take effect.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
