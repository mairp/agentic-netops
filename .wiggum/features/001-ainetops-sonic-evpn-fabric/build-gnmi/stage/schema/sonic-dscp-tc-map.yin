<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-dscp-tc-map"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:dtm="http://github.com/sonic-net/sonic-dscp-tc-map"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-dscp-tc-map"/>
  <prefix value="dtm"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>DSCP_TO_TC_MAP yang Module for SONiC OS</text>
  </description>
  <revision date="2021-04-15">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-dscp-tc-map">
    <container name="DSCP_TO_TC_MAP">
      <description>
        <text>Maps DSCP values (0-63) to traffic class for ingress QoS classification.</text>
      </description>
      <list name="DSCP_TO_TC_MAP_LIST">
        <key value="name"/>
        <description>
          <text>A named DSCP to traffic class map.</text>
        </description>
        <leaf name="name">
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for map name.</value>
              </error-message>
              <error-app-tag value="map-name-invalid-length"/>
            </length>
          </type>
          <description>
            <text>Name of the DSCP to TC map.</text>
          </description>
        </leaf>
        <list name="DSCP_TO_TC_MAP">
          <key value="dscp"/>
          <description>
            <text>Single mapping entry from a DSCP value to a traffic class.</text>
          </description>
          <leaf name="dscp">
            <type name="string">
              <pattern value="6[0-3]|[1-5][0-9]?|[0-9]?">
                <error-message>
                  <value>Invalid DSCP</value>
                </error-message>
                <error-app-tag value="dscp-invalid"/>
              </pattern>
            </type>
            <description>
              <text>DSCP value (0-63).</text>
            </description>
          </leaf>
          <leaf name="tc">
            <type name="stypes:tc_type"/>
            <description>
              <text>Target traffic class.</text>
            </description>
          </leaf>
        </list>
      </list>
    </container>
  </container>
</module>
