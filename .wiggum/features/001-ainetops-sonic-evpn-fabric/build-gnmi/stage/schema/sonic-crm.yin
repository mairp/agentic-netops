            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv4_nexthop_low_threshold">
          <description>
            <text>Lower threshold for IPv4 next-hop resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv4_route_threshold_type">
          <description>
            <text>Threshold type for monitoring IPv4 route entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../ipv4_route_high_threshold&lt;100 and&#10;../ipv4_route_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="ipv4_route_high_threshold">
          <description>
            <text>Upper threshold for IPv4 route entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../ipv4_route_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv4_route_low_threshold">
          <description>
            <text>Lower threshold for IPv4 route entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv6_neighbor_threshold_type">
          <description>
            <text>Threshold type for monitoring IPv6 neighbor discovery entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../ipv6_neighbor_high_threshold&lt;100 and&#10;../ipv6_neighbor_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="ipv6_neighbor_high_threshold">
          <description>
            <text>Upper threshold for IPv6 neighbor discovery entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../ipv6_neighbor_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv6_neighbor_low_threshold">
