          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv6_nexthop_threshold_type">
          <description>
            <text>Threshold type for monitoring IPv6 next-hop resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../ipv6_nexthop_high_threshold&lt;100 and&#10;../ipv6_nexthop_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="ipv6_nexthop_high_threshold">
          <description>
            <text>Upper threshold for IPv6 next-hop resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../ipv6_nexthop_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv6_nexthop_low_threshold">
          <description>
            <text>Lower threshold for IPv6 next-hop resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv6_route_threshold_type">
          <description>
            <text>Threshold type for monitoring IPv6 route entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../ipv6_route_high_threshold&lt;100 and&#10;../ipv6_route_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="ipv6_route_high_threshold">
          <description>
            <text>Upper threshold for IPv6 route entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../ipv6_route_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv6_route_low_threshold">
          <description>
            <text>Lower threshold for IPv6 route entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="nexthop_group_threshold_type">
          <description>
            <text>Threshold type for monitoring ECMP next-hop group resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../nexthop_group_high_threshold&lt;100 and&#10;../nexthop_group_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="nexthop_group_high_threshold">
          <description>
            <text>Upper threshold for ECMP next-hop group resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../nexthop_group_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="nexthop_group_low_threshold">
          <description>
            <text>Lower threshold for ECMP next-hop group resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="nexthop_group_member_threshold_type">
          <description>
            <text>Threshold type for monitoring ECMP next-hop group member resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../nexthop_group_member_high_threshold&lt;100 and&#10;../nexthop_group_member_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="nexthop_group_member_high_threshold">
          <description>
            <text>Upper threshold for ECMP next-hop group member resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../nexthop_group_member_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="nexthop_group_member_low_threshold">
          <description>
            <text>Lower threshold for ECMP next-hop group member resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="polling_interval">
          <description>
            <text>Interval in seconds between CRM resource usage polling cycles</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="dnat_entry_threshold_type">
          <description>
            <text>Threshold type for monitoring destination NAT entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../dnat_entry_high_threshold&lt;100 and&#10;../dnat_entry_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="dnat_entry_high_threshold">
          <description>
            <text>Upper threshold for DNAT entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../dnat_entry_low_threshold)">
