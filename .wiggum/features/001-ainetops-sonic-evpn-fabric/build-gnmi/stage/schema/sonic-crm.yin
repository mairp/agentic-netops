        <leaf name="ipmc_entry_low_threshold">
          <description>
            <text>Lower threshold for IP multicast entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="mpls_inseg_threshold_type">
          <description>
            <text>CRM threshold support for MPLS in-segment entries</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../mpls_inseg_high_threshold&lt;100 and&#10;../mpls_inseg_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="mpls_inseg_high_threshold">
          <description>
            <text>CRM threshold support for MPLS in-segment entries</text>
          </description>
          <must condition="(current() &gt; ../mpls_inseg_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="mpls_inseg_low_threshold">
          <description>
            <text>CRM threshold support for MPLS in-segment entries</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="mpls_nexthop_threshold_type">
          <description>
            <text>CRM threshold support for MPLS next-hops</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../mpls_nexthop_high_threshold&lt;100 and&#10;../mpls_nexthop_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="mpls_nexthop_high_threshold">
          <description>
            <text>CRM threshold support for MPLS next-hops</text>
          </description>
          <must condition="(current() &gt; ../mpls_nexthop_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="mpls_nexthop_low_threshold">
          <description>
            <text>CRM threshold support for MPLS next-hops</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="srv6_my_sid_entry_threshold_type">
          <description>
            <text>CRM threshold support for SRV6 my_sid entries</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../srv6_my_sid_entry_high_threshold&lt;100 and&#10;../srv6_my_sid_entry_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="srv6_my_sid_entry_high_threshold">
          <description>
            <text>CRM threshold support for SRV6 my_sid entries</text>
          </description>
          <must condition="(current() &gt; ../srv6_my_sid_entry_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="srv6_my_sid_entry_low_threshold">
          <description>
            <text>CRM threshold support for SRV6 my_sid entries</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="srv6_nexthop_threshold_type">
          <description>
            <text>CRM threshold support for SRV6 next-hops</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../srv6_nexthop_high_threshold&lt;100 and&#10;../srv6_nexthop_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="srv6_nexthop_high_threshold">
          <description>
            <text>CRM threshold support for SRV6 next-hops</text>
          </description>
          <must condition="(current() &gt; ../srv6_nexthop_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="srv6_nexthop_low_threshold">
          <description>
            <text>CRM threshold support for SRV6 next-hops</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="dash_vnet_threshold_type">
          <description>
            <text>CRM threshold support for DASH VNETs</text>
          </description>
          <when condition="(/dm:sonic-device_metadata/dm:DEVICE_METADATA/dm:localhost/dm:switch_type = 'dpu')"/>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../dash_vnet_high_threshold&lt;100 and&#10;../dash_vnet_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="dash_vnet_high_threshold">
          <description>
            <text>CRM threshold support for DASH VNETs</text>
          </description>
