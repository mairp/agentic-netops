        </leaf>
        <leaf name="dnat_entry_low_threshold">
          <description>
            <text>Lower threshold for DNAT entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="snat_entry_threshold_type">
          <description>
            <text>Threshold type for monitoring source NAT entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../snat_entry_high_threshold&lt;100 and&#10;../snat_entry_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="snat_entry_high_threshold">
          <description>
            <text>Upper threshold for SNAT entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../snat_entry_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="snat_entry_low_threshold">
          <description>
            <text>Lower threshold for SNAT entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipmc_entry_threshold_type">
          <description>
            <text>Threshold type for monitoring IP multicast entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../ipmc_entry_high_threshold&lt;100 and&#10;../ipmc_entry_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="ipmc_entry_high_threshold">
          <description>
            <text>Upper threshold for IP multicast entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../ipmc_entry_low_threshold)">
