<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-crm"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:crm="http://github.com/sonic-net/sonic-crm"
        xmlns:stypes="http://github.com/sonic-net/sonic-head"
        xmlns:dm="http://github.com/sonic-net/sonic-device_metadata">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-crm"/>
  <prefix value="crm"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <import module="sonic-device_metadata">
    <prefix value="dm"/>
  </import>
  <description>
    <text>CRM YANG Module for SONiC OS</text>
  </description>
  <revision date="2020-04-10">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-crm">
    <container name="CRM">
      <description>
        <text>Critical Resource Monitoring configuration for tracking ASIC hardware resource utilization</text>
      </description>
      <container name="Config">
        <typedef name="threshold">
          <description>
            <text>Threshold value representing a percentage or absolute resource count for CRM monitoring</text>
          </description>
          <type name="uint16"/>
        </typedef>
        <leaf name="acl_counter_threshold_type">
          <description>
            <text>Threshold type for monitoring ACL counter resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../acl_counter_high_threshold&lt;100 and&#10;../acl_counter_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="acl_counter_high_threshold">
          <description>
            <text>Upper threshold for ACL counter resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../acl_counter_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="acl_counter_low_threshold">
          <description>
            <text>Lower threshold for ACL counter resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="acl_group_threshold_type">
          <description>
            <text>Threshold type for monitoring ACL group (bind point) resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../acl_group_high_threshold&lt;100 and&#10;../acl_group_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="acl_group_high_threshold">
          <description>
            <text>Upper threshold for ACL group resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../acl_group_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="acl_group_low_threshold">
          <description>
            <text>Lower threshold for ACL group resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="acl_entry_threshold_type">
          <description>
            <text>Threshold type for monitoring ACL rule entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../acl_entry_high_threshold&lt;100 and&#10;../acl_entry_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="acl_entry_high_threshold">
          <description>
            <text>Upper threshold for ACL rule entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../acl_entry_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="acl_entry_low_threshold">
          <description>
            <text>Lower threshold for ACL rule entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="acl_table_threshold_type">
          <description>
            <text>Threshold type for monitoring ACL table resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../acl_table_high_threshold&lt;100 and&#10;../acl_table_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="acl_table_high_threshold">
          <description>
            <text>Upper threshold for ACL table resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../acl_table_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="acl_table_low_threshold">
          <description>
            <text>Lower threshold for ACL table resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="fdb_entry_threshold_type">
          <description>
            <text>Threshold type for monitoring MAC forwarding database entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../fdb_entry_high_threshold&lt;100 and&#10;../fdb_entry_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="fdb_entry_high_threshold">
          <description>
            <text>Upper threshold for FDB entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../fdb_entry_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="fdb_entry_low_threshold">
          <description>
            <text>Lower threshold for FDB entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv4_neighbor_threshold_type">
          <description>
            <text>Threshold type for monitoring IPv4 ARP neighbor entry resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../ipv4_neighbor_high_threshold&lt;100 and&#10;../ipv4_neighbor_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="ipv4_neighbor_high_threshold">
          <description>
            <text>Upper threshold for IPv4 ARP neighbor entry resources that triggers a THRESHOLD_EXCEEDED alert</text>
          </description>
          <must condition="(current() &gt; ../ipv4_neighbor_low_threshold)">
            <error-message>
              <value>high_threshold should be more than low_threshold</value>
            </error-message>
          </must>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv4_neighbor_low_threshold">
          <description>
            <text>Lower threshold for IPv4 ARP neighbor entry resources that triggers a THRESHOLD_CLEAR alert</text>
          </description>
          <type name="threshold"/>
        </leaf>
        <leaf name="ipv4_nexthop_threshold_type">
          <description>
            <text>Threshold type for monitoring IPv4 next-hop resources (percentage, used, or free)</text>
          </description>
          <must condition="(((current()='PERCENTAGE' or current()='percentage') and&#10;../ipv4_nexthop_high_threshold&lt;100 and&#10;../ipv4_nexthop_low_threshold&lt;100) or&#10;(current()!='PERCENTAGE' and current()!='percentage'))"/>
          <type name="stypes:crm_threshold_type"/>
        </leaf>
        <leaf name="ipv4_nexthop_high_threshold">
          <description>
            <text>Upper threshold for IPv4 next-hop resources that triggers a THRESHOLD_EXCEEDED alert</text>
