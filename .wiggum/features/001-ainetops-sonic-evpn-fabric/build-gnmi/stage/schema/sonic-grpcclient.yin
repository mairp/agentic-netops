<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-grpcclient"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:grpcclient="http://github.com/sonic-net/sonic-grpcclient">
  <namespace uri="http://github.com/sonic-net/sonic-grpcclient"/>
  <prefix value="grpcclient"/>
  <yang-version value="1.1"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>SONiC DualToR grpc client configuration data</text>
  </description>
  <revision date="2024-10-14">
    <description>
      <text>Initial revision</text>
    </description>
  </revision>
  <container name="sonic-grpcclient">
    <container name="GRPCCLIENT">
      <description>
        <text>DualToR gRPC client configuration for streaming to external collectors.</text>
      </description>
      <container name="config">
        <description>
          <text>Security and logging settings for the gRPC client.</text>
        </description>
        <leaf name="type">
          <type name="enumeration">
            <enum name="secure"/>
            <enum name="insecure"/>
          </type>
          <description>
            <text>grpc client security level. </text>
          </description>
        </leaf>
        <leaf name="auth_level">
          <type name="enumeration">
            <enum name="server"/>
            <enum name="client"/>
          </type>
          <description>
            <text>grpc client auth level. </text>
          </description>
        </leaf>
        <leaf name="log_level">
          <type name="enumeration">
            <enum name="info"/>
            <enum name="notice"/>
            <enum name="debug"/>
            <enum name="warning"/>
            <enum name="critical"/>
          </type>
          <description>
            <text>grpc client log level. </text>
          </description>
        </leaf>
      </container>
      <container name="certs">
        <description>
          <text>TLS certificate paths for the gRPC client.</text>
        </description>
        <leaf name="client_crt">
          <type name="string"/>
          <description>
            <text>grpc client certificate file name </text>
          </description>
        </leaf>
        <leaf name="client_key">
          <type name="string"/>
          <description>
            <text>grpc client key file name </text>
          </description>
        </leaf>
        <leaf name="ca_crt">
          <type name="string"/>
          <description>
            <text>grpc client root cert</text>
          </description>
        </leaf>
        <leaf name="grpc_ssl_credential">
          <type name="string"/>
          <description>
            <text>grpc client ssl credential</text>
          </description>
        </leaf>
      </container>
    </container>
  </container>
</module>
