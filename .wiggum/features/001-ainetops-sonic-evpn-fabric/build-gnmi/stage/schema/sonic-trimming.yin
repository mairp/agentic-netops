<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-trimming"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:trim="http://github.com/sonic-net/sonic-trimming">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-trimming"/>
  <prefix value="trim"/>
  <description>
    <text>TRIMMING YANG Module for SONiC OS</text>
  </description>
  <revision date="2024-11-01">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-trimming">
    <container name="SWITCH_TRIMMING">
      <description>
        <text>Global packet trimming settings for congestion telemetry.</text>
      </description>
      <container name="GLOBAL">
        <description>
          <text>System-wide packet trimming configuration.</text>
        </description>
        <leaf name="size">
          <description>
            <text>Size (in bytes) to trim eligible packet</text>
          </description>
          <type name="uint32"/>
        </leaf>
        <leaf name="dscp_value">
          <description>
            <text>DSCP value assigned to a packet after trimming.
When set to from-tc, the tc_value is used for mapping to the DSCP</text>
          </description>
          <type name="union">
            <type name="uint8">
              <range value="0..63">
                <error-message>
                  <value>Invalid DSCP value</value>
                </error-message>
                <error-app-tag value="dscp-invalid"/>
              </range>
            </type>
            <type name="string">
              <pattern value="from-tc"/>
            </type>
          </type>
        </leaf>
        <leaf name="tc_value">
          <description>
            <text>TC value assigned to a packet after trimming</text>
          </description>
          <type name="uint8"/>
        </leaf>
        <leaf name="queue_index">
          <description>
            <text>Queue index to use for transmission of a packet after trimming.
When set to dynamic, the dscp_value is used for mapping to the queue</text>
          </description>
          <type name="union">
            <type name="uint8"/>
            <type name="string">
              <pattern value="dynamic"/>
            </type>
          </type>
        </leaf>
      </container>
    </container>
  </container>
</module>
