<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-wred-profile"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:wrd="http://github.com/sonic-net/sonic-wred-profile">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-wred-profile"/>
  <prefix value="wrd"/>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>WRED_PROFILE yang Module for SONiC OS</text>
  </description>
  <revision date="2021-04-01">
    <description>
      <text>Initial revision.</text>
    </description>
  </revision>
  <container name="sonic-wred-profile">
    <container name="WRED_PROFILE">
      <description>
        <text>Configures Weighted Random Early Detection profiles for congestion avoidance.</text>
      </description>
      <list name="WRED_PROFILE_LIST">
        <key value="name"/>
        <description>
          <text>A named WRED profile with per-color thresholds and drop probabilities.</text>
        </description>
        <leaf name="name">
          <type name="string">
            <pattern value="[a-zA-Z0-9]{1}([-a-zA-Z0-9_]{0,31})"/>
            <length value="1..32">
              <error-message>
                <value>Invalid length for wred profile name.</value>
              </error-message>
              <error-app-tag value="wred-profile-name-invalid-length"/>
            </length>
          </type>
          <description>
            <text>WRED profile name</text>
          </description>
        </leaf>
        <leaf name="yellow_min_threshold">
          <type name="uint64"/>
          <units name="bytes"/>
          <description>
            <text>Queue depth in bytes at which WRED begins dropping yellow-colored packets.</text>
          </description>
        </leaf>
        <leaf name="green_min_threshold">
          <type name="uint64"/>
          <units name="bytes"/>
          <description>
            <text>Queue depth in bytes at which WRED begins dropping green-colored packets.</text>
          </description>
        </leaf>
        <leaf name="red_min_threshold">
          <type name="uint64"/>
          <units name="bytes"/>
          <description>
            <text>Queue depth in bytes at which WRED begins dropping red-colored packets.</text>
          </description>
        </leaf>
        <leaf name="yellow_max_threshold">
          <type name="uint64"/>
          <units name="bytes"/>
          <must condition="(current() &gt;= current()/../yellow_min_threshold)">
            <error-message>
              <value>Yellow max threshold must be greater than or equal to min threshold</value>
            </error-message>
          </must>
          <description>
            <text>Queue depth in bytes at which WRED drops all yellow-colored packets.</text>
          </description>
        </leaf>
        <leaf name="green_max_threshold">
          <type name="uint64"/>
          <units name="bytes"/>
          <must condition="(current() &gt;= current()/../green_min_threshold)">
            <error-message>
              <value>Green max threshold must be greater than or equal to min threshold</value>
            </error-message>
          </must>
          <description>
            <text>Queue depth in bytes at which WRED drops all green-colored packets.</text>
          </description>
        </leaf>
        <leaf name="red_max_threshold">
          <type name="uint64"/>
          <units name="bytes"/>
          <must condition="(current() &gt;= current()/../red_min_threshold)">
            <error-message>
              <value>Red max threshold must be greater than or equal to min threshold</value>
            </error-message>
          </must>
          <description>
            <text>Queue depth in bytes at which WRED drops all red-colored packets.</text>
          </description>
        </leaf>
        <leaf name="ecn">
          <type name="enumeration">
            <enum name="ecn_none">
              <description>
                <text>Disable ECN marking for all colors.</text>
              </description>
            </enum>
            <enum name="ecn_green">
              <description>
                <text>Enable ECN marking for green color. Yellow and red are disabled.</text>
              </description>
            </enum>
            <enum name="ecn_yellow">
              <description>
                <text>Enable ECN marking for yellow color. Green and red are disabled.</text>
              </description>
            </enum>
            <enum name="ecn_red">
              <description>
                <text>Enable ECN marking for red color. Green and red are disabled.</text>
              </description>
            </enum>
            <enum name="ecn_green_yellow">
              <description>
                <text>Enable ECN marking for green and yellow colors. Red is disabled.</text>
              </description>
            </enum>
            <enum name="ecn_green_red">
              <description>
                <text>Enable ECN marking for green and red colors. Yellow is disabled.</text>
              </description>
            </enum>
            <enum name="ecn_yellow_red">
              <description>
                <text>Enable ECN marking for yellow and red colors. Green is disabled.</text>
              </description>
            </enum>
            <enum name="ecn_all">
              <description>
                <text>Enable ECN marking for all colors.</text>
              </description>
            </enum>
          </type>
          <default value="ecn_none"/>
          <description>
            <text>ECN mode</text>
          </description>
        </leaf>
        <leaf name="wred_green_enable">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Enable WRED for green-colored traffic.</text>
          </description>
        </leaf>
        <leaf name="wred_yellow_enable">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Enable WRED for yellow-colored traffic.</text>
          </description>
        </leaf>
        <leaf name="wred_red_enable">
          <type name="boolean"/>
          <default value="false"/>
          <description>
            <text>Enable WRED for red-colored traffic.</text>
          </description>
        </leaf>
        <leaf name="yellow_drop_probability">
          <type name="uint64">
            <range value="0..100"/>
          </type>
          <units name="percent"/>
          <default value="100"/>
          <description>
            <text>Maximum drop probability for yellow-colored packets between min and max thresholds.</text>
          </description>
        </leaf>
        <leaf name="green_drop_probability">
          <type name="uint64">
            <range value="0..100"/>
          </type>
          <units name="percent"/>
          <default value="100"/>
          <description>
            <text>Maximum drop probability for green-colored packets between min and max thresholds.</text>
          </description>
        </leaf>
        <leaf name="red_drop_probability">
          <type name="uint64">
            <range value="0..100"/>
          </type>
          <units name="percent"/>
          <default value="100"/>
          <description>
            <text>Maximum drop probability for red-colored packets between min and max thresholds.</text>
          </description>
        </leaf>
      </list>
    </container>
  </container>
</module>
