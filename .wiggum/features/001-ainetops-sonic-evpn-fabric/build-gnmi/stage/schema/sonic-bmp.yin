<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-bmp"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:bmp="http://github.com/sonic-net/sonic-bmp"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-bmp"/>
  <prefix value="bmp"/>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <organization>
    <text>SONiC</text>
  </organization>
  <contact>
    <text>SONiC</text>
  </contact>
  <description>
    <text>BMP YANG Module for SONiC OS</text>
  </description>
  <revision date="2024-03-20">
    <description>
      <text>First Revision</text>
    </description>
  </revision>
  <container name="sonic-bmp">
    <container name="BMP">
      <description>
        <text>BGP Monitoring Protocol (BMP) table dump configuration.</text>
      </description>
      <container name="table">
        <leaf name="bgp_neighbor_table">
          <type name="stypes:boolean_type"/>
          <default value="true"/>
          <description>
            <text>Enable or disable BMP BGP neighbor table dump.</text>
          </description>
        </leaf>
        <leaf name="bgp_rib_in_table">
          <type name="stypes:boolean_type"/>
          <default value="false"/>
          <description>
            <text>Enable or disable BMP Adj-RIB-In table dump.</text>
          </description>
        </leaf>
        <leaf name="bgp_rib_out_table">
          <type name="stypes:boolean_type"/>
          <default value="false"/>
          <description>
            <text>Enable or disable BMP Adj-RIB-Out table dump.</text>
          </description>
        </leaf>
      </container>
    </container>
  </container>
</module>
