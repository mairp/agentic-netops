<?xml version="1.0" encoding="UTF-8"?>
<module name="sonic-subnet-decap"
        xmlns="urn:ietf:params:xml:ns:yang:yin:1"
        xmlns:subnet-decap="http://github.com/sonic-net/sonic-subnet-decap"
        xmlns:inet="urn:ietf:params:xml:ns:yang:ietf-inet-types"
        xmlns:stypes="http://github.com/sonic-net/sonic-head">
  <yang-version value="1.1"/>
  <namespace uri="http://github.com/sonic-net/sonic-subnet-decap"/>
  <prefix value="subnet-decap"/>
  <import module="ietf-inet-types">
    <prefix value="inet"/>
  </import>
  <import module="sonic-types">
    <prefix value="stypes"/>
  </import>
  <description>
    <text>Subnet-based IPinIP tunnel decapsulation rules for SONiC.</text>
  </description>
  <revision date="2024-12-19">
    <description>
      <text>Initial version</text>
    </description>
  </revision>
  <container name="sonic-subnet-decap">
    <container name="SUBNET_DECAP">
      <description>
        <text>Subnet decapsulation entries defining source IP prefixes for IPinIP decap.</text>
      </description>
      <list name="SUBNET_DECAP_LIST">
        <key value="name"/>
        <leaf name="name">
          <type name="string"/>
          <description>
            <text>Subnet decap rule name.</text>
          </description>
        </leaf>
        <leaf name="status">
          <type name="stypes:mode-status"/>
          <default value="disable"/>
          <description>
            <text>Enable or disable this subnet decap rule.</text>
          </description>
        </leaf>
        <leaf name="src_ip">
          <type name="inet:ipv4-prefix"/>
          <description>
            <text>Outer source IPv4 prefix identifying traffic eligible for decapsulation.</text>
          </description>
          <mandatory value="true"/>
        </leaf>
        <leaf name="src_ip_v6">
          <type name="inet:ipv6-prefix"/>
          <description>
            <text>Outer source IPv6 prefix identifying traffic eligible for decapsulation.</text>
          </description>
          <mandatory value="true"/>
        </leaf>
      </list>
    </container>
  </container>
</module>
