{
  "name": "grafana-flow-panel",
  "version": "1.0.0",
  "description": "AINETOPS physical fabric flow/topology panel (presentation reference per FR-032)",
  "license": "Apache-2.0",
  "main": "dist/module.js",
  "scripts": {
    "build": "esbuild src/module.ts --bundle --format=iife --global-name=grafanaFlowPanelPlugin --outfile=dist/module.js --jsx=automatic --external:react --external:react-dom --log-level=warning",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grafana/data": "11.2.0",
    "@grafana/runtime": "11.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.2",
    "typescript": "5.6.3"
  }
}
